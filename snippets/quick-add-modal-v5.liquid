{%- comment -%}
  Quick Add Modal V5
  Renders the modal overlay, toast notification, and javascript logic for the Quick Add feature.
  
  Usage:
    {% render 'quick-add-modal-v5', section_id: section.id %}
    
  Accepts:
    - section_id: {String} Unique identifier for the section, used to namespace IDs and JS variables.
{%- endcomment -%}

<style>
  .qa-overlay-v5 {
    position: fixed;
    inset: 0;
    background: rgba(18, 11, 7, 0.45);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    z-index: 2147483647;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.25s ease, visibility 0.25s;
    padding: 16px;
    box-sizing: border-box;
  }
  .qa-overlay-v5.is-open {
    opacity: 1;
    visibility: visible;
  }
  .qa-card-v5 {
    background: var(--paper, #fcfbf7);
    border: 1px solid var(--line, #e5dfd3);
    border-radius: 8px;
    width: 100%;
    max-width: 420px;
    box-shadow: 0 20px 50px rgba(35, 20, 12, 0.25);
    padding: 22px 20px 20px 20px;
    position: relative;
    transform: translateY(12px) scale(0.98);
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    box-sizing: border-box;
    color: var(--cocoa, #392319);
    font-family: var(--ui, "Inter", sans-serif);
  }
  .qa-overlay-v5.is-open .qa-card-v5 {
    transform: translateY(0) scale(1);
  }
  .qa-close-btn-v5 {
    position: absolute;
    top: 14px;
    right: 14px;
    background: transparent;
    border: none;
    font-size: 18px;
    line-height: 1;
    color: var(--cocoa, #392319);
    cursor: pointer;
    padding: 6px;
    opacity: 0.7;
    transition: opacity 0.2s;
  }
  .qa-close-btn-v5:hover {
    opacity: 1;
  }
  .qa-product-header-v5 {
    display: flex;
    gap: 14px;
    align-items: center;
    padding-bottom: 16px;
    border-bottom: 1px solid var(--line, #e5dfd3);
    margin-bottom: 16px;
  }
  .qa-product-img-v5 {
    width: 64px;
    height: 85px;
    object-fit: cover;
    border-radius: 4px;
    background: var(--sand, #f4efe6);
    flex-shrink: 0;
  }
  .qa-product-info-v5 {
    flex: 1;
    min-width: 0;
  }
  .qa-product-title-v5 {
    font-family: var(--heading, "Bodoni Moda", serif);
    font-size: 16px;
    font-weight: 500;
    margin: 0 0 4px 0;
    line-height: 1.25;
    color: var(--cocoa, #392319);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .qa-product-price-v5 {
    font-size: 13px;
    font-weight: 400;
    color: var(--clay, #8a5a44);
    margin: 0;
  }
  .qa-label-v5 {
    font-size: 10.5px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--cocoa, #392319);
    margin-bottom: 10px;
    display: block;
  }
  .qa-variants-list-v5 {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 20px;
  }
  .qa-size-pill-v5 {
    background: #ffffff;
    border: 1px solid var(--line, #e5dfd3);
    border-radius: 4px;
    padding: 8px 14px;
    font-size: 11.5px;
    font-weight: 500;
    color: var(--cocoa, #392319);
    cursor: pointer;
    transition: all 0.2s ease;
    min-width: 44px;
    text-align: center;
    font-family: var(--ui, "Inter", sans-serif);
  }
  .qa-size-pill-v5:hover:not(:disabled) {
    border-color: var(--cocoa, #392319);
    background: var(--paper, #fcfbf7);
  }
  .qa-size-pill-v5.is-selected {
    background: var(--cocoa, #392319) !important;
    color: #ffffff !important;
    border-color: var(--cocoa, #392319) !important;
  }
  .qa-size-pill-v5:disabled {
    opacity: 0.35;
    text-decoration: line-through;
    cursor: not-allowed;
  }
  .qa-submit-btn-v5 {
    width: 100%;
    background: var(--cocoa, #392319);
    color: #ffffff;
    border: none;
    border-radius: 4px;
    padding: 13px 16px;
    font-size: 11.5px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    cursor: pointer;
    transition: background 0.2s ease, transform 0.15s ease, opacity 0.2s ease;
    font-family: var(--ui, "Inter", sans-serif);
  }
  .qa-submit-btn-v5:hover:not(:disabled) {
    background: #23140e;
    transform: translateY(-1px);
  }
  .qa-submit-btn-v5:disabled {
    background: #c5beba;
    cursor: not-allowed;
  }
  .qa-view-link-v5 {
    display: block;
    text-align: center;
    margin-top: 12px;
    font-size: 11px;
    color: var(--clay, #8a5a44);
    text-decoration: underline;
    transition: color 0.2s;
  }
  .qa-view-link-v5:hover {
    color: var(--cocoa, #392319);
  }

  /* Toast Notification */
  .qa-toast-v5 {
    position: fixed;
    top: 130px;
    right: 24px;
    background: var(--cocoa, #392319);
    color: #ffffff;
    padding: 12px 18px;
    border-radius: 6px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.25);
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 12px;
    font-weight: 500;
    z-index: 990;
    opacity: 0;
    transform: translateY(-10px);
    transition: opacity 0.25s ease, transform 0.25s ease;
    pointer-events: none;
    font-family: var(--ui, "Inter", sans-serif);
  }
  .qa-toast-v5.is-show {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }
  .qa-toast-link-v5 {
    color: #ffffff;
    text-decoration: underline;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
</style>

<!-- Quick Add Modal Component -->
<div class="qa-overlay-v5" id="qaModalOverlay-{{ section_id }}" onclick="if(event.target === this) closeQuickAddModal('{{ section_id }}');">
  <div class="qa-card-v5" id="qaModalCard-{{ section_id }}">
    <button type="button" class="qa-close-btn-v5" onclick="closeQuickAddModal('{{ section_id }}')" aria-label="Close">✕</button>

    <div class="qa-product-header-v5">
      <img id="qaImg-{{ section_id }}" class="qa-product-img-v5" src="" alt="" />
      <div class="qa-product-info-v5">
        <h4 id="qaTitle-{{ section_id }}" class="qa-product-title-v5"></h4>
        <p id="qaPrice-{{ section_id }}" class="qa-product-price-v5"></p>
      </div>
    </div>

    <span class="qa-label-v5">Select Size / Option</span>
    <div id="qaVariants-{{ section_id }}" class="qa-variants-list-v5"></div>

    <button type="button" id="qaSubmitBtn-{{ section_id }}" class="qa-submit-btn-v5" disabled onclick="submitQuickAddToCart('{{ section_id }}')">
      Select a size
    </button>

    <a id="qaViewLink-{{ section_id }}" href="#" class="qa-view-link-v5">View full product details →</a>
  </div>
</div>

<!-- Floating Toast Notification -->
<div class="qa-toast-v5" id="qaToast-{{ section_id }}">
  <span id="qaToastMsg-{{ section_id }}">✓ Item added to bag</span>
  <a href="/cart" class="qa-toast-link-v5">View Bag</a>
</div>

<script>
  // Dynamic variable name to avoid conflicts if multiple snippets are rendered
  window['currentQaVariantId_{{ section_id | replace: "-", "_" }}'] = null;

  function openQuickAddModal(btn, sectionId) {
    const title = btn.getAttribute('data-title');
    const price = btn.getAttribute('data-price');
    const img = btn.getAttribute('data-img');
    const url = btn.getAttribute('data-url');
    const variantsRaw = btn.getAttribute('data-variants');

    document.getElementById('qaTitle-' + sectionId).textContent = title;
    document.getElementById('qaPrice-' + sectionId).innerHTML = price;
    document.getElementById('qaImg-' + sectionId).src = img;
    document.getElementById('qaViewLink-' + sectionId).href = url;

    const variantsList = document.getElementById('qaVariants-' + sectionId);
    variantsList.innerHTML = '';
    window['currentQaVariantId_' + sectionId.replace(/-/g, '_')] = null;

    const submitBtn = document.getElementById('qaSubmitBtn-' + sectionId);
    submitBtn.disabled = true;
    submitBtn.textContent = 'Select a size';

    try {
      const variants = JSON.parse(variantsRaw);
      if (variants && variants.length > 0) {
        if (variants.length === 1 && (variants[0].title === 'Default Title' || variants.length === 1)) {
          window['currentQaVariantId_' + sectionId.replace(/-/g, '_')] = variants[0].id;
          submitBtn.disabled = !variants[0].available;
          submitBtn.textContent = variants[0].available ? 'ADD TO BAG' : 'SOLD OUT';
          variantsList.style.display = 'none';
        } else {
          variantsList.style.display = 'flex';
          variants.forEach(v => {
            const pill = document.createElement('button');
            pill.type = 'button';
            pill.className = 'qa-size-pill-v5';
            pill.textContent = v.title;
            if (!v.available) {
              pill.disabled = true;
              pill.title = 'Sold Out';
            } else {
              pill.onclick = function() {
                variantsList.querySelectorAll('.qa-size-pill-v5').forEach(p => p.classList.remove('is-selected'));
                pill.classList.add('is-selected');
                window['currentQaVariantId_' + sectionId.replace(/-/g, '_')] = v.id;
                submitBtn.disabled = false;
                submitBtn.textContent = 'ADD TO BAG';
              };
            }
            variantsList.appendChild(pill);
          });
        }
      }
    } catch(e) {
      console.error('Error parsing variants:', e);
    }

    document.getElementById('qaModalOverlay-' + sectionId).classList.add('is-open');
  }

  function closeQuickAddModal(sectionId) {
    document.getElementById('qaModalOverlay-' + sectionId).classList.remove('is-open');
  }

  function submitQuickAddToCart(sectionId) {
    const variantId = window['currentQaVariantId_' + sectionId.replace(/-/g, '_')];
    if (!variantId) return;

    const submitBtn = document.getElementById('qaSubmitBtn-' + sectionId);
    const originalText = submitBtn.textContent;
    submitBtn.disabled = true;
    submitBtn.textContent = 'ADDING...';

    fetch('/cart/add.js', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'Accept': 'application/json'
      },
      body: JSON.stringify({
        items: [{
          id: variantId,
          quantity: 1
        }]
      })
    })
    .then(response => {
      if (!response.ok) throw new Error('Add to cart failed');
      return response.json();
    })
    .then(data => {
      // Klaviyo Add to Cart Tracking
      var _learnq = window._learnq || [];
      if (data && data.items && data.items.length > 0) {
        var item = data.items[0];
        _learnq.push(['track', 'Added to Cart', {
          'ProductName': item.title,
          'ProductID': item.product_id,
          'URL': window.location.origin + item.url,
          'ImageURL': item.image,
          'Price': (item.price / 100).toFixed(2)
        }]);
      } else if (data && data.id) {
        _learnq.push(['track', 'Added to Cart', {
          'ProductName': data.title,
          'ProductID': data.product_id,
          'URL': window.location.origin + data.url,
          'ImageURL': data.image,
          'Price': (data.price / 100).toFixed(2)
        }]);
      }

      closeQuickAddModal(sectionId);
      
      if (typeof openCartDrawerV5 === 'function' && typeof refreshCartDrawerV5 === 'function') {
        refreshCartDrawerV5();
        openCartDrawerV5();
      } else {
        showQuickAddToast(sectionId);
      }

      if (typeof updateHeaderCartCountV5 === 'function') {
        // If Cart Drawer logic is present, trigger it and update badge
        fetch('/cart.js').then(res => res.json()).then(cart => updateHeaderCartCountV5(cart.item_count));
      } else if (typeof updateHeaderCartCount === 'function') {
        // Fallback for header update
        updateHeaderCartCount();
      }
    })
    .catch(err => {
      console.error(err);
      alert('Could not add item to bag. Please try again.');
    })
    .finally(() => {
      submitBtn.disabled = false;
      submitBtn.textContent = originalText;
    });
  }

  function showQuickAddToast(sectionId) {
    const toast = document.getElementById('qaToast-' + sectionId);
    if (!toast) return;
    toast.classList.add('is-show');
    setTimeout(() => {
      toast.classList.remove('is-show');
    }, 4000);
  }

  // Define updateHeaderCartCount as a fallback global if not defined elsewhere
  if (typeof updateHeaderCartCount !== 'function') {
    window.updateHeaderCartCount = function() {
      fetch('/cart.js')
        .then(res => res.json())
        .then(cart => {
          document.querySelectorAll('.cart-count-v5').forEach(el => {
            el.textContent = cart.item_count;
          });
        })
        .catch(e => console.error(e));
    }
  }
</script>
