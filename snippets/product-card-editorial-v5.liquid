{%- comment -%}
  Product Card Editorial V5
  Renders a single editorial lookbook card (4/5 aspect ratio with glassmorphism slide-up info panel).
  Used in Recommendations & Editorial carousels.
{%- endcomment -%}

{%- liquid
  assign card_sid = sid | default: 'editorial'
  assign is_on_sale = false
  if product.compare_at_price > product.price
    assign is_on_sale = true
  endif
-%}

<div class="v5-ymal-card-{{ card_sid }}" onclick="window.location.href='{{ product.url }}'">
  {%- if product.featured_media -%}
    <img
      src="{{ product.featured_media | image_url: width: 700 }}"
      alt="{{ product.featured_media.alt | default: product.title | escape }}"
      width="700"
      height="875"
      loading="lazy" />
  {%- else -%}
    {{ 'product-1' | placeholder_svg_tag }}
  {%- endif -%}

  <div class="v5-ymal-panel-{{ card_sid }}">
    <div class="v5-ymal-row-{{ card_sid }}">
      <h4 class="v5-ymal-title-{{ card_sid }}">{{ product.title }}</h4>
      <span class="v5-ymal-price-{{ card_sid }}">
        {%- if is_on_sale -%}
          <s>{{ product.compare_at_price | money_without_trailing_zeros }}</s>
        {%- endif -%}
        {{ product.price | money_without_trailing_zeros }}
      </span>
    </div>

    {%- capture variants_json -%}
      [
        {%- for variant in product.variants -%}
          {
            "id": {{ variant.id }},
            "title": {{ variant.title | json }},
            "price": {{ variant.price | money_without_trailing_zeros | json }},
            "available": {{ variant.available | json }}
          }{%- unless forloop.last -%},{%- endunless -%}
        {%- endfor -%}
      ]
    {%- endcapture -%}
    <button type="button" class="v5-ymal-quick-add-btn" 
      aria-haspopup="dialog"
      data-title="{{ product.title | escape }}"
      data-url="{{ product.url }}"
      data-img="{{ product.featured_media | img_url: '400x' }}"
      data-price="{{ product.price | money_without_trailing_zeros }}"
      data-variants='{{ variants_json | strip_newlines }}'
      onclick="event.preventDefault(); event.stopPropagation(); openQuickAddModal(this, '{{ card_sid }}');"
    >
      QUICK ADD
    </button>
  </div>
</div>
