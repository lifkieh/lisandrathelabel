{%- comment -%}
  Product Card V5
  Renders a single product card matching the Lisandra V5 design system.
  
  Usage:
    {% render 'product-card-v5', product: product %}
  
  Accepts:
    - product: {Object} Shopify product object (required)
    - show_badge: {Boolean} Whether to show best-seller / sale badge (default: true)
    - show_swatches: {Boolean} Whether to show color swatches (default: true)
    - show_spec: {Boolean} Whether to show spec label like "Hand-knit" (default: true)
    - lazy: {Boolean} Whether to lazy-load images (default: true)
{%- endcomment -%}

{%- liquid
  assign show_badge = show_badge | default: true
  assign show_swatches = show_swatches | default: true
  assign show_spec = show_spec | default: true
  assign lazy = lazy | default: true
  assign loading_attr = 'lazy'
  if lazy == false
    assign loading_attr = 'eager'
  endif
  assign show_quick_add = show_quick_add | default: false
  assign section_id = section_id | default: 'unknown'
-%}

{%- comment -%} Detect Best Seller via collection membership {%- endcomment -%}
{%- liquid
  assign is_best_seller = false
  for col in product.collections
    if col.handle == 'best-sellers'
      assign is_best_seller = true
      break
    endif
  endfor
  if product.tags contains 'Best Seller' or product.tags contains 'best-seller'
    assign is_best_seller = true
  endif
-%}

{%- comment -%} Detect Sale {%- endcomment -%}
{%- liquid
  assign is_on_sale = false
  if product.compare_at_price > product.price
    assign is_on_sale = true
  endif
-%}

{%- comment -%} Detect craft spec from product type or tags {%- endcomment -%}
{%- liquid
  assign spec_label = ''
  if product.tags contains 'Hand-knit' or product.tags contains 'hand-knit'
    assign spec_label = 'Hand-knit'
  elsif product.tags contains 'Crochet' or product.tags contains 'crochet'
    assign spec_label = 'Crochet'
  endif
-%}

<article class="v5-card">
  <a href="{{ product.url }}" class="v5-card__link" aria-label="{{ product.title | escape }}">
    <figure class="v5-card__figure">
      {%- if show_badge -%}
        {%- if is_best_seller -%}
          <span class="v5-card__badge">Best Seller</span>
        {%- elsif is_on_sale -%}
          <span class="v5-card__badge v5-card__badge--sale">Sale</span>
        {%- elsif product.available == false -%}
          <span class="v5-card__badge v5-card__badge--out">Sold Out</span>
        {%- endif -%}
      {%- endif -%}

      {%- if product.featured_media -%}
        <img
          class="v5-card__img v5-card__img--main"
          src="{{ product.featured_media | image_url: width: 700 }}"
          alt="{{ product.featured_media.alt | default: product.title | escape }}"
          width="700"
          height="933"
          loading="{{ loading_attr }}" />
      {%- endif -%}

      {%- if product.media.size > 1 -%}
        <img
          class="v5-card__img v5-card__img--hover"
          src="{{ product.media[1] | image_url: width: 700 }}"
          alt="{{ product.media[1].alt | default: product.title | escape }}"
          width="700"
          height="933"
          loading="lazy" />
      {%- endif -%}

      {%- if show_quick_add -%}
        {%- capture variants_json -%}
          [
            {%- for variant in product.variants -%}
              {
                "id": {{ variant.id }},
                "title": {{ variant.title | json }},
                "price": {{ variant.price | money_without_trailing_zeros | json }},
                "available": {{ variant.available | json }}
              }{%- unless forloop.last -%},{%- endunless -%}
            {%- endfor -%}
          ]
        {%- endcapture -%}
        <div class="v5-card__actions">
          <button 
            class="v5-card__qa-btn" 
            type="button" 
            aria-haspopup="dialog"
            data-title="{{ product.title | escape }}"
            data-url="{{ product.url }}"
            data-img="{{ product.featured_media | img_url: '400x' }}"
            data-price="{{ product.price | money_without_trailing_zeros }}"
            data-variants='{{ variants_json | strip_newlines }}'
            onclick="event.preventDefault(); event.stopPropagation(); openQuickAddModal(this, '{{ section_id }}');"
          >
            Quick Add
          </button>
        </div>
      {%- endif -%}
    </figure>

    {%- if show_spec and spec_label != blank -%}
      <p class="v5-card__spec">{{ spec_label }}</p>
    {%- endif -%}

    <h4 class="v5-card__title">{{ product.title }}</h4>

    <p class="v5-card__price">
      {%- if is_on_sale -%}
        <s>{{ product.compare_at_price | money_without_trailing_zeros }}</s>
      {%- endif -%}
      {{ product.price | money_without_trailing_zeros }}
    </p>
  </a>

  {%- if show_swatches -%}
    {%- for option in product.options_with_values -%}
      {%- assign option_name_lower = option.name | downcase -%}
      {%- if option_name_lower == 'color' or option_name_lower == 'colour' -%}
        <div class="v5-card__swatches" role="group" aria-label="Colour">
          {%- for value in option.values -%}
            {%- assign color_lower = value | downcase -%}
            {%- case color_lower -%}
              {%- when 'cocoa' -%}{%- assign sw_hex = '#392319' -%}
              {%- when 'ivory' -%}{%- assign sw_hex = '#efe9e5' -%}
              {%- when 'sage' -%}{%- assign sw_hex = '#8e9483' -%}
              {%- when 'black' -%}{%- assign sw_hex = '#111' -%}
              {%- when 'sand' -%}{%- assign sw_hex = '#d6ccbd' -%}
              {%- when 'caramel' -%}{%- assign sw_hex = '#8a5a44' -%}
              {%- when 'white' -%}{%- assign sw_hex = '#ffffff' -%}
              {%- when 'cream' -%}{%- assign sw_hex = '#f5f0e8' -%}
              {%- when 'olive' -%}{%- assign sw_hex = '#6b7a4f' -%}
              {%- when 'nude' -%}{%- assign sw_hex = '#d4b9a0' -%}
              {%- when 'brown' -%}{%- assign sw_hex = '#6b3a2a' -%}
              {%- when 'navy' -%}{%- assign sw_hex = '#1b2838' -%}
              {%- when 'rust' -%}{%- assign sw_hex = '#a04520' -%}
              {%- when 'terracotta' -%}{%- assign sw_hex = '#c45d3e' -%}
              {%- when 'blush' -%}{%- assign sw_hex = '#e8c4b8' -%}
              {%- when 'clay' -%}{%- assign sw_hex = '#8a5a44' -%}
              {%- when 'champagne' -%}{%- assign sw_hex = '#f7e7ce' -%}
              {%- when 'natural' -%}{%- assign sw_hex = '#e8ddd0' -%}
              {%- when 'gold' -%}{%- assign sw_hex = '#c5a55a' -%}
              {%- when 'mauve' -%}{%- assign sw_hex = '#b07d9e' -%}
              {%- when 'wine' -%}{%- assign sw_hex = '#722f37' -%}
              {%- when 'burgundy' -%}{%- assign sw_hex = '#5c1a1b' -%}
              {%- when 'dusty rose' -%}{%- assign sw_hex = '#c9a0a0' -%}
              {%- when 'taupe' -%}{%- assign sw_hex = '#a89888' -%}
              {%- when 'charcoal' -%}{%- assign sw_hex = '#36454f' -%}
              {%- when 'pewter' -%}{%- assign sw_hex = '#8e8e8e' -%}
              {%- when 'dove' -%}{%- assign sw_hex = '#b0a899' -%}
              {%- when 'espresso' -%}{%- assign sw_hex = '#3c1414' -%}
              {%- when 'cinnamon' -%}{%- assign sw_hex = '#d2691e' -%}
              {%- when 'honey' -%}{%- assign sw_hex = '#c4962c' -%}
              {%- when 'mocha' -%}{%- assign sw_hex = '#6f4e37' -%}
              {%- when 'oat' -%}{%- assign sw_hex = '#d5c4a1' -%}
              {%- when 'stone' -%}{%- assign sw_hex = '#9e9688' -%}
              {%- when 'linen' -%}{%- assign sw_hex = '#e8dcc8' -%}
              {%- when 'pearl' -%}{%- assign sw_hex = '#f0ead6' -%}
              {%- when 'rose' -%}{%- assign sw_hex = '#c47a7a' -%}
              {%- when 'sky' -%}{%- assign sw_hex = '#87ceeb' -%}
              {%- when 'teal' -%}{%- assign sw_hex = '#008080' -%}
              {%- when 'emerald' -%}{%- assign sw_hex = '#50c878' -%}
              {%- when 'sunset' -%}{%- assign sw_hex = '#d46a3c' -%}
              {%- when 'coral' -%}{%- assign sw_hex = '#ff7f50' -%}
              {%- when 'lilac' -%}{%- assign sw_hex = '#c8a2c8' -%}
              {%- when 'mint' -%}{%- assign sw_hex = '#aaf0d1' -%}
              {%- when 'peach' -%}{%- assign sw_hex = '#ffcba4' -%}
              {%- when 'red' -%}{%- assign sw_hex = '#b52a2a' -%}
              {%- when 'blue' -%}{%- assign sw_hex = '#3a5a8c' -%}
              {%- when 'green' -%}{%- assign sw_hex = '#4a7c59' -%}
              {%- when 'yellow' -%}{%- assign sw_hex = '#e8c83a' -%}
              {%- when 'orange' -%}{%- assign sw_hex = '#cc7722' -%}
              {%- when 'pink' -%}{%- assign sw_hex = '#e8889c' -%}
              {%- when 'grey' or 'gray' -%}{%- assign sw_hex = '#9e9e9e' -%}
              {%- when 'silver' -%}{%- assign sw_hex = '#c0c0c0' -%}
              {%- when 'beige' -%}{%- assign sw_hex = '#d5c4a1' -%}
              {%- when 'tan' -%}{%- assign sw_hex = '#d2b48c' -%}
              {%- when 'khaki' -%}{%- assign sw_hex = '#c3b091' -%}
              {%- when 'mustard' -%}{%- assign sw_hex = '#c4a430' -%}
              {%- when 'plum' -%}{%- assign sw_hex = '#8e4585' -%}
              {%- when 'lavender' -%}{%- assign sw_hex = '#b4a7d6' -%}
              {%- when 'indigo' -%}{%- assign sw_hex = '#4b0082' -%}
              {%- when 'maroon' -%}{%- assign sw_hex = '#800000' -%}
              {%- when 'forest' -%}{%- assign sw_hex = '#228b22' -%}
              {%- when 'aqua' -%}{%- assign sw_hex = '#00ced1' -%}
              {%- when 'denim' -%}{%- assign sw_hex = '#4a6fa5' -%}
              {%- when 'copper' -%}{%- assign sw_hex = '#b87333' -%}
              {%- when 'bronze' -%}{%- assign sw_hex = '#cd7f32' -%}
              {%- when 'midnight' -%}{%- assign sw_hex = '#1a1a2e' -%}
              {%- else -%}{%- assign sw_hex = '#ccc' -%}
            {%- endcase -%}
            <span
              class="v5-card__sw{% if forloop.first %} v5-card__sw--active{% endif %}"
              style="background:{{ sw_hex }}"
              aria-label="{{ value }}"
              title="{{ value }}"></span>
          {%- endfor -%}
        </div>
      {%- endif -%}
    {%- endfor -%}
  {%- endif -%}
</article>
