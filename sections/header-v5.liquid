{%- liquid
  assign transparent = section.settings.transparent_on_home
  if template.name != 'index' and template.suffix != 'collections'
    assign transparent = false
  endif
  assign nav_menu = section.settings.menu | default: linklists['main-menu']
-%}

<style>
  .v5-header-sticky-wrapper {
    position: sticky;
    top: 0;
    z-index: 1000;
    width: 100%;
  }
  .hdr-v5 {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    padding: 12px clamp(14px, 2vw, 26px);
    border-bottom: 1px solid var(--line, #e2e2e2);
    background: var(--paper, #f8f8f0);
    transition: background 0.3s ease, border-color 0.3s ease, color 0.3s ease;
    color: var(--cocoa, #392319);
    font-family: var(--body, sans-serif);
  }

  /* Transparent Header logic */
  .hdr-v5.is-transparent {
    background: transparent;
    border-bottom-color: rgba(255, 255, 255, 0.15);
    color: #fff;
  }
  .hdr-v5.is-transparent:hover,
  .hdr-v5.is-transparent.search-active {
    background: var(--paper, #f8f8f0);
    border-bottom-color: var(--line, #e2e2e2);
    color: var(--cocoa, #392319);
  }

  .wordmark-v5 {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 44px;
    text-decoration: none;
    color: inherit;
  }
  .wordmark-v5 img {
    display: block;
    width: auto;
    height: 130px;
    margin: -43px 0;
    object-fit: contain;
  }
  .wordmark-v5-text {
    font-family: var(--heading, "Bodoni Moda", serif);
    font-weight: 500;
    font-size: 19px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  /* Logo switching */
  .hdr-v5 .logo-light {
    display: none;
  }
  .hdr-v5.is-transparent .logo-dark {
    display: none;
  }
  .hdr-v5.is-transparent .logo-light {
    display: block;
  }
  .hdr-v5.is-transparent:hover .logo-dark,
  .hdr-v5.is-transparent.search-active .logo-dark {
    display: block;
  }
  .hdr-v5.is-transparent:hover .logo-light,
  .hdr-v5.is-transparent.search-active .logo-light {
    display: none;
  }

  .mainnav-v5 {
    display: flex;
    justify-content: flex-start;
    align-items: center;
    gap: clamp(14px, 1.8vw, 26px);
    flex-wrap: nowrap;
  }
  .nav-links-v5 {
    display: flex;
    align-items: center;
    gap: clamp(14px, 1.8vw, 26px);
  }

  /* Hamburger button */
  .nav-toggle-v5 {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 32px;
    height: 32px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 4px;
    z-index: 1002;
  }
  .nav-toggle-v5 span {
    display: block;
    height: 1.5px;
    width: 100%;
    background: var(--cocoa, #392319);
    transition: transform 0.3s ease, opacity 0.3s ease;
  }
  .hdr-v5.is-transparent .nav-toggle-v5 span {
    background: #fff;
  }
  .hdr-v5.is-transparent:hover .nav-toggle-v5 span,
  .hdr-v5.is-transparent.search-active .nav-toggle-v5 span {
    background: var(--cocoa, #392319);
  }
  .nav-toggle-v5.open span:nth-child(1) {
    transform: translateY(6.5px) rotate(45deg);
  }
  .nav-toggle-v5.open span:nth-child(2) {
    opacity: 0;
    transform: scaleX(0);
  }
  .nav-toggle-v5.open span:nth-child(3) {
    transform: translateY(-6.5px) rotate(-45deg);
  }

  .hdr-actions-v5 {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: clamp(10px, 1.5vw, 20px);
  }
  .nav-links-v5 a, .mobile-nav-v5 a {
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 4px 0;
    border-bottom: 1px solid transparent;
    text-decoration: none;
    color: inherit;
    transition: border-bottom-color 0.2s ease, opacity 0.2s ease;
  }
  .nav-links-v5 a:hover, .mobile-nav-v5 a:hover {
    border-bottom-color: currentColor;
  }
  .nav-links-v5 a.sale, .mobile-nav-v5 a.sale {
    color: var(--clay, #8a5a44);
    font-style: italic;
  }

  .hdr-actions-v5 a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: inherit;
    transition: opacity 0.2s;
    padding: 4px;
    text-decoration: none;
  }
  .hdr-actions-v5 a:hover {
    opacity: 0.6;
  }
  .hdr-actions-v5 svg {
    width: 19px;
    height: 19px;
    stroke-width: 1.35;
  }

  /* ===== SEARCH PILL TRIGGER ===== */
  .search-pill-trigger-v5 {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 34px;
    padding: 0 14px 0 12px;
    background: transparent;
    border: 1px solid currentColor;
    border-radius: 999px;
    cursor: pointer;
    color: inherit;
    font-family: var(--font-body--family, 'Inter', sans-serif);
    font-size: 11px;
    font-weight: 400;
    letter-spacing: 0.06em;
    opacity: 0.6;
    white-space: nowrap;
    transition: opacity 0.25s ease, background 0.25s ease, border-color 0.25s ease;
    min-width: 160px;
  }
  .search-pill-trigger-v5:hover {
    opacity: 1;
  }
  .search-pill-trigger-v5 svg {
    width: 14px;
    height: 14px;
    flex-shrink: 0;
    stroke-width: 1.75;
  }
  .hdr-v5.is-transparent .search-pill-trigger-v5 {
    border-color: rgba(255,255,255,0.5);
    color: #fff;
  }
  .hdr-v5.is-transparent:hover .search-pill-trigger-v5,
  .hdr-v5.is-transparent.search-active .search-pill-trigger-v5 {
    border-color: rgba(57,35,25,0.25);
    color: #392319;
  }
  @media (max-width: 900px) {
    .search-pill-trigger-v5 {
      min-width: 110px;
      font-size: 10px;
      padding: 0 10px 0 9px;
    }
  }
  @media (max-width: 600px) {
    .search-pill-trigger-v5 {
      min-width: unset;
      width: 34px;
      padding: 0;
      justify-content: center;
    }
    .search-pill-trigger-v5 .search-pill-label {
      display: none;
    }
  }

  /* ===== ACCOUNT ICON ===== */
  .hdr-account-btn-v5 {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: inherit;
    transition: opacity 0.2s;
    padding: 4px;
    text-decoration: none;
  }
  .hdr-account-btn-v5:hover {
    opacity: 0.6;
  }
  .hdr-account-btn-v5 svg {
    width: 19px;
    height: 19px;
    stroke-width: 1.35;
  }
  /* Account badge — when logged in show initials */
  .hdr-account-initials-v5 {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    border: 1px solid currentColor;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    line-height: 1;
  }

  /* ===== MOBILE DRAWER — ACCOUNT SECTION ===== */
  .drawer-account-v5 {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 14px 0 4px;
    border-top: 1px solid var(--line, #e2e2e2);
    margin-top: 8px;
  }
  .drawer-account-v5 a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-body--family, 'Inter', sans-serif);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--cocoa, #392319);
    text-decoration: none;
    transition: opacity 0.2s;
  }
  .drawer-account-v5 a:hover { opacity: 0.65; }
  .drawer-account-v5 svg {
    width: 16px;
    height: 16px;
    stroke-width: 1.5;
    flex-shrink: 0;
  }

  /* Mobile Drawer */
  .mobile-drawer-v5 {
    position: fixed;
    top: 0;
    left: -100%;
    width: min(340px, 86vw);
    max-width: 380px;
    height: 100vh;
    background: var(--paper, #f8f8f0);
    z-index: 1001;
    display: flex;
    flex-direction: column;
    padding: 24px 28px;
    transition: left 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    color: var(--cocoa, #392319);
    box-shadow: 10px 0 40px rgba(45, 28, 20, 0.18);
  }
  .mobile-drawer-v5.active {
    left: 0;
  }
  .mobile-drawer-overlay {
    position: fixed;
    inset: 0;
    background: rgba(30, 18, 10, 0.45);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    z-index: 1000;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.35s ease, visibility 0.35s ease;
  }
  .mobile-drawer-overlay.active {
    opacity: 1;
    visibility: visible;
  }
  
  .nav-drawer-head-v5 {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 16px;
    border-bottom: 1px solid var(--line, #e2e2e2);
    margin-bottom: 24px;
    height: 48px;
    overflow: hidden;
  }
  .nav-drawer-logo-v5 {
    height: 90px;
    width: auto;
    margin: -25px 0 -25px -6px;
    object-fit: contain;
    mix-blend-mode: multiply;
  }
  .nav-drawer-close-v5 {
    background: none;
    border: none;
    font-size: 20px;
    cursor: pointer;
    color: var(--cocoa, #392319);
    padding: 4px 8px;
    line-height: 1;
  }

  .mobile-nav-v5 {
    display: flex;
    flex-direction: column;
    gap: 16px;
    flex: 1;
    overflow-y: auto;
    padding: 10px 0;
  }
  .mobile-nav-v5 a {
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--cocoa, #392319);
    padding: 6px 0;
    display: block;
    width: 100%;
  }

  .drawer-footer-v5 {
    display: flex;
    flex-direction: column;
    gap: 14px;
    border-top: 1px solid var(--line, #e2e2e2);
    padding-top: 20px;
  }
  .drawer-secondary-v5 {
    display: flex;
    gap: 16px;
  }
  .drawer-secondary-v5 a {
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink60, #777);
    text-decoration: none;
  }
  .drawer-secondary-v5 a:hover {
    color: var(--cocoa, #392319);
  }
  .drawer-social-v5 {
    display: flex;
    gap: 16px;
  }
  .drawer-social-v5 a {
    color: var(--cocoa, #392319);
    display: inline-flex;
  }
  .drawer-social-v5 svg {
    width: 18px;
    height: 18px;
  }

  .util-v5 {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 16px;
    padding: 7px clamp(12px, 2vw, 26px);
    background: var(--cocoa, #392319);
    color: #ffffff;
    font-size: 10.5px;
    font-weight: 400;
    letter-spacing: 0.05em;
    text-align: center;
    font-family: var(--ui, "Inter", sans-serif);
  }

  /* ===== MEGA MENU ===== */
  .nav-item-v5 {
    position: static;
    display: inline-flex;
    align-items: center;
  }
  .nav-item-v5 > a {
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }
  .nav-item-v5 > a .mega-caret {
    display: inline-block;
    width: 8px;
    height: 5px;
    position: relative;
    margin-top: 1px;
    opacity: 0.5;
    transition: opacity 0.2s;
  }
  .nav-item-v5 > a .mega-caret::after {
    content: '';
    display: block;
    width: 6px;
    height: 6px;
    border-right: 1px solid currentColor;
    border-bottom: 1px solid currentColor;
    transform: rotate(45deg);
    position: absolute;
    top: -2px;
    left: 1px;
  }
  .nav-item-v5:hover > a .mega-caret,
  .nav-item-v5.mega-open > a .mega-caret {
    opacity: 1;
    transform: rotate(180deg);
    margin-top: -3px;
  }

  .mega-menu {
    position: fixed;
    top: auto;
    left: 0;
    right: 0;
    background: var(--paper, #f8f8f0);
    border-top: 1px solid rgba(57, 35, 25, 0.1);
    border-bottom: 1px solid rgba(57, 35, 25, 0.1);
    box-shadow: 0 16px 40px rgba(20, 12, 8, 0.1);
    z-index: 999;
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: 0;
    opacity: 0;
    visibility: hidden;
    transform: translateY(-6px);
    transition: opacity 0.25s cubic-bezier(0.16, 1, 0.3, 1),
                visibility 0.25s cubic-bezier(0.16, 1, 0.3, 1),
                transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    pointer-events: none;
  }
  .mega-menu.open {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
    pointer-events: auto;
  }

  /* Left Column: Category Links */
  .mega-links {
    padding: 28px 24px 28px 32px;
    border-right: 1px solid rgba(57, 35, 25, 0.08);
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .mega-links-label {
    font-size: 9px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(57, 35, 25, 0.4);
    margin-bottom: 12px;
    margin-top: 0;
  }
  .mega-links a {
    display: block;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--cocoa, #392319);
    text-decoration: none;
    padding: 6px 0;
    border-bottom: 1px solid transparent;
    transition: border-bottom-color 0.2s ease, padding-left 0.2s ease;
  }
  .mega-links a:hover {
    border-bottom-color: var(--cocoa, #392319);
    padding-left: 4px;
  }
  .mega-links a.mega-sale {
    color: var(--clay, #8a5a44);
    font-style: italic;
  }
  .mega-links-divider {
    height: 1px;
    background: rgba(57, 35, 25, 0.08);
    margin: 8px 0;
  }

  /* Right Side: Editorial Cards */
  .mega-cards {
    padding: 24px 32px 24px 28px;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
    align-items: start;
  }
  .mega-card {
    display: block;
    text-decoration: none;
    color: var(--cocoa, #392319);
    overflow: hidden;
  }
  .mega-card__img {
    aspect-ratio: 3/4;
    overflow: hidden;
    background: #f0ede8;
  }
  .mega-card__img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .mega-card:hover .mega-card__img img {
    transform: scale(1.04);
  }
  .mega-card__label {
    font-size: 9px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    margin-top: 9px;
    display: block;
    transition: opacity 0.2s;
  }
  .mega-card:hover .mega-card__label {
    opacity: 0.65;
  }

  /* Mobile: hide mega cards, show links in drawer instead */
  @media (max-width: 900px) {
    .mega-menu { display: none !important; }
  }

  /* ===== Responsive Rules ===== */
  @media (max-width: 900px) {
    .nav-links-v5 {
      display: none;
    }
    .nav-toggle-v5 {
      display: flex;
    }
    .hdr-v5 {
      padding: 10px clamp(14px, 2vw, 24px);
    }
    .wordmark-v5 {
      height: 38px;
    }
    .wordmark-v5 img {
      height: 110px;
      margin: -36px 0;
    }
    .hdr-actions-v5 {
      gap: 16px;
    }
  }

  @media (max-width: 600px) {
    .hdr-v5 {
      padding: 8px 16px;
    }
    .wordmark-v5 {
      height: 34px;
    }
    .wordmark-v5 img {
      height: 96px;
      margin: -31px 0;
    }
    .hdr-actions-v5 {
      gap: 12px;
    }
    .hdr-actions-v5 svg {
      width: 18px;
      height: 18px;
    }
    .util-v5 {
      font-size: 9.5px;
      padding: 6px 12px;
    }
  }
  /* Search Drawer Styles */
  .hdr-search-trigger-v5 {
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    color: inherit;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  .search-drawer-v5 {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    width: 100%;
    max-height: calc(100vh - 70px);
    overflow-y: auto;
    background: var(--paper, #f8f8f0);
    z-index: 999;
    padding: 28px clamp(14px, 2.5vw, 32px) 36px clamp(14px, 2.5vw, 32px);
    border-bottom: 1px solid var(--line, #e2e2e2);
    box-shadow: 0 16px 40px rgba(20, 12, 8, 0.12);
    transform: translateY(-8px);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1),
                opacity 0.25s cubic-bezier(0.16, 1, 0.3, 1),
                visibility 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .search-drawer-v5.active {
    transform: translateY(0);
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }
  .search-drawer-overlay {
    position: fixed;
    inset: 0;
    top: 0;
    background: rgba(30, 18, 10, 0.45);
    backdrop-filter: blur(3px);
    -webkit-backdrop-filter: blur(3px);
    z-index: 998;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.25s ease, visibility 0.25s ease;
  }
  .search-drawer-overlay.active {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }
  .search-drawer-inner-v5 {
    max-width: 1200px;
    margin: 0 auto;
    width: 100%;
  }
  .search-drawer-form-v5 {
    display: flex;
    align-items: center;
    border-bottom: 1px solid var(--cocoa, #392319);
    padding-bottom: 10px;
    margin-bottom: 24px;
  }
  .search-icon-input {
    width: 22px;
    height: 22px;
    margin-right: 14px;
    color: var(--cocoa, #392319);
    flex-shrink: 0;
  }
  .search-input-v5 {
    flex: 1;
    border: none;
    background: transparent;
    font-size: 18px;
    font-family: var(--heading, "Bodoni Moda", serif);
    color: var(--cocoa, #392319);
    outline: none;
    -webkit-appearance: none;
  }
  .search-input-v5::placeholder {
    color: rgba(57, 35, 25, 0.4);
  }
  .search-input-v5::-webkit-search-cancel-button {
    display: none;
  }
  .search-drawer-close-btn {
    background: none;
    border: none;
    font-size: 22px;
    cursor: pointer;
    color: var(--cocoa, #392319);
    padding: 0 0 0 10px;
    line-height: 1;
  }
  .search-drawer-results-v5, .search-drawer-empty-state-v5 {
    width: 100%;
  }
  .search-recommendation-title-v5 {
    display: block;
    font-size: 10.5px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    margin-bottom: 16px;
    color: var(--cocoa, #392319);
  }
  .search-predictive-grid-v5 {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }
  .search-predictive-item-v5 {
    text-decoration: none;
    color: var(--cocoa, #392319);
    display: block;
  }
  .search-item-img-wrap-v5 {
    position: relative;
    padding-bottom: 133%; /* 3:4 aspect ratio */
    overflow: hidden;
    margin-bottom: 10px;
    background: #eaeaea;
  }
  .search-item-img-wrap-v5 img {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }
  .search-predictive-item-v5:hover img {
    transform: scale(1.04);
  }
  .search-item-info-v5 {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }
  .search-item-title-v5 {
    font-size: 12.5px;
    font-weight: 500;
    letter-spacing: 0.04em;
  }
  .search-item-price-v5 {
    font-size: 12px;
    color: var(--clay, #8a5a44);
  }
  @media (max-width: 768px) {
    .search-predictive-grid-v5 {
      grid-template-columns: repeat(2, 1fr);
      gap: 12px;
    }
    .search-input-v5 {
      font-size: 15px;
    }
    .search-drawer-v5 {
      padding: 16px 14px 24px 14px;
      max-height: calc(100vh - 60px);
    }
    .search-drawer-form-v5 {
      margin-bottom: 18px;
    }
    .search-item-title-v5 {
      font-size: 11.5px;
    }
    .search-item-price-v5 {
      font-size: 11.5px;
    }
  }

  /* Recent Searches Chips & Recently Viewed */
  .search-recent-wrap-v5 {
    margin-bottom: 22px;
    padding-bottom: 18px;
    border-bottom: 1px solid rgba(57, 35, 25, 0.08);
  }
