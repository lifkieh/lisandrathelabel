{%- liquid
  assign transparent = section.settings.transparent_on_home
  if template.name != 'index'
    assign transparent = false
  endif
  assign nav_menu = section.settings.menu | default: linklists['main-menu']
-%}

<style>
  .hdr-v5 {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    padding: 12px clamp(14px, 2vw, 26px);
    border-bottom: 1px solid var(--line, #e2e2e2);
    background: var(--paper, #f8f8f0);
    position: sticky;
    top: 0;
    z-index: 1000;
    transition: background 0.3s ease, border-color 0.3s ease, color 0.3s ease;
    color: var(--cocoa, #392319);
    font-family: var(--body, sans-serif);
  }

  /* Transparent Header logic */
  .hdr-v5.is-transparent {
    background: transparent;
    border-bottom-color: rgba(255, 255, 255, 0.15);
    color: #fff;
  }
  .hdr-v5.is-transparent:hover {
    background: var(--paper, #f8f8f0);
    border-bottom-color: var(--line, #e2e2e2);
    color: var(--cocoa, #392319);
  }

  .wordmark-v5 {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 44px;
    text-decoration: none;
    color: inherit;
  }
  .wordmark-v5 img {
    display: block;
    width: auto;
    height: 130px;
    margin: -43px 0;
    object-fit: contain;
  }
  .wordmark-v5-text {
    font-family: var(--heading, "Bodoni Moda", serif);
    font-weight: 500;
    font-size: 19px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  /* Logo switching */
  .hdr-v5 .logo-light {
    display: none;
  }
  .hdr-v5.is-transparent .logo-dark {
    display: none;
  }
  .hdr-v5.is-transparent .logo-light {
    display: block;
  }
  .hdr-v5.is-transparent:hover .logo-dark {
    display: block;
  }
  .hdr-v5.is-transparent:hover .logo-light {
    display: none;
  }

  .mainnav-v5 {
    display: flex;
    justify-content: flex-start;
    align-items: center;
    gap: clamp(14px, 1.8vw, 26px);
    flex-wrap: nowrap;
  }
  .nav-links-v5 {
    display: flex;
    align-items: center;
    gap: clamp(14px, 1.8vw, 26px);
  }

  /* Hamburger button */
  .nav-toggle-v5 {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 32px;
    height: 32px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 4px;
    z-index: 1002;
  }
  .nav-toggle-v5 span {
    display: block;
    height: 1.5px;
    width: 100%;
    background: var(--cocoa, #392319);
    transition: transform 0.3s ease, opacity 0.3s ease;
  }
  .hdr-v5.is-transparent .nav-toggle-v5 span {
    background: #fff;
  }
  .hdr-v5.is-transparent:hover .nav-toggle-v5 span {
    background: var(--cocoa, #392319);
  }
  .nav-toggle-v5.open span:nth-child(1) {
    transform: translateY(6.5px) rotate(45deg);
  }
  .nav-toggle-v5.open span:nth-child(2) {
    opacity: 0;
    transform: scaleX(0);
  }
  .nav-toggle-v5.open span:nth-child(3) {
    transform: translateY(-6.5px) rotate(-45deg);
  }

  .hdr-actions-v5 {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: clamp(16px, 2vw, 28px);
  }
  .nav-links-v5 a, .mobile-nav-v5 a {
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 4px 0;
    border-bottom: 1px solid transparent;
    text-decoration: none;
    color: inherit;
    transition: border-bottom-color 0.2s ease, opacity 0.2s ease;
  }
  .nav-links-v5 a:hover, .mobile-nav-v5 a:hover {
    border-bottom-color: currentColor;
  }
  .nav-links-v5 a.sale, .mobile-nav-v5 a.sale {
    color: var(--clay, #8a5a44);
    font-style: italic;
  }

  .hdr-actions-v5 a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: inherit;
    transition: opacity 0.2s;
    padding: 4px;
    text-decoration: none;
  }
  .hdr-actions-v5 a:hover {
    opacity: 0.6;
  }
  .hdr-actions-v5 svg {
    width: 19px;
    height: 19px;
    stroke-width: 1.35;
  }

  /* Mobile Drawer */
  .mobile-drawer-v5 {
    position: fixed;
    top: 0;
    left: -100%;
    width: min(340px, 86vw);
    max-width: 380px;
    height: 100vh;
    background: var(--paper, #f8f8f0);
    z-index: 1001;
    display: flex;
    flex-direction: column;
    padding: 24px 28px;
    transition: left 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    color: var(--cocoa, #392319);
    box-shadow: 10px 0 40px rgba(45, 28, 20, 0.18);
  }
  .mobile-drawer-v5.active {
    left: 0;
  }
  .mobile-drawer-overlay {
    position: fixed;
    inset: 0;
    background: rgba(30, 18, 10, 0.45);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    z-index: 1000;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.35s ease, visibility 0.35s ease;
  }
  .mobile-drawer-overlay.active {
    opacity: 1;
    visibility: visible;
  }
  
  .nav-drawer-head-v5 {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 16px;
    border-bottom: 1px solid var(--line, #e2e2e2);
    margin-bottom: 24px;
    height: 48px;
    overflow: hidden;
  }
  .nav-drawer-logo-v5 {
    height: 90px;
    width: auto;
    margin: -25px 0 -25px -6px;
    object-fit: contain;
    mix-blend-mode: multiply;
  }
  .nav-drawer-close-v5 {
    background: none;
    border: none;
    font-size: 20px;
    cursor: pointer;
    color: var(--cocoa, #392319);
    padding: 4px 8px;
    line-height: 1;
  }

  .mobile-nav-v5 {
    display: flex;
    flex-direction: column;
    gap: 16px;
    flex: 1;
    overflow-y: auto;
    padding: 10px 0;
  }
  .mobile-nav-v5 a {
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--cocoa, #392319);
    padding: 6px 0;
    display: block;
    width: 100%;
  }

  .drawer-footer-v5 {
    display: flex;
    flex-direction: column;
    gap: 14px;
    border-top: 1px solid var(--line, #e2e2e2);
    padding-top: 20px;
  }
  .drawer-secondary-v5 {
    display: flex;
    gap: 16px;
  }
  .drawer-secondary-v5 a {
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink60, #777);
    text-decoration: none;
  }
  .drawer-secondary-v5 a:hover {
    color: var(--cocoa, #392319);
  }
  .drawer-social-v5 {
    display: flex;
    gap: 16px;
  }
  .drawer-social-v5 a {
    color: var(--cocoa, #392319);
    display: inline-flex;
  }
  .drawer-social-v5 svg {
    width: 18px;
    height: 18px;
  }

  .util-v5 {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 16px;
    padding: 7px clamp(12px, 2vw, 26px);
    background: var(--cocoa, #392319);
    color: #ffffff;
    font-size: 10.5px;
    font-weight: 400;
    letter-spacing: 0.05em;
    text-align: center;
    font-family: var(--ui, "Inter", sans-serif);
  }

  /* Responsive Rules */
  @media (max-width: 900px) {
    .nav-links-v5 {
      display: none;
    }
    .nav-toggle-v5 {
      display: flex;
    }
    .hdr-v5 {
      padding: 10px clamp(14px, 2vw, 24px);
    }
    .wordmark-v5 {
      height: 38px;
    }
    .wordmark-v5 img {
      height: 110px;
      margin: -36px 0;
    }
    .hdr-actions-v5 {
      gap: 16px;
    }
  }

  @media (max-width: 600px) {
    .hdr-v5 {
      padding: 8px 16px;
    }
    .wordmark-v5 {
      height: 34px;
    }
    .wordmark-v5 img {
      height: 96px;
      margin: -31px 0;
    }
    .hdr-actions-v5 {
      gap: 12px;
    }
    .hdr-actions-v5 svg {
      width: 18px;
      height: 18px;
    }
    .util-v5 {
      font-size: 9.5px;
      padding: 6px 12px;
    }
  }
</style>

{%- if section.settings.show_announcement and section.settings.announcement_text != blank -%}
  <div class="util-v5">
    <span>{{ section.settings.announcement_text }}</span>
  </div>
{%- endif -%}

<header class="hdr-v5 {% if transparent %}is-transparent{% endif %}" id="siteHeader">
  <nav class="mainnav-v5" aria-label="Main">
    <button class="nav-toggle-v5" id="navToggle" aria-label="Toggle Menu" onclick="toggleHeaderDrawer()">
      <span></span><span></span><span></span>
    </button>
    <div class="nav-links-v5">
      {%- if nav_menu != blank and nav_menu.links.size > 0 -%}
        {%- for link in nav_menu.links -%}
          <a href="{{ link.url }}" class="{% if link.title == 'Sale' or link.title == 'SALE' %}sale{% endif %}">{{ link.title }}</a>
        {%- endfor -%}
      {%- else -%}
        <a href="{{ routes.all_products_collection_url }}">New Arrivals</a>
        <a href="{{ routes.all_products_collection_url }}">Shop</a>
        <a href="{{ routes.all_products_collection_url }}" class="sale">Sale</a>
        <a href="{{ routes.collections_url }}">Collections</a>
        <a href="/pages/our-story">Our Story</a>
      {%- endif -%}
    </div>
  </nav>

  <a href="{{ routes.root_url }}" class="wordmark-v5" aria-label="Lisandra Home">
    {%- if section.settings.logo_dark != blank -%}
      <img src="{{ section.settings.logo_dark | img_url: '400x' }}" class="logo-dark" alt="Lisandra The Label" />
    {%- elsif section.settings.logo_light == blank -%}
      <span class="wordmark-v5-text">Lisandra</span>
    {%- endif -%}
    
    {%- if section.settings.logo_light != blank -%}
      <img src="{{ section.settings.logo_light | img_url: '400x' }}" class="logo-light" alt="Lisandra The Label" />
    {%- endif -%}
  </a>

  <div class="hdr-actions-v5">
    <a href="{{ routes.search_url }}" aria-label="Search">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
        <circle cx="11" cy="11" r="7"></circle>
        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
      </svg>
    </a>
    <a href="#" aria-label="Currency">
      <span style="font-size: 11px; font-weight: 500; letter-spacing: 0.1em;">IDR</span>
    </a>
    <a href="{{ routes.cart_url }}" aria-label="Cart">
      <span style="display: flex; align-items: center; gap: 4px;">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
          <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <path d="M16 10a4 4 0 0 1-8 0"></path>
        </svg>
        <span style="font-size: 10px;">{{ cart.item_count }}</span>
      </span>
    </a>
  </div>
</header>

<!-- Mobile Navigation Drawer -->
<div class="mobile-drawer-overlay" id="drawerOverlay" onclick="toggleHeaderDrawer()"></div>
<div class="mobile-drawer-v5" id="mobileDrawer">
  <div class="nav-drawer-head-v5">
    {%- if section.settings.logo_dark != blank -%}
      <img src="{{ section.settings.logo_dark | img_url: '200x' }}" class="nav-drawer-logo-v5" alt="Lisandra The Label" />
    {%- else -%}
      <span class="wordmark-v5-text" style="font-size: 16px;">Lisandra</span>
    {%- endif -%}
    <button type="button" class="nav-drawer-close-v5" onclick="toggleHeaderDrawer()" aria-label="Close menu">✕</button>
  </div>

  <nav class="mobile-nav-v5">
    {%- if nav_menu != blank and nav_menu.links.size > 0 -%}
      {%- for link in nav_menu.links -%}
        <a href="{{ link.url }}" class="{% if link.title == 'Sale' or link.title == 'SALE' %}sale{% endif %}">{{ link.title }}</a>
      {%- endfor -%}
    {%- else -%}
      <a href="{{ routes.all_products_collection_url }}">New Arrivals</a>
      <a href="{{ routes.all_products_collection_url }}">Shop</a>
      <a href="{{ routes.all_products_collection_url }}" class="sale">Sale</a>
      <a href="{{ routes.collections_url }}">Collections</a>
      <a href="/pages/our-story">Our Story</a>
    {%- endif -%}
  </nav>

  <div class="drawer-footer-v5">
    <div class="drawer-secondary-v5">
      <a href="{{ routes.search_url }}">Search</a>
      <a href="{{ routes.account_url }}">Account</a>
      <a href="#wishlist">Wishlist</a>
    </div>
    <div class="drawer-social-v5">
      <a href="https://instagram.com/lisandra.thelabel" target="_blank" rel="noopener" aria-label="Instagram">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
          <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
          <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
        </svg>
      </a>
      <a href="https://tiktok.com/@lisandra.thelabel" target="_blank" rel="noopener" aria-label="TikTok">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M9 12a4 4 0 1 0 4 4V4a5 5 0 0 0 5 5"></path>
        </svg>
      </a>
    </div>
  </div>
</div>

<script>
  function toggleHeaderDrawer() {
    const mobileDrawer = document.getElementById('mobileDrawer');
    const drawerOverlay = document.getElementById('drawerOverlay');
    const navToggle = document.getElementById('navToggle');
    if (!mobileDrawer || !drawerOverlay) return;

    const isOpen = mobileDrawer.classList.contains('active');
    if (isOpen) {
      mobileDrawer.classList.remove('active');
      drawerOverlay.classList.remove('active');
      if (navToggle) navToggle.classList.remove('open');
      document.body.style.overflow = '';
    } else {
      mobileDrawer.classList.add('active');
      drawerOverlay.classList.add('active');
      if (navToggle) navToggle.classList.add('open');
      document.body.style.overflow = 'hidden';
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
    const header = document.getElementById('siteHeader');
    const isTransparentConfig = {{ transparent | json }};
    
    // Scroll logic for transparent header
    if (isTransparentConfig && header) {
      window.addEventListener('scroll', () => {
        if (window.scrollY > 50) {
          header.classList.remove('is-transparent');
        } else {
          header.classList.add('is-transparent');
        }
      });
    }
  });
</script>

{% schema %}
{
  "name": "Header v5",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo_dark",
      "label": "Logo (Dark text)"
    },
    {
      "type": "image_picker",
      "id": "logo_light",
      "label": "Logo (Light text)"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Main Menu"
    },
    {
      "type": "checkbox",
      "id": "transparent_on_home",
      "label": "Enable Transparent Header on Homepage",
      "default": true
    },
    {
      "type": "header",
      "content": "Announcement Bar"
    },
    {
      "type": "checkbox",
      "id": "show_announcement",
      "label": "Show Announcement Bar",
      "default": true
    },
    {
      "type": "text",
      "id": "announcement_text",
      "label": "Announcement Text",
      "default": "Free shipping across Indonesia · Worldwide free over USD 200"
    }
  ]
}
{% endschema %}
