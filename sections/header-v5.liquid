<script>
  /* ===== Mega Menu: Hover Intent ===== */
  (function() {
    var navItem = document.getElementById('megaNavItem');
    var menu = document.getElementById('megaMenu');
    if (!navItem || !menu) return;

    var openTimer, closeTimer;
    var DELAY = 120;

    function openMenu() {
      clearTimeout(closeTimer);
      openTimer = setTimeout(function() {
        menu.classList.add('open');
        navItem.classList.add('mega-open');
        positionMenu();
      }, DELAY);
    }

    function closeMenu() {
      clearTimeout(openTimer);
      closeTimer = setTimeout(function() {
        menu.classList.remove('open');
        navItem.classList.remove('mega-open');
      }, 180);
    }

    function positionMenu() {
      var header = document.getElementById('siteHeader');
      if (header) {
        var rect = header.getBoundingClientRect();
        menu.style.top = rect.bottom + 'px';
      }
    }

    navItem.addEventListener('mouseenter', openMenu);
    navItem.addEventListener('mouseleave', closeMenu);
    menu.addEventListener('mouseenter', function() { clearTimeout(closeTimer); });
    menu.addEventListener('mouseleave', closeMenu);

    /* Close on Escape */
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape') {
        menu.classList.remove('open');
        navItem.classList.remove('mega-open');
      }
    });

    /* Reposition on scroll / resize */
    window.addEventListener('resize', function() {
      if (menu.classList.contains('open')) positionMenu();
    });
  })();

  function toggleHeaderDrawer() {
    const mobileDrawer = document.getElementById('mobileDrawer');
    const drawerOverlay = document.getElementById('drawerOverlay');
    const navToggle = document.getElementById('navToggle');
    if (!mobileDrawer || !drawerOverlay) return;

    const isOpen = mobileDrawer.classList.contains('active');
    if (isOpen) {
      mobileDrawer.classList.remove('active');
      drawerOverlay.classList.remove('active');
      if (navToggle) navToggle.classList.remove('open');
      document.body.style.overflow = '';
    } else {
      mobileDrawer.classList.add('active');
      drawerOverlay.classList.add('active');
      if (navToggle) navToggle.classList.add('open');
      document.body.style.overflow = 'hidden';
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
    const header = document.getElementById('siteHeader');
    const isTransparentConfig = {{ transparent | json }};
    
    // Scroll logic for transparent header
    if (isTransparentConfig && header) {
      window.addEventListener('scroll', () => {
        if (window.scrollY > 50) {
          header.classList.remove('is-transparent');
        } else {
          header.classList.add('is-transparent');
        }
      });
    }
  });
  /* ===== Search Drawer & Predictive Search ===== */
  function positionSearchDrawer() {
    const header = document.getElementById('siteHeader');
    const searchDrawer = document.getElementById('searchDrawer');
    const searchOverlay = document.getElementById('searchOverlay');
    if (header && searchDrawer) {
      const rect = header.getBoundingClientRect();
      const headerBottom = Math.max(0, rect.bottom);
      searchDrawer.style.top = headerBottom + 'px';
      if (searchOverlay) {
        searchOverlay.style.top = headerBottom + 'px';
      }
    }
  }

  function toggleSearchDrawer() {
    const searchDrawer = document.getElementById('searchDrawer');
    const searchOverlay = document.getElementById('searchOverlay');
    const header = document.getElementById('siteHeader');
    if (!searchDrawer || !searchOverlay) return;

    const isOpen = searchDrawer.classList.contains('active');
    if (isOpen) {
      searchDrawer.classList.remove('active');
      searchOverlay.classList.remove('active');
      if (header) header.classList.remove('search-active');
      document.body.style.overflow = '';
    } else {
      positionSearchDrawer();
      if (window.refreshSearchHistory) window.refreshSearchHistory();
      searchDrawer.classList.add('active');
      searchOverlay.classList.add('active');
      if (header) header.classList.add('search-active');
      document.body.style.overflow = 'hidden';
      setTimeout(() => {
        const input = document.getElementById('searchDrawerInput');
        if (input) input.focus();
      }, 100);
    }
  }

  // Close search on Escape
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') {
      const searchDrawer = document.getElementById('searchDrawer');
      if (searchDrawer && searchDrawer.classList.contains('active')) {
        toggleSearchDrawer();
      }
    }
  });

  // Reposition on resize and scroll
  window.addEventListener('resize', function() {
    const searchDrawer = document.getElementById('searchDrawer');
    if (searchDrawer && searchDrawer.classList.contains('active')) {
      positionSearchDrawer();
    }
  });
  window.addEventListener('scroll', function() {
    const searchDrawer = document.getElementById('searchDrawer');
    if (searchDrawer && searchDrawer.classList.contains('active')) {
      positionSearchDrawer();
    }
  });

  document.addEventListener('DOMContentLoaded', () => {
    const searchInput = document.getElementById('searchDrawerInput');
    const searchForm = document.querySelector('.search-drawer-form-v5');
    const resultsContainer = document.getElementById('searchResultsContainer');
    const predictiveGrid = document.getElementById('predictiveResultsGrid');
    const emptyState = document.getElementById('searchEmptyState');
    const emptyStateMessage = document.getElementById('emptyStateMessage');
    const emptyStateGrid = document.getElementById('emptyStateGrid');
    const viewAllBtn = document.getElementById('viewAllResultsBtn');
    const recentSearchesWrap = document.getElementById('recentSearchesWrap');
    const recentSearchesChips = document.getElementById('recentSearchesChips');
    const clearRecentSearchesBtn = document.getElementById('clearRecentSearchesBtn');
    const clearRecentlyViewedBtn = document.getElementById('clearRecentlyViewedBtn');

    if (!searchInput) return;

    // Cache initial default HTML for Top Suggestions
    const defaultSuggestionsHTML = emptyStateGrid ? emptyStateGrid.innerHTML : '';

    // Storage Helpers
    function getRecentSearches() {
      try {
        return JSON.parse(localStorage.getItem('lisandra_recent_searches') || '[]');
      } catch(e) { return []; }
    }

    function saveRecentSearch(query) {
      const q = query.trim();
      if (!q) return;
      try {
        let list = getRecentSearches();
        list = list.filter(item => item.toLowerCase() !== q.toLowerCase());
        list.unshift(q);
        if (list.length > 6) list = list.slice(0, 6);
        localStorage.setItem('lisandra_recent_searches', JSON.stringify(list));
        renderRecentSearches();
      } catch(e) {}
    }

    function deleteRecentSearch(query) {
      try {
        let list = getRecentSearches();
        list = list.filter(item => item.toLowerCase() !== query.toLowerCase());
        localStorage.setItem('lisandra_recent_searches', JSON.stringify(list));
        renderRecentSearches();
      } catch(e) {}
    }

    function clearAllRecentSearches() {
      try {
        localStorage.removeItem('lisandra_recent_searches');
        renderRecentSearches();
      } catch(e) {}
    }

    function getRecentlyViewed() {
      try {
        return JSON.parse(localStorage.getItem('lisandra_recently_viewed') || '[]');
      } catch(e) { return []; }
    }

    function clearAllRecentlyViewed() {
      try {
        localStorage.removeItem('lisandra_recently_viewed');
        renderRecentlyViewed();
      } catch(e) {}
    }

    // Render Recent Search Chips
    function renderRecentSearches() {
      if (!recentSearchesWrap || !recentSearchesChips) return;
      const list = getRecentSearches();
      if (!list || list.length === 0) {
        recentSearchesWrap.style.display = 'none';
        recentSearchesChips.innerHTML = '';
        return;
      }
      recentSearchesWrap.style.display = 'block';
      let html = '';
      list.forEach(query => {
        const safeQuery = query.replace(/"/g, '&quot;');
        html += `
          <button type="button" class="search-chip-v5" data-query="${safeQuery}">
            <span class="chip-text">${query}</span>
            <span class="chip-remove" data-remove="${safeQuery}" aria-label="Remove search">✕</span>
          </button>
        `;
      });
      recentSearchesChips.innerHTML = html;

      // Add listeners
      recentSearchesChips.querySelectorAll('.search-chip-v5').forEach(chip => {
        chip.addEventListener('click', function(e) {
          if (e.target.classList.contains('chip-remove')) {
            e.stopPropagation();
            deleteRecentSearch(e.target.dataset.remove);
            return;
          }
          const q = this.dataset.query;
          searchInput.value = q;
          searchInput.dispatchEvent(new Event('input', { bubbles: true }));
          saveRecentSearch(q);
        });
      });
    }

    // Render Recently Viewed Products or Top Suggestions fallback
    function renderRecentlyViewed() {
      if (!emptyStateGrid || !emptyStateMessage) return;
      const list = getRecentlyViewed();
      if (list && list.length > 0) {
        emptyStateMessage.innerText = 'Recently Viewed';
        if (clearRecentlyViewedBtn) clearRecentlyViewedBtn.style.display = 'inline-block';

        let html = '';
        list.slice(0, 4).forEach(prod => {
          html += `
            <a href="${prod.url}" class="search-predictive-item-v5">
              <div class="search-item-img-wrap-v5">
                <img src="${prod.image}" alt="${prod.title}" loading="lazy">
              </div>
              <div class="search-item-info-v5">
                <span class="search-item-title-v5">${prod.title}</span>
                <span class="search-item-price-v5">${prod.price}</span>
              </div>
            </a>
          `;
        });
        emptyStateGrid.innerHTML = html;
      } else {
        emptyStateMessage.innerText = 'Top Suggestions';
        if (clearRecentlyViewedBtn) clearRecentlyViewedBtn.style.display = 'none';
        emptyStateGrid.innerHTML = defaultSuggestionsHTML;
      }
    }

    // Button event listeners
    if (clearRecentSearchesBtn) {
      clearRecentSearchesBtn.addEventListener('click', clearAllRecentSearches);
    }
    if (clearRecentlyViewedBtn) {
      clearRecentlyViewedBtn.addEventListener('click', clearAllRecentlyViewed);
    }

    // Save search query on form submission
    if (searchForm) {
      searchForm.addEventListener('submit', function() {
        const query = searchInput.value.trim();
        if (query) saveRecentSearch(query);
      });
    }

    // Initial render
    renderRecentSearches();
    renderRecentlyViewed();

    // Hook into search drawer opening
    window.refreshSearchHistory = function() {
      renderRecentSearches();
      renderRecentlyViewed();
    };

    let debounceTimer;

    searchInput.addEventListener('input', function() {
      clearTimeout(debounceTimer);
      const query = this.value.trim();

      if (query.length === 0) {
        resultsContainer.style.display = 'none';
        emptyState.style.display = 'block';
        renderRecentSearches();
        renderRecentlyViewed();
        return;
      }

      debounceTimer = setTimeout(() => {
        fetch(`/search/suggest.json?q=${encodeURIComponent(query)}&resources[type]=product&resources[limit]=4`)
          .then(response => response.json())
          .then(data => {
            const products = data.resources.results.products;
            if (products && products.length > 0) {
              emptyState.style.display = 'none';
              resultsContainer.style.display = 'block';
              
              let html = '';
              products.forEach(product => {
                const imageUrl = product.featured_image ? product.featured_image.url : (product.image || '');
                let formattedPrice = '';
                if (product.price) {
                  const rawNum = parseFloat(product.price);
                  if (!isNaN(rawNum)) {
                    formattedPrice = 'Rp ' + Math.round(rawNum).toString().replace(/(\d)(?=(\d\d\d)+(?!\d))/g, '$1.');
                  } else {
                    formattedPrice = product.price;
                  }
                }
                html += `
                  <a href="${product.url}" class="search-predictive-item-v5">
                    <div class="search-item-img-wrap-v5">
                      <img src="${imageUrl}" alt="${product.title}" loading="lazy">
                    </div>
                    <div class="search-item-info-v5">
                      <span class="search-item-title-v5">${product.title}</span>
                      <span class="search-item-price-v5">${formattedPrice}</span>
                    </div>
                  </a>
                `;
              });
              predictiveGrid.innerHTML = html;
              viewAllBtn.href = `/search?q=${encodeURIComponent(query)}&type=product&options[prefix]=last`;

              // Save query when user clicks a search result
              predictiveGrid.querySelectorAll('.search-predictive-item-v5').forEach(item => {
                item.addEventListener('click', function() {
                  saveRecentSearch(query);
                });
              });
            } else {
              resultsContainer.style.display = 'none';
              emptyState.style.display = 'block';
              if (recentSearchesWrap) recentSearchesWrap.style.display = 'none';
              emptyStateMessage.innerText = `We couldn't find anything for "${query}". Check out our suggestions below:`;
            }
          })
          .catch(error => {
            console.error('Error fetching search results:', error);
          });
      }, 300);
    });
  });
</script>

