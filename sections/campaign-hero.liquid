<style>
  /* ---------- collection / campaign page (ref: Faithfull "Costa Brava") ---------- */
  .campaign-hero-{{ section.id }} {
    {% if section.settings.height == 'full' %}
      height: calc(100vh - 31px);
      min-height: 600px;
    {% else %}
      aspect-ratio: 16/9;
    {% endif %}
    position: relative;
    width: 100%;
    margin-top: -69px; /* Presisi sama dengan tinggi navbar untuk transparent hero */
    overflow: hidden;
  }
  .campaign-hero-{{ section.id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    animation: kenBurnsHero 25s ease-out forwards;
  }
  @keyframes kenBurnsHero {
    from { transform: scale(1); }
    to { transform: scale(1.15); }
  }
  .campaign-hero-{{ section.id }}::after {
    content: "";
    position: absolute;
    inset: 0;
    /* Radial + linear gradient overlay to guarantee text readability & seamless top header transition */
    background: linear-gradient(
      to bottom,
      rgba(20, 12, 8, 0.3) 0%,
      transparent 25%,
      transparent 60%,
      rgba(20, 12, 8, 0.5) 100%
    );
  }
  .campaign-hero-{{ section.id }} .cap {
    position: absolute;
    left: clamp(16px, 4vw, 48px);
    bottom: clamp(20px, 4vw, 48px);
    color: #fff;
    max-width: 44ch;
    z-index: 2;
  }
  .campaign-hero-{{ section.id }} .cap .lbl {
    font-family: var(--ui, "Inter", sans-serif);
    font-size: 10px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.9);
    display: block;
    margin-bottom: 8px;
  }
  .campaign-hero-{{ section.id }} .cap h2 {
    font-family: var(--heading, "Bodoni Moda", serif);
    font-style: italic;
    font-weight: 400;
    font-size: clamp(30px, 4.5vw, 52px);
    margin: 0;
    line-height: 1.08;
    color: #fff;
  }
  
  @media (max-width: 768px) {
    .campaign-hero-{{ section.id }} {
      {% if section.settings.height == 'full' %}
        height: 85vh;
        min-height: 520px;
      {% else %}
        aspect-ratio: 3/4;
      {% endif %}
      margin-top: -69px;
    }
  }
</style>

<div class="campaign-hero-{{ section.id }}">
  {%- if section.settings.image != blank -%}
    <img 
      src="{{ section.settings.image | img_url: '2000x' }}" 
      alt="{{ section.settings.image.alt | escape | default: section.settings.heading }}"
      loading="eager"
      width="{{ section.settings.image.width }}"
      height="{{ section.settings.image.height }}"
    />
  {%- else -%}
    <img 
      src="https://lisandrathelabel.com/cdn/shop/files/NEW_COLLECTION-3_9934ceb5-60f5-4a8d-b332-e375f525e03c.jpg?width=1800" 
      alt="Placeholder Campaign Hero" 
      loading="eager"
    />
  {%- endif -%}
  <div class="cap">
    {%- if section.settings.kicker != blank -%}
      <span class="lbl">{{ section.settings.kicker }}</span>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h2>{{ section.settings.heading }}</h2>
    {%- endif -%}
  </div>
</div>

<script>
  // Script untuk mengatur header v5 menjadi transparan saat berada di posisi paling atas hero full-bleed
  document.addEventListener("DOMContentLoaded", () => {
    const siteHeader = document.getElementById('siteHeader') || document.querySelector('.hdr-v5');
    if (siteHeader) {
      function checkHeaderTransparency() {
        if (window.scrollY < 50) {
          siteHeader.classList.add('is-transparent');
        } else {
          siteHeader.classList.remove('is-transparent');
        }
      }
      checkHeaderTransparency();
      window.addEventListener('scroll', checkHeaderTransparency);
    }
  });
</script>

{% schema %}
{
  "name": "Campaign Hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Desktop Image"
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker (Eyebrow)",
      "default": "New Collection"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "New Collection / Resort '26"
    },
    {
      "type": "select",
      "id": "height",
      "label": "Banner Height",
      "options": [
        {
          "value": "full",
          "label": "Full Screen (100vh)"
        },
        {
          "value": "ratio",
          "label": "Widescreen (16:9)"
        }
      ],
      "default": "full"
    }
  ],
  "presets": [
    {
      "name": "Campaign Hero",
      "settings": {
        "height": "full"
      }
    }
  ]
}
{% endschema %}
