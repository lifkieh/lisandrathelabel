<style>
  /* ---------- collection / campaign page (ref: Faithfull "Costa Brava") ---------- */
  .campaign-hero-{{ section.id }} {
    {% if section.settings.height == 'full' %}
      height: 100vh;
      min-height: 600px;
    {% else %}
      aspect-ratio: 16/9;
    {% endif %}
    position: relative;
    width: 100%;
    margin-top: -69px; /* Presisi sama dengan tinggi navbar untuk transparent hero */
    overflow: hidden;
  }
  .campaign-hero-{{ section.id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .campaign-hero-{{ section.id }}::after {
    content: "";
    position: absolute;
    inset: 0;
    /* Soft gradient overlay to make text readable */
    background: linear-gradient(
      to top,
      rgba(20, 12, 8, 0.4) 0%,
      rgba(20, 12, 8, 0.1) 30%,
      transparent 100%
    );
  }
  .campaign-hero-{{ section.id }} .cap {
    position: absolute;
    left: clamp(14px, 3vw, 40px);
    bottom: clamp(14px, 3vw, 40px);
    color: #fff;
    max-width: 40ch;
    z-index: 2;
  }
  .campaign-hero-{{ section.id }} .cap .lbl {
    font-size: 10px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    opacity: 0.85;
    display: block;
    margin-bottom: 8px;
  }
  .campaign-hero-{{ section.id }} .cap h2 {
    font-family: var(--display2, serif);
    font-style: italic;
    font-weight: 400;
    font-size: clamp(28px, 4vw, 44px);
    margin: 0;
    line-height: 1.1;
    color: #fff;
  }
  
  @media (max-width: 768px) {
    .campaign-hero-{{ section.id }} {
      {% if section.settings.height == 'full' %}
        height: 100vh;
      {% else %}
        aspect-ratio: 3/4;
      {% endif %}
    }
  }
</style>

<div class="campaign-hero-{{ section.id }}">
  {%- if section.settings.image != blank -%}
    <img 
      src="{{ section.settings.image | img_url: '2000x' }}" 
      alt="{{ section.settings.image.alt | escape | default: section.settings.heading }}"
      loading="eager"
      width="{{ section.settings.image.width }}"
      height="{{ section.settings.image.height }}"
    />
  {%- else -%}
    <img 
      src="https://lisandrathelabel.com/cdn/shop/files/NEW_COLLECTION-3_9934ceb5-60f5-4a8d-b332-e375f525e03c.jpg?width=1800" 
      alt="Placeholder Campaign Hero" 
      loading="eager"
    />
  {%- endif -%}
  <div class="cap">
    {%- if section.settings.kicker != blank -%}
      <span class="lbl" style="color: #fff">{{ section.settings.kicker }}</span>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h2>{{ section.settings.heading }}</h2>
    {%- endif -%}
  </div>
</div>

<script>
  // Script untuk mengatur header menjadi transparan saat menggunakan hero image full-bleed
  document.addEventListener("DOMContentLoaded", () => {
    const header = document.querySelector('header');
    const hdrIn = document.querySelector('.hdr-in');
    if (header && hdrIn) {
      // Force transparent header styles on load
      header.classList.add('transparent-on-top');
      hdrIn.style.background = 'transparent';
      hdrIn.style.borderBottomColor = 'transparent';
      
      const elements = hdrIn.querySelectorAll('.mainnav a, .hdr-actions svg, .hdr-actions a, .logo-text');
      elements.forEach(el => {
        el.style.color = '#fff';
        if(el.tagName === 'svg') el.style.stroke = '#fff';
      });

      // Handle logo swap if SVG/image logo is used
      const logoImg = hdrIn.querySelector('.logo-img');
      if (logoImg) {
        logoImg.style.filter = 'invert(1) brightness(2)';
      }
      
      window.addEventListener('scroll', () => {
        if (window.scrollY > 50) {
          header.classList.remove('transparent-on-top');
          hdrIn.style.background = 'rgba(248, 248, 240, 0.9)';
          hdrIn.style.borderBottomColor = 'rgba(57, 35, 25, 0.08)';
          
          elements.forEach(el => {
            el.style.color = '';
            if(el.tagName === 'svg') el.style.stroke = '';
          });
          if (logoImg) {
            logoImg.style.filter = '';
          }
        } else {
          header.classList.add('transparent-on-top');
          hdrIn.style.background = 'transparent';
          hdrIn.style.borderBottomColor = 'transparent';
          
          elements.forEach(el => {
            el.style.color = '#fff';
            if(el.tagName === 'svg') el.style.stroke = '#fff';
          });
          if (logoImg) {
            logoImg.style.filter = 'invert(1) brightness(2)';
          }
        }
      });
    }
  });
</script>

{% schema %}
{
  "name": "Campaign Hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Desktop Image"
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker (Eyebrow)",
      "default": "New Collection"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "New Collection / Resort '26"
    },
    {
      "type": "select",
      "id": "height",
      "label": "Banner Height",
      "options": [
        {
          "value": "full",
          "label": "Full Screen (100vh)"
        },
        {
          "value": "ratio",
          "label": "Widescreen (16:9)"
        }
      ],
      "default": "ratio"
    }
  ],
  "presets": [
    {
      "name": "Campaign Hero"
    }
  ]
}
{% endschema %}
