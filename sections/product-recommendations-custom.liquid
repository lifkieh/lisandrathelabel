<style>
  /* === You May Also Like (YMAL) === */
  .ymal-section {
    padding: clamp(38px, 5.5vw, 68px) 0;
    background: var(--paper, #f8f8f0);
    border-top: 1px solid var(--line, #e2e2e2);
  }
  .section-editorial-head {
    text-align: center;
    margin-bottom: 24px;
    padding: 0 16px;
  }
  .section-editorial-head .editorial-kicker {
    font-size: 10.5px;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--cocoa, #392319);
    display: block;
    margin-bottom: 8px;
  }
  .section-editorial-head h3 {
    font-family: var(--display, serif);
    font-size: 32px;
    font-weight: 400;
    font-style: italic;
    color: var(--cocoa, #392319);
    margin: 0;
  }
  .grid-slider-wrap {
    position: relative;
    max-width: 1440px;
    margin: 0 auto;
  }
  .ymal-grid {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    gap: 2px;
    padding: 0 clamp(14px, 2vw, 26px);
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
  .ymal-grid::-webkit-scrollbar {
    display: none;
  }
  .ymal-card {
    flex: 0 0 75vw;
    scroll-snap-align: center;
    position: relative;
    overflow: hidden;
    background: var(--sand, #e0d9b5);
    aspect-ratio: 4/5;
    cursor: pointer;
    transition: opacity 0.25s ease, transform 0.25s ease;
  }
  .ymal-card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.65s cubic-bezier(0.25, 1, 0.5, 1), filter 0.5s ease;
  }
  .ymal-info-panel {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    background: rgba(248, 248, 240, 0.96);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    padding: 14px 16px 16px;
    transform: translateY(100%);
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    display: flex;
    flex-direction: column;
    gap: 8px;
    box-shadow: 0 -4px 16px rgba(0, 0, 0, 0.05);
  }
  .ymal-info-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
  }
  .ymal-info-name {
    font-family: var(--body, sans-serif);
    font-size: 11.5px;
    font-weight: 500;
    letter-spacing: 0.04em;
    color: var(--cocoa, #392319);
  }
  .ymal-info-price {
    font-family: var(--body, sans-serif);
    font-size: 11px;
    color: #7a6258;
    letter-spacing: 0.02em;
  }
  .ymal-sizes {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
  }
  .ymal-size-btn {
    font-family: var(--body, sans-serif);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    border: 1px solid var(--line, #e2e2e2);
    padding: 4px 9px;
    background: transparent;
    color: var(--cocoa, #392319);
    cursor: pointer;
    transition: all 0.2s ease;
  }
  .ymal-size-btn:hover {
    background: var(--cocoa, #392319);
    color: #f8f8f0;
    border-color: var(--cocoa, #392319);
  }

  .grid-nav-btn {
    display: none;
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: var(--paper, #f8f8f0);
    border: none;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    font-size: 18px;
    cursor: pointer;
    z-index: 10;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.1);
    color: var(--cocoa, #392319);
    transition: transform 0.25s ease, background 0.25s ease;
  }
  .grid-nav-btn:hover {
    transform: translateY(-50%) scale(1.05);
    background: #fff;
  }
  .grid-nav-btn svg { width: 20px; height: 20px; stroke-width: 1.5; }
  .grid-nav-btn.prev { left: 26px; }
  .grid-nav-btn.next { right: 26px; }

  @media (min-width: 900px) {
    .grid-nav-btn { display: flex; }
    .ymal-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      overflow-x: visible;
      padding: 0;
    }
    .ymal-card {
      flex: none;
      width: auto;
      scroll-snap-align: none;
    }
    .ymal-card:hover img {
      transform: scale(1.04);
      filter: brightness(0.92);
    }
    .ymal-card:hover .ymal-info-panel {
      transform: translateY(0);
    }
  }
</style>

<section class="ymal-section" id="ymalSection-{{ section.id }}">
  <div class="section-editorial-head">
    <span class="editorial-kicker">{{ section.settings.kicker }}</span>
    <h3>{{ section.settings.title }}</h3>
  </div>
  
  <div class="grid-slider-wrap">
    <button class="grid-nav-btn prev" onclick="slideYmal(-1)" aria-label="Previous recommendations">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="15 18 9 12 15 6"></polyline>
      </svg>
    </button>
    
    <div class="ymal-grid" id="ymalGrid-{{ section.id }}">
      {%- assign products = section.settings.product_list -%}
      {%- if products == blank -%}
        <!-- Placeholder content if no products selected -->
        {%- for i in (1..4) -%}
        <div class="ymal-card">
          <img src="https://cdn.shopify.com/s/images/themes/product-{{ forloop.index }}.png" alt="Placeholder Product" loading="lazy" />
          <div class="ymal-info-panel">
            <div class="ymal-info-row">
              <span class="ymal-info-name">Example Product</span>
              <span class="ymal-info-price">Rp 1.000.000</span>
            </div>
            <div class="ymal-sizes">
              <button class="ymal-size-btn">XS</button>
              <button class="ymal-size-btn">S</button>
              <button class="ymal-size-btn">M</button>
            </div>
          </div>
        </div>
        {%- endfor -%}
      {%- else -%}
        {%- for product in products -%}
          <div class="ymal-card" onclick="window.location.href='{{ product.url }}'">
            <img src="{{ product.featured_image | img_url: '700x' }}" alt="{{ product.title | escape }}" loading="lazy" />
            <div class="ymal-info-panel">
              <div class="ymal-info-row">
                <span class="ymal-info-name">{{ product.title }}</span>
                <span class="ymal-info-price">{{ product.price | money }}</span>
              </div>
              <div class="ymal-sizes">
                {%- for option in product.options_with_values -%}
                  {%- if option.name == 'Size' or option.name == 'Ukuran' -%}
                    {%- for value in option.values -%}
                      <button class="ymal-size-btn" onclick="event.stopPropagation(); window.location.href='{{ product.url }}?variant={{ product.variants[forloop.index0].id }}'">{{ value }}</button>
                    {%- endfor -%}
                  {%- endif -%}
                {%- endfor -%}
              </div>
            </div>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>
    
    <button class="grid-nav-btn next" onclick="slideYmal(1)" aria-label="Next recommendations">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="9 18 15 12 9 6"></polyline>
      </svg>
    </button>
  </div>
</section>

<script>
  // Gather YMAL Data for sliding logic
  const ymalProducts = [
    {%- if products != blank -%}
      {%- for product in products -%}
        {
          src: {{ product.featured_image | img_url: '700x' | json }},
          name: {{ product.title | json }},
          price: {{ product.price | money | json }},
          url: {{ product.url | json }},
          sizesHTML: `
            {%- for option in product.options_with_values -%}
              {%- if option.name == 'Size' or option.name == 'Ukuran' -%}
                {%- for value in option.values -%}
                  <button class="ymal-size-btn" onclick="event.stopPropagation(); window.location.href='{{ product.url }}?variant={{ product.variants[forloop.index0].id }}'">{{ value }}</button>
                {%- endfor -%}
              {%- endif -%}
            {%- endfor -%}
          `
        }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    {%- else -%}
      // placeholder fallback
      {%- for i in (1..4) -%}
        {
          src: "https://cdn.shopify.com/s/images/themes/product-{{ forloop.index }}.png",
          name: "Example Product",
          price: "Rp 1.000.000",
          url: "#",
          sizesHTML: `<button class="ymal-size-btn">XS</button><button class="ymal-size-btn">S</button><button class="ymal-size-btn">M</button>`
        }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    {%- endif -%}
  ];

  let ymalOffset = 0;
  function slideYmal(direction) {
    if (window.innerWidth < 900) {
      const grid = document.getElementById("ymalGrid-{{ section.id }}");
      if (!grid) return;
      const cardWidth = grid.querySelector(".ymal-card")?.offsetWidth || 0;
      const gap = 2;
      grid.scrollBy({
        left: direction * (cardWidth + gap),
        behavior: "smooth",
      });
      return;
    }

    // Desktop rotation through curated products
    if(ymalProducts.length === 0) return;
    ymalOffset = (ymalOffset + direction + ymalProducts.length) % ymalProducts.length;
    
    const cards = document.querySelectorAll("#ymalGrid-{{ section.id }} .ymal-card");
    cards.forEach((card, index) => {
      const img = card.querySelector("img");
      const name = card.querySelector(".ymal-info-name");
      const price = card.querySelector(".ymal-info-price");
      const sizesContainer = card.querySelector(".ymal-sizes");
      if (!img) return;

      card.style.opacity = "0.3";
      card.style.transform = direction > 0 ? "translateX(-8px)" : "translateX(8px)";

      setTimeout(() => {
        const nextIdx = (ymalOffset + index) % ymalProducts.length;
        const p = ymalProducts[nextIdx];
        
        img.src = p.src;
        if (name) name.innerText = p.name;
        if (price) price.innerText = p.price;
        if (sizesContainer) sizesContainer.innerHTML = p.sizesHTML;
        card.setAttribute("onclick", `window.location.href='${p.url}'`);
        
        img.onload = () => {
          card.style.opacity = "1";
          card.style.transform = "translateX(0)";
        };
      }, 140);
    });
  }
</script>

{% schema %}
{
  "name": "You May Also Like",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Curated Recommendations"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "You May Also Like"
    },
    {
      "type": "product_list",
      "id": "product_list",
      "label": "Select Products to Display",
      "limit": 12
    }
  ],
  "presets": [
    {
      "name": "You May Also Like"
    }
  ]
}
{% endschema %}
