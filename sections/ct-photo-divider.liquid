<style>
  .ct-photo-divider-{{ section.id }} {
    width: 100%;
    position: relative;
    overflow: hidden;
    background: var(--paper, #f8f8f0);
    padding-top: {{ section.settings.padding_top | default: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 0 }}px;
  }

  {% if section.settings.layout_style == 'centered' %}
    /* ---------- Editorial Centered Frame (Ideal for Portrait / Full-Body) ---------- */
    .ct-photo-divider-{{ section.id }} .divider-container {
      max-width: 100%;
      margin: 0 auto;
      padding: clamp(28px, 4vw, 56px) 20px;
      display: flex;
      justify-content: center;
      align-items: center;
      background: transparent;
    }

    .ct-photo-divider-{{ section.id }} .img-wrap {
      position: relative;
      width: 100%;
      max-width: {{ section.settings.frame_max_width | default: 480 }}px;
      margin: 0 auto;
      overflow: hidden;
      background: var(--sand, #e0d9b5);
      {% if section.settings.aspect_ratio == 'natural' %}
        aspect-ratio: auto;
      {% else %}
        aspect-ratio: {{ section.settings.aspect_ratio | default: '2/3' }};
        max-height: clamp(480px, 70vh, 740px);
      {% endif %}
      box-shadow: 0 12px 36px rgba(0, 0, 0, 0.04);
    }
  {% else %}
    /* ---------- Full Width / Edge-to-Edge Banner ---------- */
    .ct-photo-divider-{{ section.id }} .divider-container {
      width: 100%;
      position: relative;
      overflow: hidden;
      background: var(--sand, #e0d9b5);
      {% unless section.settings.full_width %}
        max-width: 1320px;
        margin: 0 auto;
        padding: 0 20px;
      {% endunless %}
    }

    .ct-photo-divider-{{ section.id }} .img-wrap {
      position: relative;
      width: 100%;
      overflow: hidden;
      background: var(--sand, #e0d9b5);
      {% if section.settings.aspect_ratio == 'natural' %}
        aspect-ratio: auto;
      {% else %}
        aspect-ratio: {{ section.settings.aspect_ratio | default: '16/9' }};
        max-height: clamp(340px, 45vw, 650px);
      {% endif %}
    }
  {% endif %}

  .ct-photo-divider-{{ section.id }} img {
    {% if section.settings.aspect_ratio == 'natural' and section.settings.layout_style != 'centered' %}
      position: relative;
      width: 100%;
      height: auto;
    {% else %}
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: {{ section.settings.image_fit | default: 'cover' }};
      object-position: {{ section.settings.focal_point | default: 'center center' }};
    {% endif %}
    display: block;
    transition: transform 1.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .ct-photo-divider-{{ section.id }}:hover img {
    transform: scale(1.02);
  }

  .ct-photo-divider-{{ section.id }} .mobile-img {
    display: none;
  }

  @media (max-width: 768px) {
    {% if section.settings.layout_style == 'centered' %}
      .ct-photo-divider-{{ section.id }} .divider-container {
        padding: 20px 16px;
      }

      .ct-photo-divider-{{ section.id }} .img-wrap {
        max-width: 100%;
        {% if section.settings.mobile_aspect_ratio == 'natural' %}
          aspect-ratio: auto;
          max-height: none;
        {% elsif section.settings.mobile_aspect_ratio != 'auto' and section.settings.mobile_aspect_ratio != blank %}
          aspect-ratio: {{ section.settings.mobile_aspect_ratio }};
          max-height: 80vh;
        {% else %}
          aspect-ratio: {{ section.settings.aspect_ratio | default: '2/3' }};
          max-height: 80vh;
        {% endif %}
      }
    {% else %}
      .ct-photo-divider-{{ section.id }} .divider-container {
        {% unless section.settings.full_width %}
          padding: 0 16px;
        {% endunless %}
      }

      .ct-photo-divider-{{ section.id }} .img-wrap {
        {% if section.settings.mobile_aspect_ratio == 'natural' %}
          aspect-ratio: auto;
          max-height: none;
        {% elsif section.settings.mobile_aspect_ratio != 'auto' and section.settings.mobile_aspect_ratio != blank %}
          aspect-ratio: {{ section.settings.mobile_aspect_ratio }};
          max-height: 550px;
        {% else %}
          aspect-ratio: {{ section.settings.aspect_ratio | default: '16/9' }};
          max-height: 550px;
        {% endif %}
      }
    {% endif %}

    {% if section.settings.mobile_image != blank %}
      .ct-photo-divider-{{ section.id }} .desktop-img {
        display: none;
      }
      .ct-photo-divider-{{ section.id }} .mobile-img {
        display: block;
        object-position: {{ section.settings.mobile_focal_point | default: 'center center' }};
      }
    {% endif %}
  }
</style>

<div class="ct-photo-divider-{{ section.id }}">
  <div class="divider-container">
    <div class="img-wrap reveal">
      {%- assign current_image = section.settings.image | default: section.settings.image_1 -%}
      {%- if current_image != blank -%}
        <img 
          src="{{ current_image | img_url: '1800x' }}" 
          srcset="{{ current_image | img_url: '750x' }} 750w, {{ current_image | img_url: '1200x' }} 1200w, {{ current_image | img_url: '1800x' }} 1800w, {{ current_image | img_url: '2400x' }} 2400w"
          sizes="100vw"
          width="{{ current_image.width }}" 
          height="{{ current_image.height }}" 
          alt="{{ current_image.alt | default: 'Editorial Photo Divider' | escape }}" 
          loading="lazy" 
          class="desktop-img"
        />
        {%- if section.settings.mobile_image != blank -%}
          <img 
            src="{{ section.settings.mobile_image | img_url: '900x' }}" 
            srcset="{{ section.settings.mobile_image | img_url: '480x' }} 480w, {{ section.settings.mobile_image | img_url: '750x' }} 750w, {{ section.settings.mobile_image | img_url: '900x' }} 900w"
            sizes="100vw"
            width="{{ section.settings.mobile_image.width }}" 
            height="{{ section.settings.mobile_image.height }}" 
            alt="{{ section.settings.mobile_image.alt | default: 'Editorial Photo Divider Mobile' | escape }}" 
            loading="lazy" 
            class="mobile-img"
          />
        {%- endif -%}
      {%- else -%}
        <div style="aspect-ratio: 16/9; display: flex; align-items: center; justify-content: center; background: #e0d9b5; width: 100%;">
          {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "CT Photo Divider",
  "settings": [
    {
      "type": "header",
      "content": "Image & Layout Style"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Photo Image (Desktop)"
    },
    {
      "type": "select",
      "id": "layout_style",
      "label": "Layout Style",
      "options": [
        {
          "value": "full",
          "label": "Full Width (Edge-to-Edge)"
        },
        {
          "value": "centered",
          "label": "Editorial Centered (Portrait)"
        }
      ],
      "default": "full",
      "info": "Gunakan 'Editorial Centered' jika foto vertikal agar tidak terpotong."
    },
    {
      "type": "select",
      "id": "image_fit",
      "label": "Image Fit Mode",
      "options": [
        {
          "value": "cover",
          "label": "Cover (Fill Frame)"
        },
        {
          "value": "contain",
          "label": "Contain (Fit Without Crop)"
        }
      ],
      "default": "cover"
    },
    {
      "type": "select",
      "id": "aspect_ratio",
      "label": "Desktop Aspect Ratio",
      "options": [
        { "value": "2/3", "label": "Portrait Full Body (2:3)" },
        { "value": "3/4", "label": "Portrait (3:4)" },
        { "value": "4/5", "label": "Portrait Compact (4:5)" },
        { "value": "1/1", "label": "Square (1:1)" },
        { "value": "16/9", "label": "Landscape (16:9)" },
        { "value": "21/9", "label": "Cinematic (21:9)" },
        { "value": "2/1", "label": "Panoramic (2:1)" },
        { "value": "3/2", "label": "Editorial Landscape (3:2)" },
        { "value": "natural", "label": "Natural (Original Ratio)" }
      ],
      "default": "16/9"
    },
    {
      "type": "range",
      "id": "frame_max_width",
      "label": "Max Width Frame (Centered)",
      "min": 320,
      "max": 800,
      "step": 20,
      "unit": "px",
      "default": 480,
      "info": "Khusus untuk layout Editorial Centered."
    },
    {
      "type": "select",
      "id": "focal_point",
      "label": "Desktop Focal Point",
      "options": [
        { "value": "center top", "label": "Top (Fokus Atas/Kepala)" },
        { "value": "center center", "label": "Center" },
        { "value": "center bottom", "label": "Bottom" },
        { "value": "left center", "label": "Left" },
        { "value": "right center", "label": "Right" }
      ],
      "default": "center center"
    },
    {
      "type": "header",
      "content": "Mobile Settings"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile Image (Optional)"
    },
    {
      "type": "select",
      "id": "mobile_focal_point",
      "label": "Mobile Focal Point",
      "options": [
        { "value": "center top", "label": "Top (Fokus Atas/Kepala)" },
        { "value": "center center", "label": "Center" },
        { "value": "center bottom", "label": "Bottom" }
      ],
      "default": "center center"
    },
    {
      "type": "select",
      "id": "mobile_aspect_ratio",
      "label": "Mobile Aspect Ratio",
      "options": [
        { "value": "auto", "label": "Auto (Ikuti Desktop)" },
        { "value": "2/3", "label": "Portrait Full Body (2:3)" },
        { "value": "3/4", "label": "Portrait (3:4)" },
        { "value": "4/5", "label": "Portrait Compact (4:5)" },
        { "value": "1/1", "label": "Square (1:1)" },
        { "value": "16/9", "label": "Landscape (16:9)" },
        { "value": "natural", "label": "Natural (Original Ratio)" }
      ],
      "default": "auto"
    },
    {
      "type": "header",
      "content": "Spacing & Container"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Full Bleed (Edge-to-Edge)",
      "default": true
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top Spacing",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom Spacing",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "CT Photo Divider"
    }
  ]
}
{% endschema %}
