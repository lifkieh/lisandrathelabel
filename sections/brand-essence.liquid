<style>
  .essence-{{ section.id }} {
    background: var(--sand, #e0d9b5);
    padding: clamp(40px, 6vw, 72px) clamp(14px, 2vw, 26px);
    text-align: center;
  }
  .essence-{{ section.id }} .lbl {
    color: var(--clay, #8a5a44);
    display: block;
    margin-bottom: 14px;
    font-size: 10.5px;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-family: var(--ui, "Inter", sans-serif);
  }
  .essence-{{ section.id }} q {
    display: block;
    font-family: var(--display2, "Bodoni Moda", serif);
    font-style: italic;
    font-weight: 400;
    font-size: clamp(18px, 2.2vw, 25px);
    line-height: 1.3;
    max-width: 26ch;
    margin: 0 auto 16px;
    quotes: none;
    color: var(--cocoa, #392319);
  }
  .essence-{{ section.id }} p {
    max-width: 52ch;
    margin: 0 auto 20px;
    color: #4a382e;
    font-size: 14px;
    font-family: var(--ui, "Inter", sans-serif);
    line-height: 1.6;
  }
  .essence-{{ section.id }} .btn {
    display: inline-block;
    padding: 10px 22px;
    border: 1px solid var(--cocoa, #392319);
    font-size: 10.5px;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    background: var(--cocoa, #392319);
    color: #fff;
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    font-family: var(--ui, "Inter", sans-serif);
  }
  .essence-{{ section.id }} .btn:hover {
    background: transparent;
    color: var(--cocoa, #392319);
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(20, 12, 8, 0.12);
  }

  @media (max-width: 600px) {
    .essence-{{ section.id }} q {
      font-size: 17px;
    }
  }
</style>

<section class="essence-{{ section.id }}">
  {%- if section.settings.kicker != blank -%}
    <span class="lbl">{{ section.settings.kicker }}</span>
  {%- endif -%}

  {%- if section.settings.quote != blank -%}
    <q>{{ section.settings.quote | newline_to_br }}</q>
  {%- endif -%}

  {%- if section.settings.text != blank -%}
    <p>{{ section.settings.text }}</p>
  {%- endif -%}

  {%- if section.settings.btn_label != blank -%}
    <a href="{{ section.settings.btn_link | default: '#' }}" class="btn">{{ section.settings.btn_label }}</a>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Brand Essence",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker (Eyebrow)",
      "default": "Made to be lived in"
    },
    {
      "type": "textarea",
      "id": "quote",
      "label": "Philosophy Quote",
      "default": "Every piece starts as raw yarn on the island of Bali, shaped by hand, sun, and sea into something that feels like home."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Description Text",
      "default": "We believe in true artisanship. No shortcuts. Just timeless resortwear crafted slowly by communities we support."
    },
    {
      "type": "text",
      "id": "btn_label",
      "label": "Button Label",
      "default": "Discover Our Process"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Brand Essence"
    }
  ]
}
{% endschema %}
