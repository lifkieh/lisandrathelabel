<style>
  /* Social Grid (Faithfull the Brand editorial style) */
  .social-section-{{ section.id }} {
    border-top: 1px solid var(--line, #e2e2e2);
    background: var(--paper, #f8f8f0);
  }
  .social-header-{{ section.id }} {
    display: flex;
    justify-content: flex-end;
    gap: 24px;
    align-items: center;
    padding: 14px clamp(14px, 2vw, 26px);
    font-family: var(--body, sans-serif);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .social-title-{{ section.id }} {
    color: var(--cocoa, #392319);
  }
  .social-link-{{ section.id }} {
    color: var(--ink60, #666);
    border-bottom: 1px solid transparent;
    text-decoration: none;
    transition: color 0.2s, border-color 0.2s;
  }
  .social-link-{{ section.id }}:hover {
    color: var(--cocoa, #392319);
    border-bottom-color: var(--cocoa, #392319);
  }
  .social-grid-{{ section.id }} {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0;
    border-top: 1px solid var(--line, #e2e2e2);
  }
  .social-grid-{{ section.id }} a {
    position: relative;
    display: block;
    aspect-ratio: 1/1;
    overflow: hidden;
    background: var(--sand, #e0d9b5);
  }
  .social-grid-{{ section.id }} a + a {
    border-left: 1px solid var(--line, #e2e2e2);
  }
  .social-grid-{{ section.id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .social-overlay-{{ section.id }} {
    position: absolute;
    inset: 0;
    background: rgba(45, 28, 20, 0.45);
    backdrop-filter: blur(1.5px);
    -webkit-backdrop-filter: blur(1.5px);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 8px;
    color: #fff;
    opacity: 0;
    transition: opacity 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    z-index: 2;
  }
  .social-icon-{{ section.id }} {
    width: 22px;
    height: 22px;
    transform: translateY(6px);
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .social-caption-{{ section.id }} {
    font-family: var(--body, sans-serif);
    font-size: 9.5px;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.95);
    transform: translateY(6px);
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1) 0.04s;
  }
  .social-grid-{{ section.id }} a:hover img {
    transform: scale(1.05);
  }
  .social-grid-{{ section.id }} a:hover .social-overlay-{{ section.id }} {
    opacity: 1;
  }
  .social-grid-{{ section.id }} a:hover .social-icon-{{ section.id }},
  .social-grid-{{ section.id }} a:hover .social-caption-{{ section.id }} {
    transform: translateY(0);
  }

  /* Mobile Layout */
  @media (max-width: 768px) {
    .social-header-{{ section.id }} {
      justify-content: center;
      gap: 16px;
    }
    .social-grid-{{ section.id }} {
      grid-template-columns: repeat(2, 1fr);
    }
    .social-grid-{{ section.id }} a + a {
      border-left: none;
    }
    .social-grid-{{ section.id }} a:nth-child(2n) {
      border-left: 1px solid var(--line, #e2e2e2);
    }
    .social-grid-{{ section.id }} a:nth-child(n + 3) {
      border-top: 1px solid var(--line, #e2e2e2);
    }
  }
</style>

<section class="social-section-{{ section.id }}">
  <div class="social-header-{{ section.id }}">
    {%- if section.settings.title != blank -%}
      <span class="social-title-{{ section.id }}">{{ section.settings.title }}</span>
    {%- endif -%}
    
    {%- if section.settings.handle != blank and section.settings.url != blank -%}
      <a class="social-link-{{ section.id }}" href="{{ section.settings.url }}" target="_blank" rel="noopener">
        {{ section.settings.handle }}
      </a>
    {%- endif -%}
  </div>

  <div class="social-grid-{{ section.id }}">
    {%- for block in section.blocks -%}
      <a href="{{ block.settings.url | default: section.settings.url }}" target="_blank" rel="noopener" aria-label="View Instagram Post" {{ block.shopify_attributes }}>
        {%- if block.settings.image != blank -%}
          <img src="{{ block.settings.image | img_url: '600x' }}" alt="Instagram Post {{ forloop.index }}" loading="lazy" />
        {%- else -%}
          <img src="https://cdn.shopify.com/s/images/themes/product-{{ forloop.index | modulo: 6 | plus: 1 }}.png" alt="Instagram Placeholder" loading="lazy" />
        {%- endif -%}
        
        <div class="social-overlay-{{ section.id }}">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="social-icon-{{ section.id }}">
            <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
            <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
            <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
          </svg>
          <span class="social-caption-{{ section.id }}">View Post</span>
        </div>
      </a>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Social Feed",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Call to action text",
      "default": "Join the Circle"
    },
    {
      "type": "text",
      "id": "handle",
      "label": "Instagram Handle",
      "default": "@lisandramuse"
    },
    {
      "type": "url",
      "id": "url",
      "label": "Instagram Profile URL"
    }
  ],
  "blocks": [
    {
      "type": "post",
      "name": "Social Post",
      "limit": 12,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Instagram Image"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Link to Post"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Social Feed",
      "blocks": [
        { "type": "post" },
        { "type": "post" },
        { "type": "post" },
        { "type": "post" }
      ]
    }
  ]
}
{% endschema %}
