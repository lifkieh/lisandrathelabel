<style>
  /* ==========================================================================
     INSTAFEED AUTO-SYNC SOCIAL SECTION (V5 Editorial Luxury Style)
     ========================================================================== */
  .social-section-{{ section.id }} {
    border-top: 1px solid var(--line, #e2e2e2);
    border-bottom: 1px solid var(--line, #e2e2e2);
    background: var(--paper, #f8f8f0);
    width: 100%;
    margin: 0;
    padding: 0;
  }

  .social-header-{{ section.id }} {
    display: flex;
    justify-content: flex-end;
    gap: 24px;
    align-items: center;
    padding: 14px clamp(14px, 2vw, 26px);
    font-family: var(--body, "Inter", sans-serif);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .social-title-{{ section.id }} {
    color: var(--cocoa, #392319);
  }

  .social-link-{{ section.id }} {
    color: var(--ink60, #666);
    border-bottom: 1px solid transparent;
    text-decoration: none;
    transition: color 0.2s, border-color 0.2s;
  }

  .social-link-{{ section.id }}:hover {
    color: var(--cocoa, #392319);
    border-bottom-color: var(--cocoa, #392319);
  }

  .social-grid-wrap-{{ section.id }} {
    width: 100%;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line, #e2e2e2);
    display: block;
  }

  /*
    KEY FIX: Do NOT force display:grid on #insta-feed children.
    Instafeed's own JavaScript engine handles grid layout internally.
    We only ensure the outer container is full-width and block-level.
  */
  #insta-feed {
    width: 100% !important;
    max-width: 100% !important;
    display: block !important;
    margin: 0 !important;
    padding: 0 !important;
    box-sizing: border-box !important;
  }

  @media (max-width: 768px) {
    .social-header-{{ section.id }} {
      justify-content: center;
      gap: 16px;
      padding: 12px 14px;
    }
  }
</style>

<section class="social-section-{{ section.id }}">
  <div class="social-header-{{ section.id }}">
    {%- if section.settings.title != blank -%}
      <span class="social-title-{{ section.id }}">{{ section.settings.title }}</span>
    {%- endif -%}

    {%- if section.settings.handle != blank -%}
      {%- assign clean_handle = section.settings.handle | replace: '@', '' -%}
      {%- assign fallback_url = 'https://www.instagram.com/' | append: clean_handle -%}
      <a class="social-link-{{ section.id }}" href="{{ section.settings.url | default: fallback_url }}" target="_blank" rel="noopener">
        {{ section.settings.handle }}
      </a>
    {%- endif -%}
  </div>

  <div class="social-grid-wrap-{{ section.id }}">
    <div id="insta-feed"></div>
  </div>
</section>

{% schema %}
{
  "name": "Social Feed (Instafeed)",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Call to action text",
      "default": "Follow us on social"
    },
    {
      "type": "text",
      "id": "handle",
      "label": "Instagram Handle",
      "default": "@lisandra.thelabel"
    },
    {
      "type": "url",
      "id": "url",
      "label": "Instagram Profile URL"
    }
  ],
  "presets": [
    {
      "name": "Social Feed (Instafeed)"
    }
  ]
}
{% endschema %}
