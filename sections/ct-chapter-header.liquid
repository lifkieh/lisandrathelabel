<style>
  .ct-chapter-header-{{ section.id }} {
    position: relative;
    padding: clamp(40px, 5vw, 60px) clamp(20px, 4vw, 40px);
    display: flex;
    justify-content: center;
    align-items: center;
    text-align: center;
    overflow: hidden;
    {% if section.settings.bg_image == blank %}
      background-color: var(--paper, #f8f8f0);
    {% else %}
      background-color: #000;
    {% endif %}
  }

  {% if section.settings.bg_image != blank %}
  .ct-chapter-header-{{ section.id }} .bg-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 1;
    opacity: 0.6; /* Darken for text readability */
  }
  {% endif %}

  .ct-chapter-header-{{ section.id }} .content {
    position: relative;
    z-index: 2;
    max-width: 60ch;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .ct-chapter-header-{{ section.id }} .chapter-title-inline {
    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: 12px;
    margin: 0 0 16px 0;
    flex-wrap: wrap;
  }

  .ct-chapter-header-{{ section.id }} .kicker-inline {
    font-family: var(--ui, "Inter", sans-serif);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    {% if section.settings.bg_image == blank %}
      color: var(--cocoa, #392319);
    {% else %}
      color: rgba(255, 255, 255, 0.9);
    {% endif %}
  }

  .ct-chapter-header-{{ section.id }} .separator {
    font-family: var(--ui, "Inter", sans-serif);
    font-size: 11px;
    font-weight: 400;
    {% if section.settings.bg_image == blank %}
      color: var(--cocoa, #392319);
    {% else %}
      color: rgba(255, 255, 255, 0.6);
    {% endif %}
  }

  .ct-chapter-header-{{ section.id }} .heading-inline {
    font-family: var(--heading, "Bodoni Moda", serif);
    font-style: normal;
    font-size: 28px;
    line-height: 1.1;
    font-weight: 600;
    {% if section.settings.bg_image == blank %}
      color: var(--cocoa, #392319);
    {% else %}
      color: #fff;
    {% endif %}
  }

  .ct-chapter-header-{{ section.id }} .desc {
    font-family: var(--body, "Inter", sans-serif);
    font-size: 13px;
    max-width: 50ch;
    line-height: 1.6;
    {% if section.settings.bg_image == blank %}
      color: var(--cocoa, #392319);
    {% else %}
      color: rgba(255, 255, 255, 0.9);
    {% endif %}
    margin: 0;
  }
</style>

<div class="ct-chapter-header-{{ section.id }}">
  {%- if section.settings.bg_image != blank -%}
    <img 
      src="{{ section.settings.bg_image | img_url: '2000x' }}" 
      alt="{{ section.settings.bg_image.alt | default: section.settings.heading | default: 'Chapter Header Background' | escape }}" 
      class="bg-img" 
      loading="lazy"
      width="{{ section.settings.bg_image.width }}"
      height="{{ section.settings.bg_image.height }}"
    >
  {%- endif -%}

  <div class="content reveal">
    <h2 class="chapter-title-inline">
      {%- if section.settings.kicker != blank -%}
        <span class="kicker-inline">{{ section.settings.kicker }}</span>
        {%- if section.settings.heading != blank -%}
          <span class="separator">—</span>
        {%- endif -%}
      {%- endif -%}
      
      {%- if section.settings.heading != blank -%}
        <span class="heading-inline">{{ section.settings.heading }}</span>
      {%- endif -%}
    </h2>

    {%- if section.settings.description != blank -%}
      <p class="desc">{{ section.settings.description | newline_to_br }}</p>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "CT Chapter Header",
  "settings": [
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background Image (Optional)",
      "info": "If added, text will be white with a dark overlay."
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker (e.g. CHAPTER ONE)",
      "default": "CHAPTER ONE"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "SUNLIT"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "This chapter captures the ease of island days..."
    }
  ],
  "presets": [
    {
      "name": "CT Chapter Header"
    }
  ]
}
{% endschema %}
