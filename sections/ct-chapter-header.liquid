<style>
  .ct-chapter-header-{{ section.id }} {
    position: relative;
    padding: clamp(80px, 10vw, 140px) clamp(20px, 4vw, 40px);
    display: flex;
    justify-content: center;
    align-items: center;
    text-align: center;
    overflow: hidden;
    {% if section.settings.bg_image == blank %}
      background-color: var(--paper, #f8f8f0);
    {% else %}
      background-color: #000;
    {% endif %}
  }

  {% if section.settings.bg_image != blank %}
  .ct-chapter-header-{{ section.id }} .bg-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 1;
    opacity: 0.6; /* Darken for text readability */
  }
  {% endif %}

  .ct-chapter-header-{{ section.id }} .content {
    position: relative;
    z-index: 2;
    max-width: 60ch;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .ct-chapter-header-{{ section.id }} .kicker {
    font-family: var(--ui, "Inter", sans-serif);
    font-size: 11px;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    margin-bottom: 24px;
    {% if section.settings.bg_image == blank %}
      color: var(--cocoa, #392319);
    {% else %}
      color: rgba(255, 255, 255, 0.9);
    {% endif %}
  }

  .ct-chapter-header-{{ section.id }} .heading {
    font-family: var(--heading, "Bodoni Moda", serif);
    font-style: normal;
    font-size: clamp(32px, 5vw, 64px);
    line-height: 1.1;
    margin: 0 0 32px 0;
    font-weight: 400;
    {% if section.settings.bg_image == blank %}
      color: var(--cocoa, #392319);
    {% else %}
      color: #fff;
    {% endif %}
  }

  .ct-chapter-header-{{ section.id }} .divider {
    width: 40px;
    height: 1px;
    margin: 0 auto 32px;
    {% if section.settings.bg_image == blank %}
      background: var(--cocoa, #392319);
    {% else %}
      background: rgba(255, 255, 255, 0.5);
    {% endif %}
  }

  .ct-chapter-header-{{ section.id }} .desc {
    font-family: var(--body, "Inter", sans-serif);
    font-size: clamp(14px, 1.5vw, 15px);
    line-height: 1.6;
    {% if section.settings.bg_image == blank %}
      color: var(--cocoa, #392319);
    {% else %}
      color: rgba(255, 255, 255, 0.9);
    {% endif %}
    margin: 0;
  }
</style>

<div class="ct-chapter-header-{{ section.id }}">
  {%- if section.settings.bg_image != blank -%}
    <img src="{{ section.settings.bg_image | img_url: '2000x' }}" alt="" class="bg-img" loading="lazy">
  {%- endif -%}

  <div class="content reveal">
    {%- if section.settings.kicker != blank -%}
      <div class="kicker">{{ section.settings.kicker }}</div>
    {%- endif -%}
    
    {%- if section.settings.heading != blank -%}
      <h2 class="heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    <div class="divider"></div>

    {%- if section.settings.description != blank -%}
      <p class="desc">{{ section.settings.description | newline_to_br }}</p>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "CT Chapter Header",
  "settings": [
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background Image (Optional)",
      "info": "If added, text will be white with a dark overlay."
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker (e.g. CHAPTER ONE)",
      "default": "CHAPTER ONE"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "SUNLIT"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "This chapter captures the ease of island days..."
    }
  ],
  "presets": [
    {
      "name": "CT Chapter Header"
    }
  ]
}
{% endschema %}
