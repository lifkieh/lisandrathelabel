{%- comment -%}
  Product Recommendations V5 (Editorial Lookbook Style)
  Combines:
  1. Manual Metafield Fallback (custom.related_products)
  2. Shopify Recommendations API (Algorithm)
  3. Automatic Collection Fallback (Guarantees recommendations on ALL products even if Shopify API returns 0 items)
{%- endcomment -%}

{%- liquid
  assign sid = section.id
  assign kicker = section.settings.kicker | default: 'CURATED RECOMMENDATIONS'
  assign title = section.settings.title | default: 'You May Also Like'
  assign limit = section.settings.limit | default: 8
  
  assign manual_recommendations = product.metafields.custom.related_products.value
  assign has_manual = false
  if manual_recommendations != blank and manual_recommendations.count > 0
    assign has_manual = true
  endif

  assign fallback_collection = product.collections.first | default: collections.all
-%}

<style>
  /* === EDITORIAL RECOMMENDATIONS SECTION === */
  .v5-ymal-section-{{ sid }} {
    padding: clamp(38px, 5.5vw, 68px) 0;
    background: var(--paper, #f8f8f0);
    border-top: 1px solid var(--line, #e2e2e2);
    overflow: hidden;
    width: 100%;
  }
  .v5-ymal-head-{{ sid }} {
    text-align: center;
    margin-bottom: clamp(20px, 3.5vw, 36px);
    padding: 0 clamp(14px, 2vw, 26px);
  }
  .v5-ymal-kicker-{{ sid }} {
    font-family: var(--body, 'Inter', sans-serif);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #8a5a44;
    display: block;
    margin-bottom: 6px;
  }
  .v5-ymal-head-{{ sid }} h3 {
    font-family: var(--display, 'Bodoni Moda', Georgia, serif);
    font-size: clamp(26px, 3.8vw, 38px);
    font-weight: 400;
    font-style: italic;
    color: var(--cocoa, #392319);
    margin: 0;
    letter-spacing: -0.01em;
  }

  /* === SLIDER & GRID WRAPPER === */
  .v5-ymal-wrap-{{ sid }} {
    position: relative;
    width: 100%;
    margin: 0 auto;
    padding: 0;
  }
  .v5-ymal-grid-{{ sid }} {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    gap: 2px;
    padding: 0;
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
  .v5-ymal-grid-{{ sid }}::-webkit-scrollbar {
    display: none;
  }

  /* === EDITORIAL CARD (4/5 Aspect Ratio) === */
  .v5-ymal-card-{{ sid }} {
    flex: 0 0 75vw;
    scroll-snap-align: center;
    position: relative;
    overflow: hidden;
    background: var(--sand, #e0d9b5);
    aspect-ratio: 4/5;
    cursor: pointer;
    text-decoration: none;
    display: block;
  }
  .v5-ymal-card-{{ sid }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.65s cubic-bezier(0.25, 1, 0.5, 1), filter 0.5s ease;
  }

  /* === GLASSMORPHISM INFO PANEL === */
  .v5-ymal-panel-{{ sid }} {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    background: rgba(248, 248, 240, 0.96);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    padding: 14px 16px 16px;
    transform: translateY(100%);
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    display: flex;
    flex-direction: column;
    gap: 8px;
    box-shadow: 0 -4px 16px rgba(0, 0, 0, 0.05);
    z-index: 2;
  }
  .v5-ymal-row-{{ sid }} {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 8px;
  }
  .v5-ymal-title-{{ sid }} {
    font-family: var(--body, 'Inter', sans-serif);
    font-size: 11.5px;
    font-weight: 500;
    letter-spacing: 0.04em;
    color: var(--cocoa, #392319);
    margin: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .v5-ymal-price-{{ sid }} {
    font-family: var(--body, 'Inter', sans-serif);
    font-size: 11px;
    color: #7a6258;
    letter-spacing: 0.02em;
    white-space: nowrap;
  }
  .v5-ymal-price-{{ sid }} s {
    color: rgba(57, 35, 25, 0.5);
    margin-right: 4px;
    font-weight: 400;
  }
  .v5-ymal-sizes-{{ sid }} {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
  }
  .v5-ymal-size-btn-{{ sid }} {
    font-family: var(--body, 'Inter', sans-serif);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    border: 1px solid var(--line, #e2e2e2);
    padding: 4px 9px;
    background: transparent;
    color: var(--cocoa, #392319);
    text-decoration: none;
    transition: all 0.2s ease;
  }
  .v5-ymal-size-btn-{{ sid }}:hover {
    background: var(--cocoa, #392319);
    color: #f8f8f0;
    border-color: var(--cocoa, #392319);
  }

  /* === FLOATING CAROUSEL ARROWS === */
  .v5-ymal-nav-{{ sid }} {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: rgba(248, 248, 240, 0.92);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border: 1px solid rgba(57, 35, 25, 0.18);
    box-shadow: 0 6px 20px rgba(30, 18, 10, 0.16);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 10;
    color: var(--cocoa, #392319);
    transition: background 0.25s ease, color 0.25s ease, transform 0.25s cubic-bezier(0.25, 1, 0.5, 1), opacity 0.25s ease, box-shadow 0.25s ease;
    padding: 0;
  }
  .v5-ymal-nav-{{ sid }}:hover {
    background: var(--cocoa, #392319);
    color: #f8f8f0;
    border-color: var(--cocoa, #392319);
    transform: translateY(-50%) scale(1.08);
    box-shadow: 0 10px 28px rgba(30, 18, 10, 0.26);
  }
  .v5-ymal-nav-{{ sid }} svg {
    width: 18px;
    height: 18px;
    stroke-width: 1.8;
  }
  .v5-ymal-nav-{{ sid }}.prev { left: clamp(14px, 2.5vw, 36px); }
  .v5-ymal-nav-{{ sid }}.next { right: clamp(14px, 2.5vw, 36px); }

  .v5-ymal-nav-{{ sid }}.is-hidden {
    opacity: 0 !important;
    pointer-events: none !important;
    visibility: hidden;
  }

  /* === RESPONSIVE BREAKPOINTS === */
  @media (min-width: 900px) {
    .v5-ymal-grid-{{ sid }} {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: 2px;
      overflow-x: visible;
      padding: 0;
    }
    .v5-ymal-card-{{ sid }} {
      flex: none;
      width: auto;
      scroll-snap-align: none;
    }
    .v5-ymal-card-{{ sid }}:hover img {
      transform: scale(1.04);
      filter: brightness(0.92);
    }
    .v5-ymal-card-{{ sid }}:hover .v5-ymal-panel-{{ sid }} {
      transform: translateY(0);
    }
  }

  @media (max-width: 899px) {
    .v5-ymal-panel-{{ sid }} {
      transform: translateY(0);
      background: rgba(248, 248, 240, 0.96);
      padding: 10px 12px;
    }
  }
</style>

<section class="v5-ymal-section-{{ sid }}" id="v5-ymal-section-{{ sid }}" {% if has_manual == false and recommendations.performed == false %}style="display:none;"{% endif %}>
  <div class="v5-ymal-head-{{ sid }}">
    <span class="v5-ymal-kicker-{{ sid }}">{{ kicker }}</span>
    <h3>{{ title }}</h3>
  </div>

  <div class="v5-ymal-wrap-{{ sid }}">
    <button class="v5-ymal-nav-{{ sid }} prev" id="v5-ymal-prev-{{ sid }}" onclick="v5ScrollYmal_{{ sid | replace: '-', '_' }}(-1)" aria-label="Previous recommendations">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="15 18 9 12 15 6"></polyline>
      </svg>
    </button>

    <div class="v5-ymal-grid-{{ sid }}" id="v5-ymal-grid-{{ sid }}">
      {%- if has_manual -%}
        {%- for rec_product in manual_recommendations limit: limit -%}
          {%- render 'product-card-editorial-v5', product: rec_product, sid: sid -%}
        {%- endfor -%}
      {%- elsif recommendations.performed and recommendations.products_count > 0 -%}
        {%- for rec_product in recommendations.products limit: limit -%}
          {%- render 'product-card-editorial-v5', product: rec_product, sid: sid -%}
        {%- endfor -%}
      {%- endif -%}
    </div>

    <button class="v5-ymal-nav-{{ sid }} next" id="v5-ymal-next-{{ sid }}" onclick="v5ScrollYmal_{{ sid | replace: '-', '_' }}(1)" aria-label="Next recommendations">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="9 18 15 12 9 6"></polyline>
      </svg>
    </button>
  </div>
</section>

{%- comment -%} Hidden pre-rendered fallback items in case Shopify Recommendations API returns 0 products {%- endcomment -%}
{%- if has_manual == false -%}
<div id="v5-ymal-fallback-data-{{ sid }}" style="display:none;">
  {%- assign count = 0 -%}
  {%- for fall_prod in fallback_collection.products -%}
    {%- if fall_prod.id != product.id and count < limit -%}
      {%- render 'product-card-editorial-v5', product: fall_prod, sid: sid -%}
      {%- assign count = count | plus: 1 -%}
    {%- endif -%}
  {%- endfor -%}
</div>
{%- endif -%}

{%- if has_manual == false and recommendations.performed == false -%}
<script>
  document.addEventListener('DOMContentLoaded', function() {
    const url = `{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ limit }}`;

    fetch(url)
      .then(response => response.text())
      .then(text => {
        const html = document.createElement('div');
        html.innerHTML = text;
        const newGrid = html.querySelector('#v5-ymal-grid-{{ sid }}');

        const gridEl = document.getElementById('v5-ymal-grid-{{ sid }}');
        const sectionEl = document.getElementById('v5-ymal-section-{{ sid }}');

        if (newGrid && newGrid.children.length > 0) {
          gridEl.innerHTML = newGrid.innerHTML;
          sectionEl.style.display = 'block';
        } else {
          // FALLBACK: Use collection fallback if Shopify API returned 0 recommendations
          const fallbackData = document.getElementById('v5-ymal-fallback-data-{{ sid }}');
          if (fallbackData && fallbackData.children.length > 0 && gridEl && sectionEl) {
            gridEl.innerHTML = fallbackData.innerHTML;
            sectionEl.style.display = 'block';
          }
        }
        updateV5YmalArrows_{{ sid | replace: '-', '_' }}();
      })
      .catch(e => {
        console.error("Error fetching product recommendations:", e);
        const fallbackData = document.getElementById('v5-ymal-fallback-data-{{ sid }}');
        const gridEl = document.getElementById('v5-ymal-grid-{{ sid }}');
        const sectionEl = document.getElementById('v5-ymal-section-{{ sid }}');
        if (fallbackData && fallbackData.children.length > 0 && gridEl && sectionEl) {
          gridEl.innerHTML = fallbackData.innerHTML;
          sectionEl.style.display = 'block';
          updateV5YmalArrows_{{ sid | replace: '-', '_' }}();
        }
      });
  });
</script>
{%- endif -%}

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const grid = document.getElementById("v5-ymal-grid-{{ sid }}");
    if(grid) {
      updateV5YmalArrows_{{ sid | replace: '-', '_' }}();
      grid.addEventListener('scroll', updateV5YmalArrows_{{ sid | replace: '-', '_' }});
      window.addEventListener('resize', updateV5YmalArrows_{{ sid | replace: '-', '_' }});
    }
  });

  function updateV5YmalArrows_{{ sid | replace: '-', '_' }}() {
    const grid = document.getElementById("v5-ymal-grid-{{ sid }}");
    const prevBtn = document.getElementById("v5-ymal-prev-{{ sid }}");
    const nextBtn = document.getElementById("v5-ymal-next-{{ sid }}");
    if(!grid || !prevBtn || !nextBtn) return;

    const maxScrollLeft = grid.scrollWidth - grid.clientWidth;

    if (maxScrollLeft <= 4) {
      prevBtn.classList.add('is-hidden');
      nextBtn.classList.add('is-hidden');
      return;
    }

    if (grid.scrollLeft <= 4) {
      prevBtn.classList.add('is-hidden');
    } else {
      prevBtn.classList.remove('is-hidden');
    }

    if (grid.scrollLeft >= maxScrollLeft - 4) {
      nextBtn.classList.add('is-hidden');
    } else {
      nextBtn.classList.remove('is-hidden');
    }
  }

  function v5ScrollYmal_{{ sid | replace: '-', '_' }}(direction) {
    const grid = document.getElementById("v5-ymal-grid-{{ sid }}");
    if (!grid) return;
    const card = grid.querySelector(".v5-ymal-card-{{ sid }}");
    const scrollAmount = card ? (card.offsetWidth + 2) : 320;
    grid.scrollBy({
      left: scrollAmount * direction,
      behavior: "smooth"
    });
  }
</script>

{% schema %}
{
  "name": "V5 Recommendations (Lux)",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Sub-heading / Kicker",
      "default": "CURATED RECOMMENDATIONS"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "You May Also Like"
    },
    {
      "type": "range",
      "id": "limit",
      "min": 3,
      "max": 12,
      "step": 1,
      "default": 4,
      "label": "Maximum products to show"
    }
  ],
  "presets": [
    {
      "name": "V5 Recommendations (Lux)"
    }
  ],
  "templates": ["product"]
}
{% endschema %}
