<style>
  .ct-intro-{{ section.id }} {
    background-color: var(--paper, #f8f8f0);
    padding: clamp(24px, 3vw, 40px) clamp(20px, 4vw, 40px);
    display: flex;
    justify-content: center;
  }
  
  .ct-intro-container {
    display: flex;
    flex-direction: column;
    max-width: 1000px;
    width: 100%;
    gap: 32px;
    align-items: center;
  }
  
  @media (min-width: 768px) {
    .ct-intro-container {
      flex-direction: row;
      gap: 60px;
      align-items: stretch;
    }
  }

  .ct-intro-image {
    width: 100%;
    max-width: 380px;
    margin: 0 auto;
    flex-shrink: 0;
  }
  
  @media (min-width: 768px) {
    .ct-intro-image {
      width: 45%;
      margin: 0;
    }
  }

  .ct-intro-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    aspect-ratio: 3/4;
  }

  .ct-intro-content {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    text-align: left;
  }

  .ct-intro-subtitle {
    font-family: var(--ui, "Inter", sans-serif);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #8a5a44;
    margin-bottom: 20px;
    display: block;
  }

  .ct-intro-content p {
    font-family: var(--body, "Inter", sans-serif);
    font-size: 13px;
    line-height: 1.5;
    color: var(--cocoa, #392319);
    margin: 0 0 16px 0;
    max-width: 50ch;
  }

  /* Drop Cap Magic for Magazine Style */
  .ct-intro-content p:first-of-type::first-letter {
    font-family: var(--heading, "Bodoni Moda", serif);
    font-size: 64px;
    line-height: 0.75;
    float: left;
    margin-right: 8px;
    margin-top: 6px;
    color: var(--cocoa, #392319);
    font-weight: 400;
    text-transform: uppercase;
  }
</style>

<div class="ct-intro-{{ section.id }}">
  <div class="ct-intro-container reveal">
    
    {%- if section.settings.image != blank -%}
      <div class="ct-intro-image">
        <img 
          src="{{ section.settings.image | img_url: '800x' }}" 
          alt="{{ section.settings.image.alt | default: section.settings.kicker | default: 'Intro Image' | escape }}" 
          loading="lazy"
          width="{{ section.settings.image.width }}"
          height="{{ section.settings.image.height }}"
        >
      </div>
    {%- endif -%}

    <div class="ct-intro-content">
      {%- if section.settings.kicker != blank -%}
        <span class="ct-intro-subtitle">{{ section.settings.kicker }}</span>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <div class="ct-intro-text-wrap">
          {%- assign paragraphs = section.settings.text | split: '<br>' -%}
          {%- for p in paragraphs -%}
            <p>{{ p }}</p>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
    
  </div>
</div>

{% schema %}
{
  "name": "CT Editorial Intro",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Editorial Image (Left Column)"
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker (e.g. THE COLLECTION)",
      "default": "CIELO TRÓPICO"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Introduction Text",
      "default": "Cielo Tropico is inspired by the rhythm of island life and our home in Bali, where sun-drenched days give way to slow evenings and nights that linger..."
    }
  ],
  "presets": [
    {
      "name": "CT Editorial Intro"
    }
  ]
}
{% endschema %}
