<style>
  .ct-hero-{{ section.id }} {
    {% if section.settings.height == 'full' %}
      height: calc(100vh - 31px);
      min-height: 600px;
    {% else %}
      aspect-ratio: 16/9;
    {% endif %}
    position: relative;
    width: 100%;
    margin-top: -69px; /* Presisi sama dengan tinggi navbar untuk transparent hero */
    overflow: hidden;
    background: #000;
  }
  .ct-hero-{{ section.id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    animation: kenBurnsHero 25s ease-out forwards;
  }
  
  /* Apply focal point if set */
  {% if section.settings.focal_point != 'center center' %}
  .ct-hero-{{ section.id }} img.desktop-img {
    object-position: {{ section.settings.focal_point }};
  }
  {% endif %}
  
  {% if section.settings.mobile_focal_point != 'center center' %}
  .ct-hero-{{ section.id }} img.mobile-img {
    object-position: {{ section.settings.mobile_focal_point }};
  }
  {% endif %}

  @keyframes kenBurnsHero {
    from { transform: scale(1); }
    to { transform: scale(1.15); }
  }
  
  /* Gradien halus tipis agar header putih transparan tetap terlihat */
  .ct-hero-{{ section.id }}::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(
      to bottom,
      rgba(0, 0, 0, 0.15) 0%,
      transparent 15%
    );
  }

  .ct-hero-{{ section.id }} .mobile-img {
    display: none;
  }

  @media (max-width: 768px) {
    .ct-hero-{{ section.id }} {
      {% if section.settings.height == 'full' %}
        height: 85vh;
        min-height: 520px;
      {% else %}
        aspect-ratio: 3/4;
      {% endif %}
      margin-top: -69px;
    }
    {% if section.settings.mobile_image != blank %}
      .ct-hero-{{ section.id }} .desktop-img {
        display: none;
      }
      .ct-hero-{{ section.id }} .mobile-img {
        display: block;
      }
    {% endif %}
  }
</style>

<div class="ct-hero-{{ section.id }}">
  {%- if section.settings.image != blank -%}
    <img 
      src="{{ section.settings.image | img_url: '2000x' }}" 
      alt="Cielo Tropico Campaign"
      loading="eager"
      width="{{ section.settings.image.width }}"
      height="{{ section.settings.image.height }}"
      class="desktop-img"
    />
  {%- else -%}
    {{ 'lifestyle-2' | placeholder_svg_tag: 'desktop-img' }}
  {%- endif -%}

  {%- if section.settings.mobile_image != blank -%}
    <img 
      src="{{ section.settings.mobile_image | img_url: '1000x' }}" 
      alt="Cielo Tropico Campaign"
      loading="eager"
      width="{{ section.settings.mobile_image.width }}"
      height="{{ section.settings.mobile_image.height }}"
      class="mobile-img"
    />
  {%- endif -%}
</div>

<script>
  // Script untuk mengatur header v5 menjadi transparan saat berada di posisi paling atas hero full-bleed
  document.addEventListener("DOMContentLoaded", () => {
    const siteHeader = document.getElementById('siteHeader') || document.querySelector('.hdr-v5');
    if (siteHeader) {
      function checkHeaderTransparency() {
        if (window.scrollY < 50) {
          siteHeader.classList.add('is-transparent');
        } else {
          siteHeader.classList.remove('is-transparent');
        }
      }
      checkHeaderTransparency();
      window.addEventListener('scroll', checkHeaderTransparency);
    }
  });
</script>

{% schema %}
{
  "name": "CT Hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Desktop Image (Pre-edited with text)"
    },
    {
      "type": "select",
      "id": "focal_point",
      "label": "Desktop Focal Point",
      "options": [
        { "value": "20% 0", "label": "Top Left" },
        { "value": "top center", "label": "Top Center" },
        { "value": "80% 0", "label": "Top Right" },
        { "value": "20% 50%", "label": "Left" },
        { "value": "center center", "label": "Center" },
        { "value": "80% 50%", "label": "Right" },
        { "value": "20% 100%", "label": "Bottom Left" },
        { "value": "bottom center", "label": "Bottom Center" },
        { "value": "80% 100%", "label": "Bottom Right" }
      ],
      "default": "center center"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile Image (Optional)"
    },
    {
      "type": "select",
      "id": "mobile_focal_point",
      "label": "Mobile Focal Point",
      "options": [
        { "value": "20% 0", "label": "Top Left" },
        { "value": "top center", "label": "Top Center" },
        { "value": "80% 0", "label": "Top Right" },
        { "value": "20% 50%", "label": "Left" },
        { "value": "center center", "label": "Center" },
        { "value": "80% 50%", "label": "Right" },
        { "value": "20% 100%", "label": "Bottom Left" },
        { "value": "bottom center", "label": "Bottom Center" },
        { "value": "80% 100%", "label": "Bottom Right" }
      ],
      "default": "center center"
    },
    {
      "type": "select",
      "id": "height",
      "label": "Banner Height",
      "options": [
        {
          "value": "full",
          "label": "Full Screen (100vh)"
        },
        {
          "value": "ratio",
          "label": "Widescreen (16:9)"
        }
      ],
      "default": "full"
    }
  ],
  "presets": [
    {
      "name": "CT Hero",
      "settings": {
        "height": "full"
      }
    }
  ]
}
{% endschema %}
