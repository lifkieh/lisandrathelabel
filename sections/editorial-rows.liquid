<style>
  /* ---------- editorial rows ---------- */
  .editorial-rows-{{ section.id }} {
    display: flex;
    flex-direction: column;
  }
  .editorial-row-{{ section.id }} {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1px;
    background: var(--line, #e2e2e2);
  }
  .editorial-row-{{ section.id }}.layout-image_right {
    grid-template-columns: 1fr 1fr;
  }
  .editorial-row-{{ section.id }}.layout-image_right figure {
    order: 2;
  }
  .editorial-row-{{ section.id }}.layout-image_right .editorial-text-wrap {
    order: 1;
  }
  
  .editorial-row-{{ section.id }} figure {
    margin: 0;
    aspect-ratio: 4/5;
    background: var(--sand, #e0d9b5);
    position: relative;
  }
  .editorial-row-{{ section.id }} figure img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .editorial-row-{{ section.id }} .editorial-text-wrap {
    background: var(--sand, #e0d9b5);
    padding: clamp(24px, 4vw, 56px);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .editorial-row-{{ section.id }} .editorial-text p {
    font-family: var(--display2, serif);
    font-style: italic;
    font-size: clamp(16px, 1.8vw, 28px);
    line-height: 1.45;
    margin: 0;
    max-width: 34ch;
    color: #3a2b23;
  }

  /* Editorial Row: Konsep 1 — The Editorial Caption Pill / Floating Card for Mobile */
  @media (max-width: 768px) {
    .editorial-row-{{ section.id }} {
      position: relative;
      display: block;
      background: var(--sand, #e0d9b5);
      border-top: 1px solid var(--line, #e2e2e2);
      overflow: hidden;
      width: 100%;
    }
    .editorial-row-{{ section.id }} figure {
      width: 100%;
      aspect-ratio: 4/5;
      display: block;
    }
    .editorial-row-{{ section.id }} .editorial-text-wrap {
      position: absolute;
      bottom: 14px;
      left: 12px;
      right: 12px;
      z-index: 5;
      background: rgba(248, 248, 240, 0.94);
      border: 1px solid rgba(57, 35, 25, 0.16);
      box-shadow: 0 8px 24px rgba(45, 28, 20, 0.12);
      padding: 14px 18px;
      display: flex;
      align-items: center;
      justify-content: center;
      text-align: center;
    }
    .editorial-row-{{ section.id }} .editorial-text p {
      font-size: clamp(13.5px, 3.8vw, 17px);
      color: var(--cocoa, #392319);
      max-width: 100%;
    }
  }
</style>

<div class="editorial-rows-{{ section.id }}">
  {%- for block in section.blocks -%}
    <div class="editorial-row-{{ section.id }} layout-{{ block.settings.layout }}" {{ block.shopify_attributes }}>
      <figure>
        {%- if block.settings.image != blank -%}
          <img src="{{ block.settings.image | img_url: '900x' }}" alt="{{ block.settings.image.alt | escape }}" loading="lazy" />
        {%- else -%}
          <img src="https://cdn.shopify.com/s/images/themes/product-{{ forloop.index | modulo: 6 | plus: 1 }}.png" alt="Editorial Placeholder" loading="lazy" />
        {%- endif -%}
      </figure>
      <div class="editorial-text-wrap">
        <div class="editorial-text">
          <p>{{ block.settings.text | newline_to_br }}</p>
        </div>
      </div>
    </div>
  {%- endfor -%}
</div>

{% schema %}
{
  "name": "Editorial Rows",
  "settings": [],
  "blocks": [
    {
      "type": "row",
      "name": "Editorial Row",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Quote / Text",
          "default": "\"Made for the woman who moves between the water, the sand, and the dinner table without ever changing who she is.\""
        },
        {
          "type": "select",
          "id": "layout",
          "label": "Desktop Layout",
          "options": [
            {
              "value": "image_left",
              "label": "Image on Left"
            },
            {
              "value": "image_right",
              "label": "Image on Right"
            }
          ],
          "default": "image_left"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Editorial Rows",
      "blocks": [
        {
          "type": "row",
          "settings": {
            "layout": "image_left"
          }
        },
        {
          "type": "row",
          "settings": {
            "layout": "image_right"
          }
        }
      ]
    }
  ]
}
{% endschema %}
