{%- comment -%}
  UGC Shoppable V5 (As Styled by You) — Adaptive Editorial Edition
  Intelligently adapts layout based on photo count:
  - 1 Photo : "Editorial Muse Spotlight" (Split 50:50 High-Fashion Magazine Layout)
  - 2 Photos: "Duo Lookbook Curation" (Centered 2-Column Grid max-width: 740px)
  - 3 Photos: "Trio Editorial Showcase" (Centered 3-Column Grid max-width: 1100px)
  - 4+ Photos: "Full Lookbook Carousel" (4-Column Full-Width with Smart Auto-Hide Arrows)
  - 100% Mobile & Tablet Compact Responsiveness
{%- endcomment -%}

{%- liquid
  assign sid = section.id
  assign kicker = section.settings.kicker | default: 'Community & Styling'
  assign heading = section.settings.heading | default: 'As Styled by You'
  assign ugc_looks = product.metafields.custom.as_styled_by_you.value
  assign has_ugc = false
  assign ugc_count = 0
  if ugc_looks != blank and ugc_looks.count > 0
    assign has_ugc = true
    assign ugc_count = ugc_looks.count | default: ugc_looks.size
  endif
-%}

<style>
  /* === UGC SECTION BASE === */
  .v5-ugc-section-{{ sid }} {
    padding: clamp(38px, 5.5vw, 68px) 0;
    background: var(--paper, #f8f8f0);
    border-top: 1px solid var(--line, #e2e2e2);
    width: 100%;
    overflow: hidden;
  }

  /* === CENTERED EDITORIAL HEADER === */
  .v5-ugc-head-{{ sid }} {
    text-align: left;
    margin-bottom: clamp(20px, 3.5vw, 36px);
    padding: 0 clamp(16px, 3vw, 40px);
    width: 100%;
    box-sizing: border-box;
  }
  .v5-ugc-kicker-{{ sid }} {
    display: none;
  }
  .v5-ugc-head-{{ sid }} h3 {
    font-family: var(--display, 'Bodoni Moda', Georgia, serif);
    font-size: clamp(24px, 3.8vw, 32px);
    font-weight: 400;
    font-style: normal;
    color: var(--cocoa, #392319);
    margin: 0;
    letter-spacing: -0.01em;
  }

  /* =======================================================
     LAYOUT 1: SINGLE PHOTO SPOTLIGHT (Opsi 3)
     ======================================================= */
  .v5-ugc-spotlight-wrap-{{ sid }} {
    max-width: 880px;
    margin: 0 auto;
    padding: 0 clamp(16px, 3vw, 24px);
  }
  .v5-ugc-spotlight-card-{{ sid }} {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    background: #fdfdf9;
    border: 1px solid rgba(57, 35, 25, 0.12);
    box-shadow: 0 10px 30px rgba(57, 35, 25, 0.04);
    align-items: stretch;
    overflow: hidden;
  }
  .v5-ugc-spotlight-media-{{ sid }} {
    position: relative;
    aspect-ratio: 4/5;
    background: var(--sand, #e0d9b5);
    overflow: hidden;
    cursor: pointer;
  }
  .v5-ugc-spotlight-media-{{ sid }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.65s cubic-bezier(0.25, 1, 0.5, 1), filter 0.5s ease;
  }
  .v5-ugc-spotlight-media-{{ sid }}:hover img {
    transform: scale(1.04);
    filter: brightness(0.9);
  }
  .v5-ugc-spotlight-media-{{ sid }}:hover .v5-ugc-hover-{{ sid }} {
    opacity: 1;
  }
  .v5-ugc-spotlight-info-{{ sid }} {
    padding: clamp(24px, 3.5vw, 44px);
    display: flex;
    flex-direction: column;
    justify-content: center;
    text-align: left;
  }
  .v5-ugc-spotlight-tag-{{ sid }} {
    display: none;
  }
  .v5-ugc-spotlight-title-{{ sid }} {
    font-family: var(--display, 'Bodoni Moda', Georgia, serif);
    font-size: clamp(22px, 2.8vw, 30px);
    font-weight: 400;
    font-style: normal;
    color: var(--cocoa, #392319);
    margin: 0 0 14px;
    line-height: 1.2;
  }
  .v5-ugc-spotlight-quote-{{ sid }} {
    font-family: var(--body, 'Inter', sans-serif);
    font-size: 13px;
    line-height: 1.65;
    color: #6e5c52;
    margin: 0 0 24px;
  }
  .v5-ugc-spotlight-featured-{{ sid }} {
    background: rgba(57, 35, 25, 0.035);
    border: 1px solid rgba(57, 35, 25, 0.08);
    padding: 12px 14px;
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 22px;
  }
  .v5-ugc-spotlight-thumb-{{ sid }} {
    width: 48px;
    height: 48px;
    object-fit: cover;
    background: #eaeaea;
    flex-shrink: 0;
  }
  .v5-ugc-spotlight-pname-{{ sid }} {
    font-family: var(--body, 'Inter', sans-serif);
    font-size: 12px;
    font-weight: 500;
    color: var(--cocoa, #392319);
    margin: 0 0 2px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .v5-ugc-spotlight-pprice-{{ sid }} {
    font-family: var(--body, 'Inter', sans-serif);
    font-size: 11px;
    color: #7a6258;
  }
  .v5-ugc-spotlight-btn-{{ sid }} {
    width: 100%;
    height: 46px;
    background: var(--cocoa, #392319);
    color: #ffffff;
    font-family: var(--body, 'Inter', sans-serif);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    border: none;
    cursor: pointer;
    transition: background 0.2s ease, transform 0.2s ease;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .v5-ugc-spotlight-btn-{{ sid }}:hover {
    background: #251610;
    transform: translateY(-1px);
  }

  @media (max-width: 767px) {
    .v5-ugc-spotlight-card-{{ sid }} {
      grid-template-columns: 1fr;
      max-width: 360px;
      margin: 0 auto;
    }
    .v5-ugc-spotlight-info-{{ sid }} {
      padding: 20px 18px 24px;
    }
  }

  /* =======================================================
     LAYOUT 2 & 3: DUO / TRIO / MULTI PHOTO GRID
     ======================================================= */
  .v5-ugc-wrap-{{ sid }} {
    position: relative;
    width: 100%;
    margin: 0 auto;
  }

  .v5-ugc-grid-{{ sid }} {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    gap: 2px;
    padding: 0;
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
  .v5-ugc-grid-{{ sid }}::-webkit-scrollbar {
    display: none;
  }

  .v5-ugc-card-{{ sid }} {
    flex: 0 0 75vw;
    scroll-snap-align: center;
    margin: 0;
    aspect-ratio: 4/5;
    background: var(--sand, #e0d9b5);
    overflow: hidden;
    cursor: pointer;
    position: relative;
    transition: opacity 0.25s ease, transform 0.25s ease;
  }
  .v5-ugc-card-{{ sid }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.65s cubic-bezier(0.25, 1, 0.5, 1), filter 0.5s ease;
    display: block;
  }

  /* === HOVER OVERLAY REVEAL === */
  .v5-ugc-hover-{{ sid }} {
    position: absolute;
    inset: 0;
    background: rgba(30, 18, 10, 0.52);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 8px;
    opacity: 0;
    transition: opacity 0.4s ease;
    pointer-events: none;
    z-index: 2;
  }
  .v5-ugc-hover-{{ sid }} .v5-ugc-handle {
    font-family: var(--body, 'Inter', sans-serif);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(248, 248, 240, 0.85);
    transform: translateY(8px);
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1) 0.05s;
  }
  .v5-ugc-hover-{{ sid }} .v5-ugc-shop {
    font-family: var(--body, 'Inter', sans-serif);
    font-size: 10.5px;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #f8f8f0;
    border-bottom: 1px solid rgba(248, 248, 240, 0.6);
    padding-bottom: 2px;
    transform: translateY(8px);
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1) 0.1s;
  }

  /* === DESKTOP ADAPTIVE GRIDS (Edge-to-Edge Full Bleed) === */
  @media (min-width: 900px) {
    /* 2 Photos: Full-Width Duo (Identical gap with Recommendations) */
    .v5-ugc-grid-{{ sid }}.is-count-2 {
      display: grid !important;
      grid-template-columns: repeat(2, 1fr) !important;
      width: 100% !important;
      max-width: 100% !important;
      margin: 0 !important;
      gap: 2px !important;
      overflow-x: visible !important;
      padding: 0 !important;
    }
    /* 3 Photos: Full-Width Trio (Identical gap with Recommendations) */
    .v5-ugc-grid-{{ sid }}.is-count-3 {
      display: grid !important;
      grid-template-columns: repeat(3, 1fr) !important;
      width: 100% !important;
      max-width: 100% !important;
      margin: 0 !important;
      gap: 2px !important;
      overflow-x: visible !important;
      padding: 0 !important;
    }
    /* 4+ Photos: Edge-to-Edge Fluid Carousel */
    .v5-ugc-grid-{{ sid }}.is-count-multi {
      display: grid !important;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)) !important;
      width: 100% !important;
      max-width: 100% !important;
      margin: 0 !important;
      gap: 2px !important;
      overflow-x: visible !important;
      padding: 0 !important;
    }

    .v5-ugc-card-{{ sid }} {
      flex: none;
      width: auto;
      scroll-snap-align: none;
    }
    .v5-ugc-card-{{ sid }}:hover img {
      transform: scale(1.04);
      filter: brightness(0.88);
    }
    .v5-ugc-card-{{ sid }}:hover .v5-ugc-hover-{{ sid }} {
      opacity: 1;
    }
    .v5-ugc-card-{{ sid }}:hover .v5-ugc-hover-{{ sid }} .v5-ugc-handle,
    .v5-ugc-card-{{ sid }}:hover .v5-ugc-hover-{{ sid }} .v5-ugc-shop {
      transform: translateY(0);
    }
  }

  /* === FLOATING SLIDER ARROWS === */
  .v5-ugc-nav-{{ sid }} {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: rgba(248, 248, 240, 0.92);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border: 1px solid rgba(57, 35, 25, 0.18);
    box-shadow: 0 6px 20px rgba(30, 18, 10, 0.16);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 20;
    color: #392319;
    transition: background 0.25s ease, color 0.25s ease, transform 0.25s cubic-bezier(0.25, 1, 0.5, 1), opacity 0.25s ease, box-shadow 0.25s ease;
    padding: 0;
  }
  .v5-ugc-nav-{{ sid }}:hover {
    background: #392319;
    color: #f8f8f0;
    border-color: #392319;
    transform: translateY(-50%) scale(1.08);
    box-shadow: 0 10px 28px rgba(30, 18, 10, 0.26);
  }
  .v5-ugc-nav-{{ sid }}.prev { left: clamp(14px, 2.5vw, 36px); }
  .v5-ugc-nav-{{ sid }}.next { right: clamp(14px, 2.5vw, 36px); }
  .v5-ugc-nav-{{ sid }} svg { width: 18px; height: 18px; stroke-width: 1.8; }

  .v5-ugc-nav-{{ sid }}.is-hidden {
    opacity: 0 !important;
    pointer-events: none !important;
    visibility: hidden;
  }

  /* === SHOPPABLE MODAL STYLES (Image 4) === */
  .v5-ugc-modal-overlay-{{ sid }} {
    position: fixed;
    top: 0; left: 0; right: 0; bottom: 0;
    background: rgba(0, 0, 0, 0.72);
    z-index: 99999;
    display: none;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.3s ease;
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    padding: 16px;
  }
  .v5-ugc-modal-overlay-{{ sid }}.active {
    display: flex;
    opacity: 1;
  }
  .v5-ugc-modal-box-{{ sid }} {
    background: var(--paper, #f8f8f0);
    width: 100%;
    max-width: 920px;
    height: 80vh;
    max-height: 640px;
    display: flex;
    flex-direction: row;
    position: relative;
    transform: translateY(20px);
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    box-shadow: 0 24px 60px rgba(0,0,0,0.25);
    overflow: hidden;
  }
  .v5-ugc-modal-overlay-{{ sid }}.active .v5-ugc-modal-box-{{ sid }} {
    transform: translateY(0);
  }
  @media (max-width: 767px) {
    .v5-ugc-modal-box-{{ sid }} {
      flex-direction: column;
      height: 90vh;
      max-height: none;
    }
  }
  .v5-ugc-modal-left-{{ sid }} {
    flex: 1;
    position: relative;
    background: #000;
    min-height: 0;
  }
  .v5-ugc-modal-left-{{ sid }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .v5-ugc-modal-nav-{{ sid }} {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: rgba(248, 248, 240, 0.9);
    border: none;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    color: #392319;
    transition: all 0.2s;
    z-index: 10;
  }
  .v5-ugc-modal-nav-{{ sid }}.prev { left: 14px; }
  .v5-ugc-modal-nav-{{ sid }}.next { right: 14px; }
  .v5-ugc-modal-nav-{{ sid }} svg { width: 16px; height: 16px; stroke-width: 2; }
  .v5-ugc-modal-nav-{{ sid }}:hover {
    background: #392319;
    color: #fff;
  }

  .v5-ugc-modal-right-{{ sid }} {
    flex: 1;
    padding: clamp(24px, 4vw, 44px);
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    background: var(--paper, #f8f8f0);
  }
  .v5-ugc-modal-close-{{ sid }} {
    position: absolute;
    top: 16px;
    right: 16px;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: rgba(248, 248, 240, 0.85);
    border: 1px solid rgba(57, 35, 25, 0.15);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 30;
    color: var(--cocoa, #392319);
    transition: background 0.2s;
  }
  .v5-ugc-modal-close-{{ sid }}:hover {
    background: var(--cocoa, #392319);
    color: #f8f8f0;
  }
  .v5-ugc-modal-close-{{ sid }} svg { width: 16px; height: 16px; stroke-width: 1.5; }

  .v5-ugc-modal-right-{{ sid }} h4 {
    font-family: var(--display, "Bodoni Moda", Georgia, serif);
    font-size: 24px;
    font-weight: 400;
    font-style: italic;
    color: var(--cocoa, #392319);
    margin: 0 0 28px 0;
  }

  .v5-ugc-prod-item-{{ sid }} {
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin-bottom: 24px;
    padding-bottom: 20px;
    border-bottom: 1px solid rgba(57, 35, 25, 0.1);
  }
  .v5-ugc-prod-item-{{ sid }}:last-child {
    border-bottom: none;
    margin-bottom: 0;
    padding-bottom: 0;
  }
  .v5-ugc-prod-info-{{ sid }} {
    display: flex;
    gap: 14px;
    align-items: center;
    text-decoration: none;
  }
  .v5-ugc-prod-thumb-{{ sid }} {
    width: 60px;
    height: 60px;
    object-fit: cover;
    background: #eaeaea;
    flex-shrink: 0;
  }
  .v5-ugc-prod-details-{{ sid }} {
    display: flex;
    flex-direction: column;
    gap: 3px;
    overflow: hidden;
  }
  .v5-ugc-prod-title-{{ sid }} {
    font-family: var(--body, "Inter", sans-serif);
    font-size: 13px;
    font-weight: 500;
    color: var(--cocoa, #392319);
    margin: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .v5-ugc-prod-price-{{ sid }} {
    font-family: var(--body, "Inter", sans-serif);
    font-size: 12.5px;
    color: #7a6258;
  }

  .v5-ugc-form-{{ sid }} {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .v5-ugc-select-{{ sid }} {
    width: 100%;
    height: 42px;
    padding: 0 14px;
    font-family: var(--body, "Inter", sans-serif);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--cocoa, #392319);
    background: transparent;
    border: 1px solid rgba(57, 35, 25, 0.25);
    border-radius: 0;
    appearance: none;
    -webkit-appearance: none;
    background-image: url("data:image/svg+xml;charset=UTF-8,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%23392319' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round'%3e%3cpolyline points='6 9 12 15 18 9'%3e%3c/polyline%3e%3c/svg%3e");
    background-repeat: no-repeat;
    background-position: right 12px center;
    background-size: 15px;
    cursor: pointer;
  }
  .v5-ugc-select-{{ sid }}:focus {
    outline: none;
    border-color: var(--cocoa, #392319);
  }
  .v5-ugc-btn-{{ sid }} {
    width: 100%;
    height: 46px;
    background: var(--cocoa, #392319);
    color: #ffffff;
    font-family: var(--body, "Inter", sans-serif);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    border: none;
    cursor: pointer;
    transition: background 0.2s ease;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .v5-ugc-btn-{{ sid }}:hover {
    background: #251610;
  }
  .v5-ugc-btn-{{ sid }}:disabled {
    background: #ccc;
    cursor: not-allowed;
  }
</style>

<section class="v5-ugc-section-{{ sid }}" id="v5-ugc-section-{{ sid }}" {% unless has_ugc %}style="display:none;"{% endunless %}>
  
  {%- if ugc_count == 1 -%}
    {%- comment -%} ==========================================
        LAYOUT 1: SINGLE PHOTO SPOTLIGHT (Opsi 3)
        ========================================== {%- endcomment -%}
    <div class="v5-ugc-spotlight-wrap-{{ sid }}">
      {%- for look in ugc_looks limit: 1 -%}
        {%- assign look_handle = look.instagram_handle | default: '@lisandramuse' -%}
        <div class="v5-ugc-spotlight-card-{{ sid }}">
          
          <!-- Left: Image with Hover Reveal -->
          <div class="v5-ugc-spotlight-media-{{ sid }}" onclick="openV5UgcModal_{{ sid | replace: '-', '_' }}(0)">
            {%- if look.image != blank -%}
              <img src="{{ look.image | image_url: width: 900 }}" alt="As styled by {{ look_handle }}" loading="lazy" />
            {%- endif -%}
            <div class="v5-ugc-hover-{{ sid }}">
              <span class="v5-ugc-handle">{{ look_handle }}</span>
              <span class="v5-ugc-shop">Shop the Look</span>
            </div>
          </div>

          <!-- Right: Editorial Card -->
          <div class="v5-ugc-spotlight-info-{{ sid }}">
            <span class="v5-ugc-spotlight-tag-{{ sid }}">{{ kicker }}</span>
            <h3 class="v5-ugc-spotlight-title-{{ sid }}">{{ heading }}</h3>
            <p class="v5-ugc-spotlight-quote-{{ sid }}">
              "Effortless styling by our muse {{ look_handle }}. Handcrafted with intention to move seamlessly from sun-warmed afternoons into the night."
            </p>

            <div class="v5-ugc-spotlight-featured-{{ sid }}">
              {%- if product.featured_image -%}
                <img src="{{ product.featured_image | image_url: width: 120 }}" alt="{{ product.title }}" class="v5-ugc-spotlight-thumb-{{ sid }}" />
              {%- endif -%}
              <div style="overflow: hidden;">
                <h5 class="v5-ugc-spotlight-pname-{{ sid }}">{{ product.title }}</h5>
                <span class="v5-ugc-spotlight-pprice-{{ sid }}">{{ product.price | money_without_trailing_zeros }}</span>
              </div>
            </div>

            <button type="button" class="v5-ugc-spotlight-btn-{{ sid }}" onclick="openV5UgcModal_{{ sid | replace: '-', '_' }}(0)">
              SHOP THIS LOOK
            </button>
          </div>

        </div>
      {%- endfor -%}
    </div>

  {%- else -%}
    {%- comment -%} ==========================================
        LAYOUT 2, 3, 4+: ADAPTIVE CENTERED / CAROUSEL GRID
        ========================================== {%- endcomment -%}
    <div class="v5-ugc-head-{{ sid }}">
      <span class="v5-ugc-kicker-{{ sid }}">{{ kicker }}</span>
      <h3>{{ heading }}</h3>
    </div>

    <div class="v5-ugc-wrap-{{ sid }}">
      <button class="v5-ugc-nav-{{ sid }} prev" id="v5-ugc-prev-{{ sid }}" onclick="v5ScrollUgc_{{ sid | replace: '-', '_' }}(-1)" aria-label="Previous looks">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
      </button>

      {%- liquid
        assign grid_class = 'is-count-multi'
        if ugc_count == 2
          assign grid_class = 'is-count-2'
        elsif ugc_count == 3
          assign grid_class = 'is-count-3'
        endif
      -%}

      <div class="v5-ugc-grid-{{ sid }} {{ grid_class }}" id="v5-ugc-grid-{{ sid }}">
        {%- if has_ugc -%}
          {%- for look in ugc_looks -%}
            {%- assign item_handle = look.instagram_handle | default: '@lisandramuse' -%}
            <div class="v5-ugc-card-{{ sid }}" onclick="openV5UgcModal_{{ sid | replace: '-', '_' }}({{ forloop.index0 }})">
              {%- if look.image != blank -%}
                <img src="{{ look.image | image_url: width: 800 }}" alt="Look {{ forloop.index }}" loading="lazy" />
              {%- endif -%}
              <div class="v5-ugc-hover-{{ sid }}">
                <span class="v5-ugc-handle">{{ item_handle }}</span>
                <span class="v5-ugc-shop">Shop the Look</span>
              </div>
            </div>
          {%- endfor -%}
        {%- endif -%}
      </div>

      <button class="v5-ugc-nav-{{ sid }} next" id="v5-ugc-next-{{ sid }}" onclick="v5ScrollUgc_{{ sid | replace: '-', '_' }}(1)" aria-label="Next looks">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </button>
    </div>
  {%- endif -%}

</section>

<!-- MODAL MARKUP -->
<div class="v5-ugc-modal-overlay-{{ sid }}" id="v5-modal-overlay-{{ sid }}" onclick="closeV5UgcModal_{{ sid | replace: '-', '_' }}(event)">
  <div class="v5-ugc-modal-box-{{ sid }}" onclick="event.stopPropagation()">
    
    <button class="v5-ugc-modal-close-{{ sid }}" onclick="closeV5UgcModal_{{ sid | replace: '-', '_' }}(null)" aria-label="Close">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
    </button>

    <!-- LEFT: Image Slider inside modal -->
    <div class="v5-ugc-modal-left-{{ sid }}">
      {%- if ugc_count > 1 -%}
      <button class="v5-ugc-modal-nav-{{ sid }} prev" onclick="changeV5UgcSlide_{{ sid | replace: '-', '_' }}(-1)">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
      </button>
      {%- endif -%}
      
      <img id="v5-modal-img-{{ sid }}" src="" alt="Featured Look" />

      {%- if ugc_count > 1 -%}
      <button class="v5-ugc-modal-nav-{{ sid }} next" onclick="changeV5UgcSlide_{{ sid | replace: '-', '_' }}(1)">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
      </button>
      {%- endif -%}
    </div>

    <!-- RIGHT: Dynamic Products Panel -->
    <div class="v5-ugc-modal-right-{{ sid }}">
      <h4>Featured in this look</h4>
      <div id="v5-modal-products-{{ sid }}">
        <!-- Injected dynamically -->
      </div>
    </div>

  </div>
</div>

{%- if has_ugc -%}
<!-- DATA STORE FOR MODAL -->
<script type="application/json" id="v5-ugc-data-{{ sid }}">
  [
    {%- for look in ugc_looks -%}
      {
        "image": "{{ look.image | image_url: width: 1200 }}",
        "products": [
          {%- if look.tagged_products != blank -%}
            {%- for prod in look.tagged_products.value -%}
              {
                "id": {{ prod.id | json }},
                "title": {{ prod.title | json }},
                "price": "{{ prod.price | money_without_trailing_zeros }}",
                "url": "{{ prod.url }}",
                "image": "{{ prod.featured_media | image_url: width: 150 }}",
                "variants": [
                  {%- for variant in prod.variants -%}
                    {
                      "id": {{ variant.id | json }},
                      "title": {{ variant.title | json }},
                      "available": {{ variant.available | json }}
                    }{%- unless forloop.last -%},{%- endunless -%}
                  {%- endfor -%}
                ]
              }{%- unless forloop.last -%},{%- endunless -%}
            {%- endfor -%}
          {%- elsif look.tagged_product != blank -%}
            {%- assign prod = look.tagged_product.value -%}
            {
              "id": {{ prod.id | json }},
              "title": {{ prod.title | json }},
              "price": "{{ prod.price | money_without_trailing_zeros }}",
              "url": "{{ prod.url }}",
              "image": "{{ prod.featured_media | image_url: width: 150 }}",
              "variants": [
                {%- for variant in prod.variants -%}
                  {
                    "id": {{ variant.id | json }},
                    "title": {{ variant.title | json }},
                    "available": {{ variant.available | json }}
                  }{%- unless forloop.last -%},{%- endunless -%}
                {%- endfor -%}
              ]
            }
          {%- else -%}
            {
              "id": {{ product.id | json }},
              "title": {{ product.title | json }},
              "price": "{{ product.price | money_without_trailing_zeros }}",
              "url": "{{ product.url }}",
              "image": "{{ product.featured_media | image_url: width: 150 }}",
              "variants": [
                {%- for variant in product.variants -%}
                  {
                    "id": {{ variant.id | json }},
                    "title": {{ variant.title | json }},
                    "available": {{ variant.available | json }}
                  }{%- unless forloop.last -%},{%- endunless -%}
                {%- endfor -%}
              ]
            }
          {%- endif -%}
        ]
      }{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  ]
</script>

<script>
  let v5UgcCurrentIndex_{{ sid | replace: '-', '_' }} = 0;
  let v5UgcData_{{ sid | replace: '-', '_' }} = [];

  document.addEventListener('DOMContentLoaded', function() {
    const dataEl = document.getElementById('v5-ugc-data-{{ sid }}');
    if(dataEl) {
      try {
        v5UgcData_{{ sid | replace: '-', '_' }} = JSON.parse(dataEl.textContent);
      } catch(e) { console.error("Error parsing UGC data", e); }
    }

    // Initialize Smart Arrows
    const grid = document.getElementById("v5-ugc-grid-{{ sid }}");
    if(grid) {
      updateV5UgcArrows_{{ sid | replace: '-', '_' }}();
      grid.addEventListener('scroll', updateV5UgcArrows_{{ sid | replace: '-', '_' }});
      window.addEventListener('resize', updateV5UgcArrows_{{ sid | replace: '-', '_' }});
    }
  });

  // SMART ARROW VISIBILITY
  function updateV5UgcArrows_{{ sid | replace: '-', '_' }}() {
    const grid = document.getElementById("v5-ugc-grid-{{ sid }}");
    const prevBtn = document.getElementById("v5-ugc-prev-{{ sid }}");
    const nextBtn = document.getElementById("v5-ugc-next-{{ sid }}");
    if(!grid || !prevBtn || !nextBtn) return;

    const maxScrollLeft = grid.scrollWidth - grid.clientWidth;

    // If content fits completely inside container (no scroll possible)
    if (maxScrollLeft <= 4) {
      prevBtn.classList.add('is-hidden');
      nextBtn.classList.add('is-hidden');
      return;
    }

    // Left arrow visibility
    if (grid.scrollLeft <= 4) {
      prevBtn.classList.add('is-hidden');
    } else {
      prevBtn.classList.remove('is-hidden');
    }

    // Right arrow visibility
    if (grid.scrollLeft >= maxScrollLeft - 4) {
      nextBtn.classList.add('is-hidden');
    } else {
      nextBtn.classList.remove('is-hidden');
    }
  }

  function v5ScrollUgc_{{ sid | replace: '-', '_' }}(direction) {
    const grid = document.getElementById("v5-ugc-grid-{{ sid }}");
    if (!grid) return;
    const card = grid.querySelector(".v5-ugc-card-{{ sid }}");
    const scrollAmount = card ? (card.offsetWidth + 2) : 320;
    grid.scrollBy({
      left: scrollAmount * direction,
      behavior: "smooth"
    });
  }

  window.openV5UgcModal_{{ sid | replace: '-', '_' }} = function(index) {
    v5UgcCurrentIndex_{{ sid | replace: '-', '_' }} = index;
    renderV5UgcModalContent_{{ sid | replace: '-', '_' }}();
    
    const overlay = document.getElementById('v5-modal-overlay-{{ sid }}');
    if(overlay) {
      overlay.classList.add('active');
      document.body.style.overflow = 'hidden';
    }
  };

  window.closeV5UgcModal_{{ sid | replace: '-', '_' }} = function(e) {
    if(e && e.target !== e.currentTarget) return;
    const overlay = document.getElementById('v5-modal-overlay-{{ sid }}');
    if(overlay) {
      overlay.classList.remove('active');
      document.body.style.overflow = '';
    }
  };

  window.changeV5UgcSlide_{{ sid | replace: '-', '_' }} = function(direction) {
    const data = v5UgcData_{{ sid | replace: '-', '_' }};
    if(!data || !data.length) return;

    let newIndex = v5UgcCurrentIndex_{{ sid | replace: '-', '_' }} + direction;
    if (newIndex < 0) newIndex = data.length - 1;
    if (newIndex >= data.length) newIndex = 0;
    
    v5UgcCurrentIndex_{{ sid | replace: '-', '_' }} = newIndex;
    renderV5UgcModalContent_{{ sid | replace: '-', '_' }}();
  };

  function renderV5UgcModalContent_{{ sid | replace: '-', '_' }}() {
    const data = v5UgcData_{{ sid | replace: '-', '_' }};
    const index = v5UgcCurrentIndex_{{ sid | replace: '-', '_' }};
    const look = data[index];
    if(!look) return;

    const imgEl = document.getElementById('v5-modal-img-{{ sid }}');
    if(imgEl) imgEl.src = look.image;

    const productsContainer = document.getElementById('v5-modal-products-{{ sid }}');
    if(!productsContainer) return;
    let html = '';

    look.products.forEach(prod => {
      let optionsHtml = '<option value="" disabled selected>SELECT SIZE</option>';
      prod.variants.forEach(v => {
        optionsHtml += `<option value="${v.id}" ${!v.available ? 'disabled' : ''}>${v.title} ${!v.available ? '- Sold Out' : ''}</option>`;
      });

      html += `
        <div class="v5-ugc-prod-item-{{ sid }}">
          <a href="${prod.url}" class="v5-ugc-prod-info-{{ sid }}">
            <img src="${prod.image}" class="v5-ugc-prod-thumb-{{ sid }}" alt="${prod.title}" />
            <div class="v5-ugc-prod-details-{{ sid }}">
              <h5 class="v5-ugc-prod-title-{{ sid }}">${prod.title}</h5>
              <span class="v5-ugc-prod-price-{{ sid }}">${prod.price}</span>
            </div>
          </a>
          
          <form method="post" action="/cart/add" class="v5-ugc-form-{{ sid }}" onsubmit="return handleV5UgcSubmit_{{ sid | replace: '-', '_' }}(event, this)">
            <select name="id" class="v5-ugc-select-{{ sid }}" required>
              ${optionsHtml}
            </select>
            <button type="submit" class="v5-ugc-btn-{{ sid }}">ADD TO BAG</button>
          </form>
        </div>
      `;
    });

    if(look.products.length === 0) {
      html = '<p style="font-family: var(--body, sans-serif); font-size: 12px; color: #7a6258;">Product details currently unavailable.</p>';
    }

    productsContainer.innerHTML = html;
  }

  window.handleV5UgcSubmit_{{ sid | replace: '-', '_' }} = function(event, form) {
    event.preventDefault();
    const btn = form.querySelector('button[type="submit"]');
    const originalText = btn.textContent;
    btn.textContent = 'ADDING...';
    btn.disabled = true;

    const formData = new FormData(form);
    
    fetch('/cart/add.js', {
      method: 'POST',
      body: formData
    })
    .then(response => response.json())
    .then(data => {
      // Klaviyo Add to Cart Tracking
      var _learnq = window._learnq || [];
      if (data && data.items && data.items.length > 0) {
        var item = data.items[0];
        _learnq.push(['track', 'Added to Cart', {
          'ProductName': item.title,
          'ProductID': item.product_id,
          'URL': window.location.origin + item.url,
          'ImageURL': item.image,
          'Price': (item.price / 100).toFixed(2)
        }]);
      } else if (data && data.id) {
        _learnq.push(['track', 'Added to Cart', {
          'ProductName': data.title,
          'ProductID': data.product_id,
          'URL': window.location.origin + data.url,
          'ImageURL': data.image,
          'Price': (data.price / 100).toFixed(2)
        }]);
      }

      btn.textContent = 'ADDED!';
      setTimeout(() => {
        btn.textContent = originalText;
        btn.disabled = false;
        window.dispatchEvent(new Event('cart:refresh'));
      }, 1800);
    })
    .catch(error => {
      console.error('Error:', error);
      btn.textContent = 'ERROR';
      btn.disabled = false;
    });
    
    return false;
  };
</script>
{%- endif -%}

