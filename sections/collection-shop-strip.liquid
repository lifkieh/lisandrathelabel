<style>
  .shop-strip-{{ section.id }} {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: clamp(8px, 1.2vw, 16px);
    padding: clamp(24px, 4vw, 44px) clamp(14px, 2vw, 26px);
    background: var(--paper, #f8f8f0);
  }
  
  @media (max-width: 900px) {
    .shop-strip-{{ section.id }} {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 600px) {
    .shop-strip-{{ section.id }} {
      grid-template-columns: repeat(2, 1fr);
      gap: 8px;
      padding: 24px 14px;
    }
  }

  /* Kartu Produk untuk Shop Strip (Sesuai dengan styling kartu V5 terbaru) */
  .shop-strip-{{ section.id }} .card {
    padding-bottom: 16px;
    display: flex;
    flex-direction: column;
  }
  .shop-strip-{{ section.id }} .card figure {
    position: relative;
    margin: 0 0 12px;
    aspect-ratio: 3/4;
    background: var(--sand, #e0d9b5);
    overflow: hidden;
  }
  .shop-strip-{{ section.id }} .card figure img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: opacity 0.35s ease;
  }
  .shop-strip-{{ section.id }} .card figure img.hover-img {
    opacity: 0;
  }
  .shop-strip-{{ section.id }} .card:hover figure img.hover-img {
    opacity: 1;
  }
  .shop-strip-{{ section.id }} .card-info {
    display: flex;
    flex-direction: column;
    padding: 0 4px;
  }
  .shop-strip-{{ section.id }} .card h4 {
    margin: 0 0 3px 0;
    font-family: var(--body, sans-serif);
    font-size: 13px;
    font-weight: 500;
    line-height: 1.3;
    color: var(--cocoa, #392319);
  }
  .shop-strip-{{ section.id }} .price {
    margin: 0;
    font-family: var(--body, sans-serif);
    font-size: 12px;
    font-weight: 400;
    color: rgba(57, 35, 25, 0.65); /* Muted price */
    font-variant-numeric: tabular-nums;
  }
  
  /* Quick Add Button overlay */
  .shop-strip-{{ section.id }} .quick-add-btn {
    position: absolute;
    bottom: 12px;
    left: 12px;
    right: 12px;
    background: rgba(248, 248, 240, 0.95);
    color: var(--cocoa, #392319);
    border: 1px solid rgba(57, 35, 25, 0.1);
    padding: 10px;
    text-align: center;
    font-family: var(--body, sans-serif);
    font-size: 10.5px;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    opacity: 0;
    transform: translateY(10px);
    transition: opacity 0.3s ease, transform 0.3s ease, background-color 0.2s;
    cursor: pointer;
    z-index: 10;
  }
  .shop-strip-{{ section.id }} .card:hover .quick-add-btn {
    opacity: 1;
    transform: translateY(0);
  }
  .shop-strip-{{ section.id }} .quick-add-btn:hover {
    background: var(--cocoa, #392319);
    color: #fff;
  }

  /* Scroll Reveal CSS */
  .reveal {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1), transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .reveal.active {
    opacity: 1;
    transform: translateY(0);
  }

  /* View All Link */
  .shop-strip-view-all-{{ section.id }} {
    text-align: center;
    padding: 0 20px clamp(40px, 6vw, 60px);
    background: var(--paper, #f8f8f0);
  }
  .view-all-link-{{ section.id }} {
    display: inline-flex;
    align-items: center;
    font-family: var(--ui, "Inter", sans-serif);
    font-size: 12px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--cocoa, #392319);
    text-decoration: none;
    border-bottom: 1px solid rgba(57, 35, 25, 0.2);
    padding-bottom: 4px;
    transition: border-color 0.3s ease;
  }
  .view-all-link-{{ section.id }}:hover {
    border-color: var(--cocoa, #392319);
  }
  .view-all-link-{{ section.id }} .arrow {
    margin-left: 8px;
    font-size: 14px;
    line-height: 1;
    transition: transform 0.3s ease;
  }
  .view-all-link-{{ section.id }}:hover .arrow {
    transform: translateX(4px);
  }

  @media (max-width: 768px) {
    .shop-strip-{{ section.id }} .quick-add-btn {
      display: none; /* Hide on mobile for simpler UI or replace with tap logic */
    }
  }
</style>

<div class="shop-strip-{{ section.id }} reveal">
  {%- for block in section.blocks -%}
    {%- assign product = block.settings.product -%}
    <article class="card" {{ block.shopify_attributes }}>
      <a href="{{ product.url | default: '#' }}" class="card-link" style="text-decoration: none; color: inherit;">
        <figure>
          {%- if product != blank and product.featured_media -%}
            <img 
              src="{{ product.featured_media | img_url: '600x' }}" 
              alt="{{ product.featured_media.alt | escape }}" 
              class="main-img"
              loading="lazy"
            />
            {%- if product.media[1] != blank -%}
              <img 
                src="{{ product.media[1] | img_url: '600x' }}" 
                alt="{{ product.media[1].alt | escape }}" 
                class="hover-img"
                loading="lazy"
              />
            {%- endif -%}
          {%- else -%}
            <img src="https://cdn.shopify.com/s/images/themes/product-{{ forloop.index | modulo: 6 | plus: 1 }}.png" alt="Placeholder" class="main-img" loading="lazy" />
          {%- endif -%}
          
          {%- if product != blank -%}
            {%- capture variants_json -%}
              [
                {%- for variant in product.variants -%}
                  {
                    "id": {{ variant.id }},
                    "title": {{ variant.title | json }},
                    "price": {{ variant.price | money_without_trailing_zeros | json }},
                    "available": {{ variant.available | json }}
                  }{%- unless forloop.last -%},{%- endunless -%}
                {%- endfor -%}
              ]
            {%- endcapture -%}
            <button type="button" class="quick-add-btn" 
              aria-haspopup="dialog"
              data-title="{{ product.title | escape }}"
              data-url="{{ product.url }}"
              data-img="{{ product.featured_media | img_url: '400x' }}"
              data-price="{{ product.price | money_without_trailing_zeros }}"
              data-variants='{{ variants_json | strip_newlines }}'
              onclick="event.preventDefault(); event.stopPropagation(); openQuickAddModal(this, '{{ section.id }}');"
            >
              Quick Add
            </button>
          {%- endif -%}
        </figure>
        
        <div class="card-info">
          <h4>{{ product.title | default: 'Campaign Featured Piece' }}</h4>
          <p class="price">
            {%- if product != blank -%}
              {{ product.price | money }}
            {%- else -%}
              Rp 1.499.000
            {%- endif -%}
          </p>
        </div>
      </a>
    </article>
  {%- endfor -%}
</div>

{%- if section.settings.view_all_label != blank and section.settings.view_all_link != blank -%}
  <div class="shop-strip-view-all-{{ section.id }} reveal">
    <a href="{{ section.settings.view_all_link }}" class="view-all-link-{{ section.id }}">
      {{ section.settings.view_all_label }} <span class="arrow">&rarr;</span>
    </a>
  </div>
{%- endif -%}

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const observer = new IntersectionObserver((entries, obs) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add("active");
          obs.unobserve(entry.target);
        }
      });
    }, { threshold: 0.15, rootMargin: "0px 0px -20px 0px" });

    document.querySelectorAll('.reveal').forEach(el => observer.observe(el));
  });
</script>

{% schema %}
{
  "name": "Collection Shop Strip",
  "settings": [
    {
      "type": "text",
      "id": "view_all_label",
      "label": "View All Label",
      "default": "Explore Chapter I"
    },
    {
      "type": "url",
      "id": "view_all_link",
      "label": "View All Link"
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "limit": 8,
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Select Product"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collection Shop Strip",
      "blocks": [
        {
          "type": "product"
        },
        {
          "type": "product"
        },
        {
          "type": "product"
        },
        {
          "type": "product"
        }
      ]
    }
  ]
}
{% endschema %}

{% render 'quick-add-modal-v5', section_id: section.id %}
