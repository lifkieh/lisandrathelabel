<script>
(function(){
  var productData = {{ product | json }};
  var variants = productData.variants;
  var options = productData.options;
  var selectedOptions = {};
  var lowStockThreshold = {{ section.settings.low_stock_threshold | default: 10 }};

  var variantInventoryMap = {
    {%- for variant in product.variants -%}
      "{{ variant.id }}": {
        "inventory_management": {{ variant.inventory_management | json }},
        "inventory_quantity": {{ variant.inventory_quantity | default: 0 | json }},
        "available": {{ variant.available | json }}
      }{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  };

  {%- for option in product.options_with_values -%}
    selectedOptions['{{ option.name }}'] = '{{ option.selected_value | escape }}';
  {%- endfor -%}

  var variantInput = document.getElementById('pdpVariantIdV5');
  var priceEl = document.getElementById('pdpPriceV5');
  var stockEl = document.getElementById('pdpStockV5');
  var atcBtn = document.getElementById('pdpAtcBtnV5');

  // Swatches
  document.querySelectorAll('.pdp-v5-sw-row .pdp-v5-sw').forEach(function(btn){
    btn.addEventListener('click', function(){
      var idx = parseInt(this.closest('[data-option-index]').dataset.optionIndex);
      var optName = options[idx];
      selectedOptions[optName] = this.dataset.value;

      this.closest('.pdp-v5-sw-row').querySelectorAll('.pdp-v5-sw').forEach(function(b){ b.classList.remove('active'); });
      this.classList.add('active');

      var label = document.getElementById('pdpColorLabel');
      if (label) label.textContent = this.dataset.value;

      updateVariant();
    });
  });

  // Sizes
  document.querySelectorAll('.pdp-v5-sizes .pdp-v5-size').forEach(function(btn){
    btn.addEventListener('click', function(){
      if (this.classList.contains('disabled')) return;
      var idx = parseInt(this.closest('[data-option-index]').dataset.optionIndex);
      var optName = options[idx];
      selectedOptions[optName] = this.dataset.value;

      this.closest('.pdp-v5-sizes').querySelectorAll('.pdp-v5-size').forEach(function(b){ b.classList.remove('active'); });
      this.classList.add('active');

      updateVariant();
    });
  });

  function updateVariant() {
    var match = variants.find(function(v){
      return options.every(function(optName, i){
        return v.options[i] === selectedOptions[optName];
      });
    });

    if (!match) return;
    if (variantInput) variantInput.value = match.id;

    var url = new URL(window.location);
    url.searchParams.set('variant', match.id);
    window.history.replaceState({}, '', url);

    var activeCurrency = (window.Shopify && window.Shopify.currency && window.Shopify.currency.active) || 'IDR';
    var formatter = new Intl.NumberFormat(undefined, { style: 'currency', currency: activeCurrency, minimumFractionDigits: 0 });
    if (priceEl) {
      if (match.compare_at_price && match.compare_at_price > match.price) {
        priceEl.innerHTML = '<s>' + formatter.format(match.compare_at_price / 100) + '</s> <span class="sale-price">' + formatter.format(match.price / 100) + '</span>';
      } else {
        priceEl.textContent = formatter.format(match.price / 100);
      }
    }

    if (stockEl) {
      var inv = variantInventoryMap[match.id];
      if (inv && inv.inventory_management === 'shopify' && inv.inventory_quantity > 0 && inv.inventory_quantity <= lowStockThreshold) {
        var unitWord = inv.inventory_quantity === 1 ? 'piece' : 'pieces';
        stockEl.textContent = 'Only ' + inv.inventory_quantity + ' ' + unitWord + ' left';
      } else {
        stockEl.textContent = '';
      }
    }

    if (atcBtn) {
      if (match.available) {
        atcBtn.disabled = false;
        atcBtn.textContent = 'Add to cart';
      } else {
        atcBtn.disabled = true;
        atcBtn.textContent = 'Sold out';
      }
    }
  }

  // Mobile Carousel
  var track = document.getElementById('pdpMobileTrack');
  var dots = document.querySelectorAll('#pdpMobileDots .pdp-v5-mobile-dot');
  var currentSlide = 0;
  var totalSlides = dots.length;

  function setSlide(i) {
    currentSlide = i;
    if (track) track.style.transform = 'translateX(-' + (i * 100) + '%)';
    dots.forEach(function(d, idx){ d.classList.toggle('active', idx === i); });
  }

  dots.forEach(function(dot){
    dot.addEventListener('click', function(){ setSlide(parseInt(this.dataset.idx)); });
  });

  var touchStartX = 0;
  var mobileGal = document.getElementById('pdpMobileGal');
  if (mobileGal) {
    mobileGal.addEventListener('touchstart', function(e){ touchStartX = e.touches[0].clientX; }, {passive: true});
    mobileGal.addEventListener('touchend', function(e){
      var diff = touchStartX - e.changedTouches[0].clientX;
      if (Math.abs(diff) > 40) {
        if (diff > 0 && currentSlide < totalSlides - 1) setSlide(currentSlide + 1);
        else if (diff < 0 && currentSlide > 0) setSlide(currentSlide - 1);
      }
    }, {passive: true});
  }

  // AJAX ATC
  var form = document.getElementById('pdpFormV5');
  if (form) {
    form.addEventListener('submit', function(e){
      e.preventDefault();
      
      // 1. Loading state with spinner
      atcBtn.classList.add('is-loading');
      atcBtn.classList.remove('is-added');
      atcBtn.disabled = true;

      fetch('/cart/add.js', {
        method: 'POST',
        body: new FormData(form)
      })
      .then(function(r){ return r.json(); })
      .then(function(data){
        // 2. Success state on Button
        atcBtn.classList.remove('is-loading');
        atcBtn.classList.add('is-added');
        atcBtn.innerHTML = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="margin-right:6px;"><polyline points="20 6 9 17 4 12"></polyline></svg> Added to Bag';

        // 3. Trigger Cart Pop Animation on Header
        var cartIconLinks = document.querySelectorAll('.hdr-actions-v5 a[aria-label="Cart"]');
        cartIconLinks.forEach(function(iconLink){
          iconLink.classList.remove('cart-icon-pop');
          void iconLink.offsetWidth; // trigger reflow
          iconLink.classList.add('cart-icon-pop');
        });

        // 4. Update Cart Badge Count
        fetch('/cart.js').then(function(r){ return r.json(); }).then(function(cart){
          document.querySelectorAll('.cart-count-v5, .hdr-actions-v5 a[aria-label="Cart"] span span').forEach(function(el){
            el.textContent = cart.item_count;
          });
        });

        // 5. Option A - Smoothly open Luxury Side Cart Drawer
        setTimeout(function(){
          if (typeof openCartDrawerV5 === 'function') {
            openCartDrawerV5();
          }
        }, 350);

        // Reset button state
        setTimeout(function(){
          atcBtn.classList.remove('is-added');
          atcBtn.innerHTML = 'Add to cart';
          atcBtn.disabled = false;
        }, 2500);
      })
      .catch(function(err){
        console.error(err);
        atcBtn.classList.remove('is-loading');
        atcBtn.classList.remove('is-added');
        atcBtn.textContent = 'Add to cart';
        atcBtn.disabled = false;
      });
    });
  }
})();

// Standalone Global Size Guide Unit Switcher (CM / INCH)
function pdpSetUnit(unit) {
  var cmBtn = document.getElementById('btn-cm-v5');
  var inBtn = document.getElementById('btn-inch-v5');
  var cmSpans = document.querySelectorAll('.unit-cm');
  var inSpans = document.querySelectorAll('.unit-inch');

  if (unit === 'cm') {
    if (cmBtn) cmBtn.classList.add('active');
    if (inBtn) inBtn.classList.remove('active');
    cmSpans.forEach(function(s){ s.style.display = 'inline'; });
    inSpans.forEach(function(s){ s.style.display = 'none'; });
  } else {
    if (inBtn) inBtn.classList.add('active');
    if (cmBtn) cmBtn.classList.remove('active');
    
    cmSpans.forEach(function(s, idx){
      var inchSpan = inSpans[idx];
      if (inchSpan) {
        if (!inchSpan.textContent.trim()) {
          var cmVal = parseFloat(s.textContent);
          if (!isNaN(cmVal)) {
            inchSpan.textContent = (cmVal / 2.54).toFixed(1);
          }
        }
        inchSpan.style.display = 'inline';
      }
      s.style.display = 'none';
    });
  }
}

// Automatically record current product to Recently Viewed in localStorage
(function(){
  try {
    var pId = {{ product.id | json }};
    var pTitle = {{ product.title | json }};
    var pUrl = {{ product.url | json }};
    var pImg = {{ featured_image | image_url: width: 400 | json }};
    var pPrice = {{ current_variant.price | money | json }};

    if (pId && pTitle) {
      var list = JSON.parse(localStorage.getItem('lisandra_recently_viewed') || '[]');
      list = list.filter(function(item){ return item.id !== pId; });
      list.unshift({
        id: pId,
        title: pTitle,
        url: pUrl,
        image: pImg,
        price: pPrice
      });
      if (list.length > 8) list = list.slice(0, 8);
      localStorage.setItem('lisandra_recently_viewed', JSON.stringify(list));
    }
  } catch(e) {}
})();
</script>

{% schema %}
{
