{%- comment -%}
  Main Collection Banner V5
  Renders the collection header with product count, title, and description.
{%- endcomment -%}

<style>
  .plp-head-{{ section.id }} {
    padding: 28px clamp(14px, 2vw, 26px) 0;
  }
  .plp-head-{{ section.id }} .plp-count {
    font-family: var(--font-body--family, 'Inter', sans-serif);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(57, 35, 25, 0.55);
    margin: 0;
  }
  .plp-head-{{ section.id }} h1 {
    font-family: 'Bodoni Moda', 'Didot', serif;
    font-weight: 500;
    font-size: clamp(20px, 2.4vw, 26px);
    margin: 6px 0 8px;
    color: #392319;
    font-style: normal;
  }
  .plp-head-{{ section.id }} .plp-desc {
    margin: 0;
    color: rgba(57, 35, 25, 0.55);
    font-size: 12.5px;
    max-width: 60ch;
    line-height: 1.5;
  }

  @media (max-width: 749px) {
    .plp-head-{{ section.id }} {
      padding: 20px 16px 0;
    }
  }
</style>

{%- if collection.handle == 'sale' -%}
<style>
  .plp-head-{{ section.id }} h1 {
    color: var(--clay, #8a5a44) !important;
    font-style: normal !important;
    font-weight: 600 !important;
    letter-spacing: 0.04em !important;
    text-transform: uppercase;
  }
  .plp-head-{{ section.id }} .plp-count {
    color: var(--clay, #8a5a44) !important;
    font-weight: 600 !important;
  }
  .plp-head-{{ section.id }} .plp-desc {
    color: var(--clay, #8a5a44) !important;
    font-style: italic;
    opacity: 0.85;
  }
</style>
{%- endif -%}

<div class="plp-head-{{ section.id }}">
  {%- if collection -%}
    {%- assign count_display = collection.products_count -%}
    {%- if collection.handle == 'sale' -%}
      {%- assign sale_actual_count = 0 -%}
      {%- for prod in collection.products -%}
        {%- if prod.compare_at_price > prod.price -%}
          {%- assign sale_actual_count = sale_actual_count | plus: 1 -%}
        {%- endif -%}
      {%- endfor -%}
      {%- assign count_display = sale_actual_count -%}
    {%- endif -%}
    {%- if section.settings.show_product_count -%}
      <span class="plp-count">{{ count_display }} {{ section.settings.count_label | default: 'pieces' }}</span>
    {%- endif -%}
    <h1>{{ collection.title }}</h1>
    {%- if collection.description != blank -%}
      <p class="plp-desc">{{ collection.description | strip_html }}</p>
    {%- elsif section.settings.default_description != blank -%}
      <p class="plp-desc">{{ section.settings.default_description }}</p>
    {%- endif -%}
  {%- else -%}
    {%- if section.settings.show_product_count -%}
      <span class="plp-count">0 {{ section.settings.count_label | default: 'pieces' }}</span>
    {%- endif -%}
    <h1>{{ section.settings.fallback_title | default: 'Shop All' }}</h1>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Collection Banner V5",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_product_count",
      "label": "Show product count label",
      "default": false
    },
    {
      "type": "text",
      "id": "count_label",
      "label": "Product count label",
      "default": "pieces"
    },
    {
      "type": "text",
      "id": "fallback_title",
      "label": "Fallback title (if no collection)",
      "default": "Shop All"
    },
    {
      "type": "textarea",
      "id": "default_description",
      "label": "Default description (if collection has none)",
      "default": "Hand-knit and crocheted in small batches by Balinese artisans."
    }
  ]
}
{% endschema %}
