{%- comment -%}
  Lisandra The Label - Compact Luxury Stockists Page (High Readability & Above-The-Fold Desktop View)
  UX Principles:
  1. Zero Desktop Scroll: 5 side-by-side editorial columns engineered to fit entirely in one desktop viewport.
  2. Clear Affordance (8 Golden Rules): Interactive map indicators (↗) so users immediately recognize clickable directions.
  3. High Readability: Crisp contrast, Bodoni Moda display headings, and clear Inter address hierarchy.
{%- endcomment -%}

{%- assign sid = section.id -%}
{%- assign page_title = section.settings.title | default: page.title | default: 'Stockists' -%}

<style>
  .stockists-page-{{ sid }} {
    background-color: var(--paper, #f8f8f0);
    color: var(--cocoa, #392319);
    padding: clamp(32px, 4vw, 48px) clamp(20px, 4vw, 56px) clamp(24px, 3.5vw, 36px);
    width: 100%;
    box-sizing: border-box;
  }

  .stockists-container-{{ sid }} {
    max-width: 1320px;
    margin: 0 auto;
  }

  /* Compact Header */
  .stockists-header-{{ sid }} {
    text-align: center;
    margin-bottom: clamp(24px, 3vw, 36px);
  }

  .stockists-title-{{ sid }} {
    font-family: var(--display, 'Bodoni Moda', Georgia, serif);
    font-size: clamp(32px, 4vw, 48px);
    font-weight: 400;
    font-style: normal;
    color: var(--cocoa, #392319);
    margin: 0 0 6px 0;
    line-height: 1.1;
    letter-spacing: -0.015em;
  }

  .stockists-hint-{{ sid }} {
    font-family: var(--body, 'Inter', sans-serif);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--clay, #8a5a44);
    margin: 0;
    display: inline-flex;
    align-items: center;
    gap: 5px;
  }

  /* 5-Column Grid on Desktop (Fits without scroll) */
  .stockists-grid-5col-{{ sid }} {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: clamp(16px, 2.2vw, 32px);
    align-items: start;
  }

  @media (max-width: 1023px) and (min-width: 641px) {
    .stockists-grid-5col-{{ sid }} {
      grid-template-columns: repeat(3, 1fr);
      gap: 28px 20px;
    }
  }

  @media (max-width: 640px) {
    .stockists-grid-5col-{{ sid }} {
      grid-template-columns: 1fr;
      gap: 28px;
    }
  }

  /* Region Group Column */
  .stockists-col-{{ sid }} {
    display: flex;
    flex-direction: column;
  }

  .stockists-region-heading-{{ sid }} {
    font-family: var(--display, 'Bodoni Moda', Georgia, serif);
    font-size: clamp(17px, 1.8vw, 20px);
    font-weight: 500;
    color: var(--cocoa, #392319);
    margin: 0 0 16px 0;
    padding-bottom: 6px;
    border-bottom: 1px solid rgba(57, 35, 25, 0.2);
    letter-spacing: -0.01em;
    display: flex;
    justify-content: space-between;
    align-items: baseline;
  }

  .stockists-boutiques-{{ sid }} {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .stockists-item-{{ sid }} {
    display: flex;
    flex-direction: column;
  }

  /* Boutique Link with Map Affordance */
  .stockists-name-link-{{ sid }} {
    font-family: var(--body, 'Inter', sans-serif);
    font-size: 12.5px;
    font-weight: 600;
    color: var(--cocoa, #392319);
    text-decoration: none;
    line-height: 1.3;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    margin-bottom: 3px;
    width: fit-content;
    border-bottom: 1px solid transparent;
    transition: all 0.2s ease;
  }

  .stockists-name-link-{{ sid }}:hover {
    color: #634335;
    border-bottom-color: var(--cocoa, #392319);
    transform: translateX(1px);
  }

  .stockists-map-arrow-{{ sid }} {
    font-size: 11px;
    opacity: 0.6;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  .stockists-name-link-{{ sid }}:hover .stockists-map-arrow-{{ sid }} {
    opacity: 1;
    transform: translate(1px, -1px);
    color: var(--clay, #8a5a44);
  }

  .stockists-address-text-{{ sid }} {
    font-family: var(--body, 'Inter', sans-serif);
    font-size: 11.5px;
    line-height: 1.5;
    color: rgba(57, 35, 25, 0.72);
    margin: 0;
  }

  /* Compact Wholesale Note at Bottom */
  .stockists-bottom-note-{{ sid }} {
    margin-top: clamp(28px, 3.5vw, 44px);
    padding-top: 20px;
    border-top: 1px solid rgba(57, 35, 25, 0.12);
    text-align: center;
  }

  .stockists-note-content-{{ sid }} {
    font-family: var(--body, 'Inter', sans-serif);
    font-size: 12px;
    color: rgba(57, 35, 25, 0.7);
    margin: 0;
    line-height: 1.5;
  }

  .stockists-note-content-{{ sid }} a {
    color: var(--cocoa, #392319);
    text-decoration: underline;
    text-underline-offset: 3px;
    font-weight: 500;
    transition: opacity 0.2s ease;
  }

  .stockists-note-content-{{ sid }} a:hover {
    opacity: 0.75;
  }
</style>

<div class="stockists-page-{{ sid }}">
  <div class="stockists-container-{{ sid }}">

    <!-- Header with Map Interaction Cue -->
    <header class="stockists-header-{{ sid }}">
      <h1 class="stockists-title-{{ sid }}">{{ page_title }}</h1>

    </header>

    {%- if section.blocks.size > 0 -%}
      {%- comment -%} Extract Unique Regions Dynamically {%- endcomment -%}
      {%- assign all_regions = "" -%}
      {%- for block in section.blocks -%}
        {%- assign reg = block.settings.region | strip -%}
        {%- if reg != blank -%}
          {%- assign all_regions = all_regions | append: reg | append: "|||" -%}
        {%- endif -%}
      {%- endfor -%}

      {%- assign raw_regions_array = all_regions | split: "|||" -%}
      {%- assign unique_regions = "" -%}
      {%- for reg_item in raw_regions_array -%}
        {%- unless unique_regions contains reg_item -%}
          {%- if unique_regions != "" -%}{%- assign unique_regions = unique_regions | append: "," -%}{%- endif -%}
          {%- assign unique_regions = unique_regions | append: reg_item -%}
        {%- endunless -%}
      {%- endfor -%}

      {%- assign unique_regions_array = unique_regions | split: "," -%}

      <!-- 5-Column Layout Engineered for Desktop Single Viewport -->
      <div class="stockists-grid-5col-{{ sid }}">
        {%- for reg_name in unique_regions_array -%}
          <div class="stockists-col-{{ sid }}">
            <h2 class="stockists-region-heading-{{ sid }}">
              {{ reg_name }}
            </h2>
            
            <div class="stockists-boutiques-{{ sid }}">
              {%- for block in section.blocks -%}
                {%- if block.settings.region == reg_name -%}
                  {%- assign gmaps_target = block.settings.maps_url -%}
                  {%- if gmaps_target == blank -%}
                    {%- assign query_string = block.settings.name | append: " " | append: block.settings.address | url_encode -%}
                    {%- assign gmaps_target = "https://maps.google.com/?q=" | append: query_string -%}
                  {%- endif -%}

                  <div class="stockists-item-{{ sid }}" {{ block.shopify_attributes }}>
                    <a 
                      class="stockists-name-link-{{ sid }}" 
                      href="{{ gmaps_target }}" 
                      target="_blank" 
                      rel="noopener"
                      title="Open {{ block.settings.name }} on Google Maps"
                    >
                      <span>{{ block.settings.name }}</span>
                      <span class="stockists-map-arrow-{{ sid }}" aria-hidden="true">↗</span>
                    </a>
                    <p class="stockists-address-text-{{ sid }}">
                      {{ block.settings.address | newline_to_br }}
                    </p>
                  </div>
                {%- endif -%}
              {%- endfor -%}
            </div>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

    <!-- Compact Wholesale Footer Note -->
    {%- if section.settings.wholesale_note != blank -%}
      <div class="stockists-bottom-note-{{ sid }}">
        <p class="stockists-note-content-{{ sid }}">
          {{ section.settings.wholesale_note }}
        </p>
      </div>
    {%- endif -%}

  </div>
</div>

{% schema %}
{
  "name": "Stockists Page",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Stockists"
    },
    {
      "type": "richtext",
      "id": "wholesale_note",
      "label": "Wholesale Note (Bottom)",
      "default": "<p>If you would like to become a Lisandra The Label stockist, please email us <a href=\"mailto:lisandrathelabel@gmail.com\">lisandrathelabel@gmail.com</a></p>"
    }
  ],
  "blocks": [
    {
      "type": "location",
      "name": "Stockist Boutique",
      "settings": [
        {
          "type": "text",
          "id": "region",
          "label": "Region / Area",
          "default": "Canggu",
          "info": "e.g. Canggu, Pererenan, Seminyak, Uluwatu, Lombok"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Boutique Name",
          "default": "Saint Tropez"
        },
        {
          "type": "textarea",
          "id": "address",
          "label": "Full Address",
          "default": "Jl. Pantai Batu Mejan No.12b, Canggu, Kec. Kuta Utara, Kabupaten Badung, Bali"
        },
        {
          "type": "url",
          "id": "maps_url",
          "label": "Custom Google Maps Link (Optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Stockists Page"
    }
  ]
}
{% endschema %}
