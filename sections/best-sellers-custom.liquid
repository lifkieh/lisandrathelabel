<style>
  .best-sellers-{{ section.id }} {
    padding: clamp(30px, 4.5vw, 54px) clamp(14px, 2vw, 26px);
    background: var(--paper, #f8f8f0);
    color: var(--cocoa, #392319);
    font-family: var(--ui, "Inter", sans-serif);
  }
  .sec-top-{{ section.id }} {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 24px;
  }
  .sec-top-{{ section.id }} h3 {
    font-family: var(--heading, "Bodoni Moda", serif);
    font-weight: 500;
    font-size: clamp(17px, 1.8vw, 21px);
    margin: 0;
    letter-spacing: -0.005em;
  }
  .sec-top-{{ section.id }} p {
    margin: 3px 0 0;
    font-size: 12px;
    color: var(--ink60, #6e5c52);
  }
  .more-{{ section.id }} {
    display: inline-block;
    font-size: 10.5px;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    border-bottom: 1px solid var(--cocoa, #392319);
    padding-bottom: 2px;
    transition: transform 0.25s ease, color 0.25s ease, border-color 0.25s ease;
    text-decoration: none;
    color: var(--cocoa, #392319);
  }
  .more-{{ section.id }}:hover {
    color: var(--clay, #8a5a44);
    border-color: var(--clay, #8a5a44);
    transform: translateY(-1.5px);
  }

  /* Grid & Card */
  .grid-{{ section.id }} {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop }}, 1fr);
    gap: 16px;
    transition: opacity 0.2s ease, transform 0.2s ease;
  }
  .grid-{{ section.id }}.switching {
    opacity: 0.35;
    transform: scale(0.995);
  }
  .card-{{ section.id }} {
    padding-bottom: 24px;
    position: relative;
    text-decoration: none;
    color: inherit;
    display: block;
  }
  .card-{{ section.id }} .spec,
  .card-{{ section.id }} h4,
  .card-{{ section.id }} .price,
  .card-{{ section.id }} .sw-row {
    padding-left: 6px;
    padding-right: 6px;
  }
  .card-{{ section.id }} figure {
    position: relative;
    margin: 0;
    aspect-ratio: 3/4;
    background: var(--sand, #e0d9b5);
    overflow: hidden;
  }
  .card-{{ section.id }} figure img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: opacity 0.35s;
  }
  .card-{{ section.id }} figure img.hover-img {
    opacity: 0;
  }
  .card-{{ section.id }}:hover figure img.hover-img {
    opacity: 1;
  }

  /* Badge */
  .badge-{{ section.id }} {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 2;
    padding: 4px 8px;
    font-size: 9px;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    background: var(--cocoa, #392319);
    color: #fff;
  }

  /* Quick Add Actions */
  .card-actions-{{ section.id }} {
    position: absolute;
    bottom: -40px;
    left: 0;
    right: 0;
    padding: 10px;
    display: flex;
    justify-content: center;
    background: linear-gradient(transparent, rgba(20, 12, 8, 0.7));
    transition: bottom 0.3s ease;
    z-index: 3;
  }
  .card-{{ section.id }} figure:hover .card-actions-{{ section.id }} {
    bottom: 0;
  }
  .quick-add-btn-{{ section.id }} {
    background: #fff;
    color: var(--cocoa, #392319);
    border: none;
    padding: 8px 16px;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.05em;
    cursor: pointer;
    text-transform: uppercase;
    transition: background 0.2s, color 0.2s;
    width: 100%;
  }
  .quick-add-btn-{{ section.id }}:hover {
    background: var(--cocoa, #392319);
    color: #fff;
  }

  /* Text Details */
  .card-{{ section.id }} .spec {
    margin: 9px 0 4px;
    font-size: 9.5px;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink60, #6e5c52);
  }
  .card-{{ section.id }} h4 {
    margin: 0;
    font-size: 12.5px;
    font-weight: 500;
    line-height: 1.3;
  }
  .card-{{ section.id }} .price {
    margin: 3px 0 0;
    font-size: 12.5px;
    font-weight: 500;
    font-variant-numeric: tabular-nums;
  }
  .card-{{ section.id }} .price s {
    color: var(--ink60, #6e5c52);
    font-weight: 400;
    margin-right: 5px;
  }

  /* Swatches */
  .sw-row-{{ section.id }} {
    display: flex;
    gap: 5px;
    margin-top: 7px;
  }
  .sw-{{ section.id }} {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    border: 1px solid var(--line, #e2e2e2);
    padding: 0;
    cursor: pointer;
  }
  .sw-{{ section.id }}[aria-pressed="true"], .sw-{{ section.id }}:hover {
    box-shadow: 0 0 0 1px #fff inset, 0 0 0 2px var(--cocoa, #392319);
  }

  /* Responsive */
  @media (max-width: 900px) {
    .grid-{{ section.id }} {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  @media (max-width: 600px) {
    .best-sellers-{{ section.id }} {
      padding: clamp(24px, 4vw, 44px) clamp(14px, 2vw, 22px);
    }
    .grid-{{ section.id }} {
      grid-template-columns: repeat(2, 1fr);
      gap: 2px;
    }
    .card-actions-{{ section.id }} {
      display: none; /* Hide quick add hover on mobile */
    }
  }
</style>

<section class="best-sellers-{{ section.id }}">
  <div class="sec-top-{{ section.id }}">
    <div>
      <h3>{{ section.settings.title }}</h3>
      {%- if section.settings.subtitle != blank -%}
        <p>{{ section.settings.subtitle }}</p>
      {%- endif -%}
    </div>
    {%- if section.settings.link_label != blank -%}
      <a class="more-{{ section.id }}" href="{{ section.settings.link_url | default: '#' }}">{{ section.settings.link_label }}</a>
    {%- endif -%}
  </div>

  <div class="grid-{{ section.id }}" id="grid-{{ section.id }}">
    {%- assign collection = section.settings.collection -%}
    {%- if collection != blank -%}
      {%- for product in collection.products limit: section.settings.product_limit -%}
        <a href="{{ product.url }}" class="card-{{ section.id }}" data-product-handle="{{ product.handle }}">
          <figure>
            {%- if section.settings.show_badge -%}
              <span class="badge-{{ section.id }}">Best Seller</span>
            {%- endif -%}
            
            <img class="main-img" src="{{ product.featured_media | img_url: '600x' }}" alt="{{ product.title | escape }}" loading="lazy" />
            {%- if product.media.size > 1 -%}
              <img class="hover-img" src="{{ product.media[1] | img_url: '600x' }}" alt="{{ product.title | escape }}" loading="lazy" />
            {%- endif -%}
            
            <div class="card-actions-{{ section.id }}">
              <button class="quick-add-btn-{{ section.id }}" type="button" aria-haspopup="dialog" onclick="event.preventDefault(); alert('Quick Add Drawer opening for {{ product.title | escape }}...');">Quick Add</button>
            </div>
          </figure>
          
          <p class="spec">{{ product.type | default: "Hand-knit" }}</p>
          <h4>{{ product.title }}</h4>
          <p class="price">
            {%- if product.compare_at_price > product.price -%}
              <s>{{ product.compare_at_price | money_without_trailing_zeros }}</s>
            {%- endif -%}
            {{ product.price | money_without_trailing_zeros }}
          </p>
          
          {%- comment -%} Basic Swatch Simulator for Color options {%- endcomment -%}
          {%- for option in product.options_with_values -%}
            {%- if option.name == 'Color' or option.name == 'Colour' or option.name == 'Warna' -%}
              <div class="sw-row-{{ section.id }}" role="group" aria-label="Color">
                {%- for value in option.values -%}
                  {%- assign color_swatch = value | downcase | replace: ' ', '' -%}
                  {%- assign variant_image = '' -%}
                  {%- for variant in product.variants -%}
                    {%- if variant.options contains value and variant.image -%}
                      {%- assign variant_image = variant.image | img_url: '600x' -%}
                      {%- break -%}
                    {%- endif -%}
                  {%- endfor -%}
                  
                  <button 
                    type="button" 
                    class="sw-{{ section.id }}" 
                    style="background-color: {{ color_swatch }};" 
                    aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}" 
                    aria-label="{{ value | escape }}"
                    data-variant-img="{{ variant_image }}"
                    onclick="event.preventDefault(); swapSwatchImage(this);"
                  ></button>
                {%- endfor -%}
              </div>
            {%- endif -%}
          {%- endfor -%}
        </a>
      {%- endfor -%}
    {%- else -%}
      {%- comment -%} Placeholder State {%- endcomment -%}
      {%- for i in (1..4) -%}
        <article class="card-{{ section.id }}">
          <figure>
            <span class="badge-{{ section.id }}">Best Seller</span>
            <img src="https://lisandrathelabel.com/cdn/shop/files/Untitled_design-17.jpg?width=700" alt="Placeholder" loading="lazy" class="main-img"/>
            <img src="https://lisandrathelabel.com/cdn/shop/files/MEGAN_8.jpg?width=700" alt="Placeholder Hover" loading="lazy" class="hover-img"/>
            <div class="card-actions-{{ section.id }}">
              <button class="quick-add-btn-{{ section.id }}" type="button">Quick Add</button>
            </div>
          </figure>
          <p class="spec">Hand-knit · 2 days per piece</p>
          <h4>Zaye Knit Maxi Dress</h4>
          <p class="price">Rp 1.999.000</p>
          <div class="sw-row-{{ section.id }}" role="group" aria-label="Colour">
            <button class="sw-{{ section.id }}" style="background: #4a352a" aria-pressed="true"></button>
            <button class="sw-{{ section.id }}" style="background: #efe3d2" aria-pressed="false"></button>
          </div>
        </article>
      {%- endfor -%}
    {%- endif -%}
  </div>
</section>

<script>
  function swapSwatchImage(swatchBtn) {
    const card = swatchBtn.closest('.card-{{ section.id }}');
    if (!card) return;
    
    // Update active swatch state
    card.querySelectorAll('.sw-{{ section.id }}').forEach(btn => btn.setAttribute('aria-pressed', 'false'));
    swatchBtn.setAttribute('aria-pressed', 'true');
    
    // Swap image if variant image exists
    const newImgUrl = swatchBtn.getAttribute('data-variant-img');
    if (newImgUrl) {
      const mainImg = card.querySelector('figure .main-img');
      const hoverImg = card.querySelector('figure .hover-img');
      if (mainImg) mainImg.src = newImgUrl;
      if (hoverImg) hoverImg.src = newImgUrl; // Optional: change hover img or hide it
    }
  }
</script>

{% schema %}
{
  "name": "Best Sellers (Editorial)",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Best sellers"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Ranked by what actually leaves first."
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link Label",
      "default": "View all"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "Link URL"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection to display"
    },
    {
      "type": "range",
      "id": "product_limit",
      "min": 2,
      "max": 12,
      "step": 1,
      "label": "Maximum products to show",
      "default": 4
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "label": "Columns on Desktop",
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "show_badge",
      "label": "Show 'Best Seller' Badge",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Best Sellers (Editorial)"
    }
  ]
}
{% endschema %}
