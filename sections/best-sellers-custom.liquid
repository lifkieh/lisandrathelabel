<style>
  .best-sellers-{{ section.id }} {
    padding: clamp(30px, 4.5vw, 54px) clamp(14px, 2vw, 26px);
    background: var(--paper, #f8f8f0);
    color: var(--cocoa, #392319);
    font-family: var(--ui, "Inter", sans-serif);
  }
  .sec-top-{{ section.id }} {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 24px;
  }
  .sec-top-{{ section.id }} h3 {
    font-family: var(--heading, "Bodoni Moda", serif);
    font-weight: 500;
    font-size: clamp(17px, 1.8vw, 21px);
    margin: 0;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .sec-top-{{ section.id }} p {
    margin: 3px 0 0;
    font-size: 12px;
    color: var(--ink60, #6e5c52);
  }
  .more-{{ section.id }} {
    display: inline-block;
    font-size: 10.5px;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    border-bottom: 1px solid var(--cocoa, #392319);
    padding-bottom: 2px;
    transition: transform 0.25s ease, color 0.25s ease, border-color 0.25s ease;
    text-decoration: none;
    color: var(--cocoa, #392319);
  }
  .more-{{ section.id }}:hover {
    color: var(--clay, #8a5a44);
    border-color: var(--clay, #8a5a44);
    transform: translateY(-1.5px);
  }

  /* Grid & Card */
  .grid-{{ section.id }} {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop }}, 1fr);
    gap: 2px;
    transition: opacity 0.2s ease, transform 0.2s ease;
  }
  .grid-{{ section.id }}.switching {
    opacity: 0.35;
    transform: scale(0.995);
  }
  .card-{{ section.id }} {
    padding-bottom: 24px;
    position: relative;
    text-decoration: none;
    color: inherit;
    display: block;
  }
  .card-{{ section.id }} .spec,
  .card-{{ section.id }} h4,
  .card-{{ section.id }} .price,
  .card-{{ section.id }} .sw-row {
    padding-left: 6px;
    padding-right: 6px;
  }
  .card-{{ section.id }} figure {
    position: relative;
    margin: 0;
    aspect-ratio: 3/4;
    background: var(--sand, #e0d9b5);
    overflow: hidden;
  }
  .card-{{ section.id }} figure img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: opacity 0.35s;
  }
  .card-{{ section.id }} figure img.hover-img {
    opacity: 0;
  }
  .card-{{ section.id }}:hover figure img.hover-img {
    opacity: 1;
  }

  /* Badge */
  .badge-{{ section.id }} {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 2;
    padding: 4px 8px;
    font-size: 9px;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    background: var(--cocoa, #392319);
    color: #fff;
  }

  /* Quick Add Actions */
  .card-actions-{{ section.id }} {
    position: absolute;
    bottom: -40px;
    left: 0;
    right: 0;
    padding: 10px;
    display: flex;
    justify-content: center;
    background: linear-gradient(transparent, rgba(20, 12, 8, 0.7));
    transition: bottom 0.3s ease;
    z-index: 3;
  }
  .card-{{ section.id }}:hover .card-actions-{{ section.id }} {
    bottom: 0;
  }
  .quick-add-btn-{{ section.id }} {
    background: #fff;
    color: var(--cocoa, #392319);
    border: none;
    padding: 9px 16px;
    font-size: 10.5px;
    font-weight: 600;
    letter-spacing: 0.06em;
    cursor: pointer;
    text-transform: uppercase;
    transition: background 0.2s, color 0.2s, transform 0.15s ease;
    width: 100%;
    border-radius: 2px;
  }
  .quick-add-btn-{{ section.id }}:hover {
    background: var(--cocoa, #392319);
    color: #fff;
  }

  /* Text Details - Concept 2: The Dual-Tone Stack */
  .card-meta-{{ section.id }} {
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin-top: 10px;
    padding-left: 6px;
    padding-right: 6px;
  }
  .card-{{ section.id }} h4 {
    font-family: var(--ui, "Inter", sans-serif);
    margin: 0;
    font-size: 13px;
    font-weight: 500;
    line-height: 1.35;
    letter-spacing: 0.01em;
    text-transform: none;
    color: var(--cocoa, #392319);
  }
  .card-{{ section.id }} .price {
    margin: 0;
    font-family: var(--ui, "Inter", sans-serif);
    font-size: 12px;
    font-weight: 400;
    letter-spacing: 0.02em;
    font-variant-numeric: tabular-nums;
    color: rgba(57, 35, 25, 0.65);
  }
  .card-{{ section.id }} .price s {
    color: rgba(57, 35, 25, 0.4);
    font-size: 11px;
    font-weight: 400;
    margin-right: 5px;
  }

  /* Swatches */
  .sw-row-{{ section.id }} {
    display: flex;
    gap: 5px;
    margin-top: 7px;
  }
  .sw-{{ section.id }} {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    border: 1px solid var(--line, #e2e2e2);
    padding: 0;
    cursor: pointer;
  }
  .sw-{{ section.id }}[aria-pressed="true"], .sw-{{ section.id }}:hover {
    box-shadow: 0 0 0 1px #fff inset, 0 0 0 2px var(--cocoa, #392319);
  }

  /* Quick Add Drawer / Modal Component */
  .qa-overlay-v5 {
    position: fixed;
    inset: 0;
    background: rgba(18, 11, 7, 0.45);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.25s ease, visibility 0.25s;
    padding: 16px;
    box-sizing: border-box;
  }
  .qa-overlay-v5.is-open {
    opacity: 1;
    visibility: visible;
  }
  .qa-card-v5 {
    background: var(--paper, #fcfbf7);
    border: 1px solid var(--line, #e5dfd3);
    border-radius: 8px;
    width: 100%;
    max-width: 420px;
    box-shadow: 0 20px 50px rgba(35, 20, 12, 0.25);
    padding: 22px 20px 20px 20px;
    position: relative;
    transform: translateY(12px) scale(0.98);
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    box-sizing: border-box;
    color: var(--cocoa, #392319);
    font-family: var(--ui, "Inter", sans-serif);
  }
  .qa-overlay-v5.is-open .qa-card-v5 {
    transform: translateY(0) scale(1);
  }
  .qa-close-btn-v5 {
    position: absolute;
    top: 14px;
    right: 14px;
    background: transparent;
    border: none;
    font-size: 18px;
    line-height: 1;
    color: var(--cocoa, #392319);
    cursor: pointer;
    padding: 6px;
    opacity: 0.7;
    transition: opacity 0.2s;
  }
  .qa-close-btn-v5:hover {
    opacity: 1;
  }
  .qa-product-header-v5 {
    display: flex;
    gap: 14px;
    align-items: center;
    padding-bottom: 16px;
    border-bottom: 1px solid var(--line, #e5dfd3);
    margin-bottom: 16px;
  }
  .qa-product-img-v5 {
    width: 64px;
    height: 85px;
    object-fit: cover;
    border-radius: 4px;
    background: var(--sand, #f4efe6);
    flex-shrink: 0;
  }
  .qa-product-info-v5 {
    flex: 1;
    min-width: 0;
  }
  .qa-product-title-v5 {
    font-family: var(--heading, "Bodoni Moda", serif);
    font-size: 16px;
    font-weight: 500;
    margin: 0 0 4px 0;
    line-height: 1.25;
    color: var(--cocoa, #392319);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .qa-product-price-v5 {
    font-size: 13px;
    font-weight: 400;
    color: var(--clay, #8a5a44);
    margin: 0;
  }
  .qa-label-v5 {
    font-size: 10.5px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--cocoa, #392319);
    margin-bottom: 10px;
    display: block;
  }
  .qa-variants-list-v5 {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 20px;
  }
  .qa-size-pill-v5 {
    background: #ffffff;
    border: 1px solid var(--line, #e5dfd3);
    border-radius: 4px;
    padding: 8px 14px;
    font-size: 11.5px;
    font-weight: 500;
    color: var(--cocoa, #392319);
    cursor: pointer;
    transition: all 0.2s ease;
    min-width: 44px;
    text-align: center;
    font-family: var(--ui, "Inter", sans-serif);
  }
  .qa-size-pill-v5:hover:not(:disabled) {
    border-color: var(--cocoa, #392319);
    background: var(--paper, #fcfbf7);
  }
  .qa-size-pill-v5.is-selected {
    background: var(--cocoa, #392319) !important;
    color: #ffffff !important;
    border-color: var(--cocoa, #392319) !important;
  }
  .qa-size-pill-v5:disabled {
    opacity: 0.35;
    text-decoration: line-through;
    cursor: not-allowed;
  }
  .qa-submit-btn-v5 {
    width: 100%;
    background: var(--cocoa, #392319);
    color: #ffffff;
    border: none;
    border-radius: 4px;
    padding: 13px 16px;
    font-size: 11.5px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    cursor: pointer;
    transition: background 0.2s ease, transform 0.15s ease, opacity 0.2s ease;
    font-family: var(--ui, "Inter", sans-serif);
  }
  .qa-submit-btn-v5:hover:not(:disabled) {
    background: #23140e;
    transform: translateY(-1px);
  }
  .qa-submit-btn-v5:disabled {
    background: #c5beba;
    cursor: not-allowed;
  }
  .qa-view-link-v5 {
    display: block;
    text-align: center;
    margin-top: 12px;
    font-size: 11px;
    color: var(--clay, #8a5a44);
    text-decoration: underline;
    transition: color 0.2s;
  }
  .qa-view-link-v5:hover {
    color: var(--cocoa, #392319);
  }

  /* Toast Notification (Positioned under navbar header) */
  .qa-toast-v5 {
    position: fixed;
    top: 130px;
    right: 24px;
    background: var(--cocoa, #392319);
    color: #ffffff;
    padding: 12px 18px;
    border-radius: 6px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.25);
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 12px;
    font-weight: 500;
    z-index: 990;
    opacity: 0;
    transform: translateY(-10px);
    transition: opacity 0.25s ease, transform 0.25s ease;
    pointer-events: none;
    font-family: var(--ui, "Inter", sans-serif);
  }
  .qa-toast-v5.is-show {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }
  .qa-toast-link-v5 {
    color: #ffffff;
    text-decoration: underline;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  /* Responsive */
  @media (max-width: 900px) {
    .grid-{{ section.id }} {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  @media (max-width: 600px) {
    .best-sellers-{{ section.id }} {
      padding: clamp(24px, 4vw, 44px) clamp(14px, 2vw, 22px);
    }
    .grid-{{ section.id }} {
      grid-template-columns: repeat(2, 1fr);
      gap: 2px;
    }
    .card-actions-{{ section.id }} {
      position: static;
      padding: 6px 0 0 0;
      background: transparent;
    }
    .quick-add-btn-{{ section.id }} {
      border: 1px solid var(--cocoa, #392319);
      background: transparent;
      padding: 6px 10px;
      font-size: 9.5px;
    }
  }
</style>

<section class="best-sellers-{{ section.id }}">
  <div class="sec-top-{{ section.id }}">
    <div>
      <h3>{{ section.settings.title }}</h3>
      {%- if section.settings.subtitle != blank -%}
        <p>{{ section.settings.subtitle }}</p>
      {%- endif -%}
    </div>
    {%- if section.settings.link_label != blank -%}
      <a class="more-{{ section.id }}" href="{{ section.settings.link_url | default: '#' }}">{{ section.settings.link_label }}</a>
    {%- endif -%}
  </div>

  <div class="grid-{{ section.id }}" id="grid-{{ section.id }}">
    {%- assign collection = section.settings.collection -%}
    {%- if collection != blank -%}
      {%- for product in collection.products limit: section.settings.product_limit -%}
        {%- capture variants_json -%}
          [
            {%- for variant in product.variants -%}
              {
                "id": {{ variant.id }},
                "title": {{ variant.title | json }},
                "price": {{ variant.price | money_without_trailing_zeros | json }},
                "available": {{ variant.available | json }}
              }{%- unless forloop.last -%},{%- endunless -%}
            {%- endfor -%}
          ]
        {%- endcapture -%}

        <div class="card-{{ section.id }}" data-product-handle="{{ product.handle }}">
          <figure>
            {%- if section.settings.show_badge -%}
              <span class="badge-{{ section.id }}">Best Seller</span>
            {%- endif -%}
            
            <a href="{{ product.url }}">
              <img class="main-img" src="{{ product.featured_media | img_url: '600x' }}" alt="{{ product.title | escape }}" loading="lazy" />
              {%- if product.media.size > 1 -%}
                <img class="hover-img" src="{{ product.media[1] | img_url: '600x' }}" alt="{{ product.title | escape }}" loading="lazy" />
              {%- endif -%}
            </a>
            
            <div class="card-actions-{{ section.id }}">
              <button 
                class="quick-add-btn-{{ section.id }}" 
                type="button" 
                aria-haspopup="dialog"
                data-title="{{ product.title | escape }}"
                data-url="{{ product.url }}"
                data-img="{{ product.featured_media | img_url: '400x' }}"
                data-price="{{ product.price | money_without_trailing_zeros }}"
                data-variants='{{ variants_json | strip_newlines }}'
                onclick="event.preventDefault(); event.stopPropagation(); openQuickAddModal(this, '{{ section.id }}');"
              >
                Quick Add
              </button>
            </div>
          </figure>
          
          <div class="card-meta-{{ section.id }}">
            <a href="{{ product.url }}" style="text-decoration:none; color:inherit;">
              <h4>{{ product.title }}</h4>
            </a>
            <p class="price">
              {%- if product.compare_at_price > product.price -%}
                <s>{{ product.compare_at_price | money_without_trailing_zeros }}</s>
              {%- endif -%}
              {{ product.price | money_without_trailing_zeros }}
            </p>
          </div>
          
          {%- comment -%} Basic Swatch Simulator for Color options {%- endcomment -%}
          {%- for option in product.options_with_values -%}
            {%- if option.name == 'Color' or option.name == 'Colour' or option.name == 'Warna' -%}
              <div class="sw-row-{{ section.id }}" role="group" aria-label="Color">
                {%- for value in option.values -%}
                  {%- assign color_swatch = value | downcase | replace: ' ', '' -%}
                  {%- assign variant_image = '' -%}
                  {%- for variant in product.variants -%}
                    {%- if variant.options contains value and variant.image -%}
                      {%- assign variant_image = variant.image | img_url: '600x' -%}
                      {%- break -%}
                    {%- endif -%}
                  {%- endfor -%}
                  
                  <button 
                    type="button" 
                    class="sw-{{ section.id }}" 
                    style="background-color: {{ color_swatch }};" 
                    aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}" 
                    aria-label="{{ value | escape }}"
                    data-variant-img="{{ variant_image }}"
                    onclick="event.preventDefault(); swapSwatchImage(this, '{{ section.id }}');"
                  ></button>
                {%- endfor -%}
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endfor -%}
    {%- else -%}
      {%- comment -%} Placeholder State {%- endcomment -%}
      {%- for i in (1..4) -%}
        <article class="card-{{ section.id }}">
          <figure>
            <span class="badge-{{ section.id }}">Best Seller</span>
            <img src="https://lisandrathelabel.com/cdn/shop/files/Untitled_design-17.jpg?width=700" alt="Placeholder" loading="lazy" class="main-img"/>
            <img src="https://lisandrathelabel.com/cdn/shop/files/MEGAN_8.jpg?width=700" alt="Placeholder Hover" loading="lazy" class="hover-img"/>
            <div class="card-actions-{{ section.id }}">
              <button class="quick-add-btn-{{ section.id }}" type="button">Quick Add</button>
            </div>
          </figure>
          <p class="spec">Hand-knit · 2 days per piece</p>
          <h4>Zaye Knit Maxi Dress</h4>
          <p class="price">Rp 1.999.000</p>
          <div class="sw-row-{{ section.id }}" role="group" aria-label="Colour">
            <button class="sw-{{ section.id }}" style="background: #4a352a" aria-pressed="true"></button>
            <button class="sw-{{ section.id }}" style="background: #efe3d2" aria-pressed="false"></button>
          </div>
        </article>
      {%- endfor -%}
    {%- endif -%}
  </div>
</section>

<!-- Quick Add Modal Component -->
<div class="qa-overlay-v5" id="qaModalOverlay-{{ section.id }}" onclick="if(event.target === this) closeQuickAddModal('{{ section.id }}');">
  <div class="qa-card-v5" id="qaModalCard-{{ section.id }}">
    <button type="button" class="qa-close-btn-v5" onclick="closeQuickAddModal('{{ section.id }}')" aria-label="Close">✕</button>

    <div class="qa-product-header-v5">
      <img id="qaImg-{{ section.id }}" class="qa-product-img-v5" src="" alt="" />
      <div class="qa-product-info-v5">
        <h4 id="qaTitle-{{ section.id }}" class="qa-product-title-v5"></h4>
        <p id="qaPrice-{{ section.id }}" class="qa-product-price-v5"></p>
      </div>
    </div>

    <span class="qa-label-v5">Select Size / Option</span>
    <div id="qaVariants-{{ section.id }}" class="qa-variants-list-v5"></div>

    <button type="button" id="qaSubmitBtn-{{ section.id }}" class="qa-submit-btn-v5" disabled onclick="submitQuickAddToCart('{{ section.id }}')">
      Select a size
    </button>

    <a id="qaViewLink-{{ section.id }}" href="#" class="qa-view-link-v5">View full product details →</a>
  </div>
</div>

<!-- Floating Toast Notification -->
<div class="qa-toast-v5" id="qaToast-{{ section.id }}">
  <span id="qaToastMsg-{{ section.id }}">✓ Item added to bag</span>
  <a href="/cart" class="qa-toast-link-v5">View Bag</a>
</div>

<script>
  let currentQaVariantId_{{ section.id | replace: '-', '_' }} = null;

  function swapSwatchImage(swatchBtn, sectionId) {
    const card = swatchBtn.closest('.card-' + sectionId);
    if (!card) return;
    
    // Update active swatch state
    card.querySelectorAll('.sw-' + sectionId).forEach(btn => btn.setAttribute('aria-pressed', 'false'));
    swatchBtn.setAttribute('aria-pressed', 'true');
    
    // Swap image if variant image exists
    const newImgUrl = swatchBtn.getAttribute('data-variant-img');
    if (newImgUrl) {
      const mainImg = card.querySelector('figure .main-img');
      const hoverImg = card.querySelector('figure .hover-img');
      if (mainImg) mainImg.src = newImgUrl;
      if (hoverImg) hoverImg.src = newImgUrl;
    }
  }

  function openQuickAddModal(btn, sectionId) {
    const title = btn.getAttribute('data-title');
    const price = btn.getAttribute('data-price');
    const img = btn.getAttribute('data-img');
    const url = btn.getAttribute('data-url');
    const variantsRaw = btn.getAttribute('data-variants');

    document.getElementById('qaTitle-' + sectionId).textContent = title;
    document.getElementById('qaPrice-' + sectionId).innerHTML = price;
    document.getElementById('qaImg-' + sectionId).src = img;
    document.getElementById('qaViewLink-' + sectionId).href = url;

    const variantsList = document.getElementById('qaVariants-' + sectionId);
    variantsList.innerHTML = '';
    currentQaVariantId_{{ section.id | replace: '-', '_' }} = null;

    const submitBtn = document.getElementById('qaSubmitBtn-' + sectionId);
    submitBtn.disabled = true;
    submitBtn.textContent = 'Select a size';

    try {
      const variants = JSON.parse(variantsRaw);
      if (variants && variants.length > 0) {
        if (variants.length === 1 && variants[0].title === 'Default Title') {
          currentQaVariantId_{{ section.id | replace: '-', '_' }} = variants[0].id;
          submitBtn.disabled = !variants[0].available;
          submitBtn.textContent = variants[0].available ? 'ADD TO BAG' : 'SOLD OUT';
          variantsList.style.display = 'none';
        } else {
          variantsList.style.display = 'flex';
          variants.forEach(v => {
            const pill = document.createElement('button');
            pill.type = 'button';
            pill.className = 'qa-size-pill-v5';
            pill.textContent = v.title;
            if (!v.available) {
              pill.disabled = true;
              pill.title = 'Sold Out';
            } else {
              pill.onclick = function() {
                variantsList.querySelectorAll('.qa-size-pill-v5').forEach(p => p.classList.remove('is-selected'));
                pill.classList.add('is-selected');
                currentQaVariantId_{{ section.id | replace: '-', '_' }} = v.id;
                submitBtn.disabled = false;
                submitBtn.textContent = 'ADD TO BAG';
              };
            }
            variantsList.appendChild(pill);
          });
        }
      }
    } catch(e) {
      console.error('Error parsing variants:', e);
    }

    document.getElementById('qaModalOverlay-' + sectionId).classList.add('is-open');
  }

  function closeQuickAddModal(sectionId) {
    document.getElementById('qaModalOverlay-' + sectionId).classList.remove('is-open');
  }

  function submitQuickAddToCart(sectionId) {
    const variantId = currentQaVariantId_{{ section.id | replace: '-', '_' }};
    if (!variantId) return;

    const submitBtn = document.getElementById('qaSubmitBtn-' + sectionId);
    const originalText = submitBtn.textContent;
    submitBtn.disabled = true;
    submitBtn.textContent = 'ADDING...';

    fetch('/cart/add.js', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'Accept': 'application/json'
      },
      body: JSON.stringify({
        items: [{
          id: variantId,
          quantity: 1
        }]
      })
    })
    .then(response => {
      if (!response.ok) throw new Error('Add to cart failed');
      return response.json();
    })
    .then(data => {
      closeQuickAddModal(sectionId);
      showQuickAddToast(sectionId);
      updateHeaderCartCount();
    })
    .catch(err => {
      console.error(err);
      alert('Could not add item to bag. Please try again.');
    })
    .finally(() => {
      submitBtn.disabled = false;
      submitBtn.textContent = originalText;
    });
  }

  function showQuickAddToast(sectionId) {
    const toast = document.getElementById('qaToast-' + sectionId);
    if (!toast) return;
    toast.classList.add('is-show');
    setTimeout(() => {
      toast.classList.remove('is-show');
    }, 4000);
  }

  function updateHeaderCartCount() {
    fetch('/cart.js')
      .then(res => res.json())
      .then(cart => {
        document.querySelectorAll('.cart-count-v5').forEach(el => {
          el.textContent = cart.item_count;
        });
      })
      .catch(e => console.error(e));
  }
</script>

