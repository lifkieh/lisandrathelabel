<style>
  /* ---------- footer + muse circle (integrated single row) ---------- */
  .foot {
    background: var(--cocoa, #392319);
    color: #eee6d9;
    padding: clamp(48px, 6vw, 72px) clamp(20px, 4vw, 40px) 24px;
    text-align: left;
  }

  .foot-inner {
    max-width: 1200px;
    margin: 0 auto clamp(36px, 5vw, 64px);
    display: grid;
    grid-template-columns: 1.2fr 2fr;
    gap: clamp(40px, 6vw, 80px);
    align-items: start;
  }
  @media (max-width: 900px) {
    .foot-inner {
      grid-template-columns: 1fr;
      gap: 48px;
    }
  }

  /* Left: Logo & Newsletter */
  .foot-brand-newsletter {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .foot-logo {
    height: 60px; /* Adjusted height for better balance */
    width: auto;
    object-fit: contain;
    margin-left: -8px; /* Offset potential internal padding of image */
  }
  
  .foot-muse-copy {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .muse-kicker {
    font-family: var(--body, sans-serif);
    font-size: 9.5px;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #c68642;
    display: block;
  }
  .foot-muse-copy h2 {
    font-family: var(--display, serif);
    font-size: clamp(20px, 2.4vw, 24px);
    font-weight: 400;
    font-style: italic;
    color: #f8f8f0;
    margin: 0;
    line-height: 1.3;
    letter-spacing: -0.01em;
  }
  .foot-muse-copy p {
    font-family: var(--body, sans-serif);
    font-size: 12px;
    color: rgba(248, 248, 240, 0.65);
    margin: 0;
    line-height: 1.55;
    max-width: 38ch;
  }
  .foot-muse-form-zone {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-top: 4px;
  }
  .muse-form-inline {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  @media (min-width: 480px) {
    .muse-form-inline {
      flex-direction: row;
      gap: 0;
    }
  }
  .muse-input {
    width: 100%;
    padding: 13px 16px;
    border: 1px solid rgba(248, 248, 240, 0.28);
    background: rgba(248, 248, 240, 0.05);
    font-family: var(--body, sans-serif);
    font-size: 11.5px;
    letter-spacing: 0.04em;
    color: #f8f8f0;
    outline: none;
    transition: border-color 0.25s ease, background 0.25s ease;
    box-sizing: border-box;
  }
  .muse-input::placeholder {
    color: rgba(248, 248, 240, 0.38);
    letter-spacing: 0.05em;
  }
  .muse-input:focus {
    border-color: rgba(248, 248, 240, 0.7);
    background: rgba(248, 248, 240, 0.09);
  }
  .muse-submit {
    width: 100%;
    padding: 13px 20px;
    background: #f8f8f0;
    color: var(--cocoa, #392319);
    font-family: var(--body, sans-serif);
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    border: 1px solid #f8f8f0;
    cursor: pointer;
    transition: background 0.25s ease, color 0.25s ease, border-color 0.25s ease;
  }
  @media (min-width: 480px) {
    .muse-input { border-right: none; }
    .muse-submit { width: auto; flex-shrink: 0; }
  }
  .muse-submit:hover {
    background: transparent;
    color: #f8f8f0;
    border-color: rgba(248, 248, 240, 0.6);
  }
  .muse-disclaimer {
    font-family: var(--body, sans-serif);
    font-size: 10px;
    color: rgba(248, 248, 240, 0.35);
    letter-spacing: 0.02em;
    line-height: 1.4;
    margin: 0;
  }
  .muse-disclaimer a {
    color: rgba(248, 248, 240, 0.5);
    text-decoration: underline;
  }
  .muse-disclaimer a:hover { color: rgba(248, 248, 240, 0.8); }
  
  .muse-success {
    display: none;
    flex-direction: column;
    gap: 6px;
    padding: 12px 0 2px;
  }
  .muse-success-check {
    font-size: 18px;
    color: #c68642;
  }
  .muse-success p {
    font-family: var(--display, serif);
    font-size: 14px;
    font-style: italic;
    color: #f8f8f0;
    margin: 0;
  }
  .muse-success small {
    font-family: var(--body, sans-serif);
    font-size: 10.5px;
    color: rgba(248, 248, 240, 0.5);
    display: block;
  }

  /* Right: Navigation Columns */
  .foot-cols {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(24px, 4vw, 48px);
    width: 100%;
  }
  @media (max-width: 600px) {
    .foot-cols {
      grid-template-columns: 1fr;
      gap: 32px;
    }
  }
  .foot-col h5, .foot-col h4 {
    font-family: var(--body, sans-serif);
    font-size: 13.5px;
    font-weight: 500;
    color: #f8f8f0;
    margin: 0 0 16px 0;
    letter-spacing: 0.02em;
  }
  .foot-col ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .foot-col ul li a {
    font-family: var(--body, sans-serif);
    font-size: 12px;
    color: rgba(238, 230, 217, 0.7);
    text-decoration: none;
    transition: color 0.2s ease;
  }
  .foot-col ul li a:hover {
    color: #ffffff;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  
  .foot-btm {
    border-top: 1px solid rgba(248, 248, 240, 0.1);
    padding-top: 24px;
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    justify-content: space-between;
    align-items: center;
    font-family: var(--body, sans-serif);
    font-size: 10.5px;
    color: rgba(238, 230, 217, 0.5);
  }
  @media (max-width: 600px) {
    .foot-btm {
      flex-direction: column;
      text-align: center;
      justify-content: center;
    }
  }

  /* ---------- Sticky Newsletter Teaser (Bottom-Left) ---------- */
  .newsletter-teaser {
    position: fixed;
    bottom: 24px;
    left: 24px;
    background: var(--paper, #f8f8f0);
    padding: 12px 20px;
    display: flex;
    align-items: center;
    gap: 12px;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.08);
    cursor: pointer;
    z-index: 40;
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.4s ease, box-shadow 0.3s ease;
  }
  @media (max-width: 768px) {
    .newsletter-teaser {
      bottom: 16px;
      left: 16px;
      right: 16px;
      justify-content: space-between;
    }
  }
  .newsletter-teaser:hover { box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12); }
  .newsletter-teaser.hidden {
    transform: translateY(150%);
    opacity: 0;
    pointer-events: none;
  }
  .newsletter-teaser-text {
    font-family: var(--body, sans-serif);
    font-size: 10.5px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--cocoa, #392319);
  }
  .newsletter-teaser-close {
    background: none;
    border: none;
    font-size: 16px;
    cursor: pointer;
    color: var(--ink60, #666);
    padding: 4px;
    line-height: 1;
  }
  .newsletter-teaser-close:hover { color: var(--ink, #000); }

  /* ---------- Newsletter Modal (2-Column Luxury) ---------- */
  #newsletterModal {
    border: none;
    background: transparent;
    padding: 0;
    margin: auto;
  }
  #newsletterModal::backdrop {
    background: rgba(30, 18, 10, 0.4);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
  }
  .newsletter-modal-inner {
    background: var(--paper, #f8f8f0);
    width: 95vw;
    max-width: 800px;
    position: relative;
    display: flex;
    flex-direction: column;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.25);
  }
  @media (min-width: 768px) {
    .newsletter-modal-inner { flex-direction: row; }
  }
  .newsletter-image-wrap {
    width: 100%;
    background: var(--sand, #e0d9b5);
    display: none;
  }
  @media (min-width: 768px) {
    .newsletter-image-wrap { width: 50%; display: block; }
  }
  .newsletter-image-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .newsletter-content-wrap {
    padding: clamp(32px, 5vw, 64px) clamp(24px, 4vw, 48px);
    display: flex;
    flex-direction: column;
    justify-content: center;
    width: 100%;
    box-sizing: border-box;
  }
  @media (min-width: 768px) {
    .newsletter-content-wrap { width: 50%; }
  }
  .newsletter-modal-close {
    position: absolute;
    top: 16px;
    right: 16px;
    font-size: 24px;
    line-height: 1;
    z-index: 10;
    background: transparent;
    border: none;
    cursor: pointer;
    color: var(--ink, #000);
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: opacity 0.25s ease;
  }
  @media (max-width: 767px) {
    .newsletter-modal-close {
      background: var(--paper, #f8f8f0);
      border-radius: 50%;
      box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    }
  }
  .newsletter-modal-close:hover { opacity: 0.6; }
  
  .newsletter-subtitle-kicker {
    font-family: var(--body, sans-serif);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--clay, #8a5a44);
    margin-bottom: 12px;
    display: block;
  }
  .newsletter-modal-title {
    font-family: var(--display, serif);
    font-size: clamp(24px, 3vw, 32px);
    font-style: italic;
    font-weight: 400;
    color: var(--cocoa, #392319);
    margin: 0 0 12px 0;
    line-height: 1.15;
  }
  .newsletter-modal-desc {
    font-family: var(--body, sans-serif);
    font-size: 12.5px;
    color: var(--ink60, #666);
    line-height: 1.5;
    margin: 0 0 24px 0;
  }
  .newsletter-modal-form {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .newsletter-input-group {
    display: flex;
    flex-direction: column;
  }
  .newsletter-modal-form input[type="email"] {
    width: 100%;
    padding: 14px 16px;
    border: 1px solid var(--line, #e2e2e2);
    background: transparent;
    font-family: var(--body, sans-serif);
    font-size: 12px;
    letter-spacing: 0.04em;
    color: var(--ink, #000);
    outline: none;
    transition: border-color 0.25s ease;
    box-sizing: border-box;
  }
  .newsletter-modal-form input[type="email"]::placeholder {
    color: var(--ink60, #666);
    letter-spacing: 0.05em;
  }
  .newsletter-modal-form input[type="email"]:focus {
    border-color: var(--cocoa, #392319);
  }
  .newsletter-submit-btn {
    width: 100%;
    padding: 14px 24px;
    background: var(--cocoa, #392319);
    color: #fff;
    font-family: var(--body, sans-serif);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    border: 1px solid var(--cocoa, #392319);
    cursor: pointer;
    transition: background 0.25s ease, color 0.25s ease;
  }
  .newsletter-submit-btn:hover {
    background: #fff;
    color: var(--cocoa, #392319);
  }
  .newsletter-privacy-note {
    font-family: var(--body, sans-serif);
    font-size: 10px;
    color: var(--ink60, #666);
    margin-top: 12px;
  }
  .newsletter-success-msg {
    display: none;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    height: 100%;
    animation: fadeInMsg 0.6s ease forwards;
  }
  @keyframes fadeInMsg { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
  .newsletter-success-msg .success-icon {
    font-size: 32px;
    color: var(--clay, #8a5a44);
    margin-bottom: 16px;
  }
  .newsletter-success-msg h4 {
    font-family: var(--display, serif);
    font-size: 24px;
    font-style: italic;
    color: var(--cocoa, #392319);
    margin: 0 0 12px 0;
  }
  .newsletter-success-msg p {
    font-family: var(--body, sans-serif);
    font-size: 13px;
    color: var(--ink60, #666);
    margin: 0;
  }
</style>

<footer class="foot">
  <div class="foot-inner">
    <!-- Left: Brand & Newsletter -->
    <div class="foot-brand-newsletter">
      {%- if section.settings.logo != blank -%}
        <img class="foot-logo" src="{{ section.settings.logo | img_url: '400x' }}" alt="{{ shop.name }}" loading="lazy" />
      {%- else -%}
        <h2 style="font-family: var(--display); color: #fff; margin: 0;">{{ shop.name }}</h2>
      {%- endif -%}

      <div class="foot-muse-copy">
        <span class="muse-kicker">{{ section.settings.muse_kicker }}</span>
        <h2>{{ section.settings.muse_title }}</h2>
        <p>{{ section.settings.muse_desc }}</p>
      </div>
      
      <div class="foot-muse-form-zone">
        <div id="museFormWrap">
          {% form 'customer', id: 'museForm', class: 'muse-form-inline' %}
            <input type="hidden" name="contact[tags]" value="newsletter">
            
            {%- if form.posted_successfully? -%}
              <script>document.addEventListener("DOMContentLoaded", function() { showMuseSuccess(); });</script>
            {%- else -%}
              <input type="email" name="contact[email]" class="muse-input" id="museEmail" placeholder="Your email address" required autocomplete="email" />
              <button type="submit" class="muse-submit">{{ section.settings.muse_btn_label }}</button>
            {%- endif -%}
          {% endform %}
        </div>
        
        <div class="muse-success" id="museSuccess" {% if form.posted_successfully? %}style="display:flex; opacity:1;"{% endif %}>
          <span class="muse-success-check">✦</span>
          <p>Welcome to the inner circle.</p>
          <small>Your 10% code is on its way to your inbox.</small>
        </div>
        
        <p class="muse-disclaimer">
          By joining, you agree to our
          <a href="{{ shop.privacy_policy.url | default: '#' }}">Privacy Policy</a>. Unsubscribe anytime.
        </p>
      </div>
    </div>

    <!-- Right: Navigation Columns -->
    <div class="foot-cols">
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          <div class="foot-col" {{ block.shopify_attributes }}>
            {%- if block.settings.title != blank -%}
              <h5>{{ block.settings.title }}</h5>
            {%- endif -%}
            {%- if block.settings.menu != blank -%}
              <ul>
                {%- for link in linklists[block.settings.menu].links -%}
                  <li><a href="{{ link.url }}">{{ link.title }}</a></li>
                {%- endfor -%}
              </ul>
            {%- endif -%}
          </div>
        {%- endfor -%}
      {%- else -%}
        <!-- Default 3 columns -->
        <div class="foot-col">
          <h5>Lisandra World</h5>
          <ul>
            <li><a href="#our-story">Our Story</a></li>
            <li><a href="#contact">Contact Us</a></li>
            <li><a href="#stockists">Stockists</a></li>
          </ul>
        </div>
        
        <div class="foot-col">
          <h5>Customer Care</h5>
          <ul>
            <li><a href="#faqs">FAQs</a></li>
            <li><a href="javascript:void(0)" onclick="openSizeModal()">Size Guide</a></li>
            <li><a href="#shipping">Shipping &amp; Duties</a></li>
            <li><a href="#returns">Returns</a></li>
          </ul>
        </div>
        
        <div class="foot-col">
          <h5>Follow Us</h5>
          <ul>
            <li><a href="https://instagram.com/lisandra.thelabel" target="_blank" rel="noopener">Instagram</a></li>
            <li><a href="https://tiktok.com/@lisandra.thelabel" target="_blank" rel="noopener">Tiktok</a></li>
            <li><a href="https://pinterest.com/lisandrathelabel" target="_blank" rel="noopener">Pinterest</a></li>
          </ul>
        </div>
      {%- endif -%}
    </div>
  </div>

  <!-- Footer Bottom -->
  <div class="foot-btm">
    <span>&copy; {{ 'now' | date: "%Y" }} {{ shop.name }} &middot; All Rights Reserved</span>
    <span>Made in Bali</span>
  </div>
</footer>

<!-- Sticky Newsletter Teaser -->
<div id="newsletterTeaser" class="newsletter-teaser">
  <span class="newsletter-teaser-text" onclick="openNewsletterModal()">{{ section.settings.teaser_text }}</span>
  <button class="newsletter-teaser-close" onclick="dismissNewsletterTeaser(event)" aria-label="Close teaser">✕</button>
</div>

<!-- Newsletter Modal -->
<dialog id="newsletterModal" aria-labelledby="newsletterModalTitle">
  <div class="newsletter-modal-inner">
    <button class="newsletter-modal-close" onclick="closeNewsletterModal()" aria-label="Close modal">✕</button>
    <div class="newsletter-image-wrap">
      {%- if section.settings.modal_image != blank -%}
        <img src="{{ section.settings.modal_image | img_url: '800x' }}" alt="Newsletter" loading="lazy" />
      {%- else -%}
        <img src="https://cdn.shopify.com/s/images/themes/product-1.png" alt="Newsletter" loading="lazy" />
      {%- endif -%}
    </div>
    
    <div class="newsletter-content-wrap">
      <div id="modalFormWrap">
        <span class="newsletter-subtitle-kicker">{{ section.settings.modal_kicker }}</span>
        <h2 id="newsletterModalTitle" class="newsletter-modal-title">{{ section.settings.modal_title }}</h2>
        <p class="newsletter-modal-desc">{{ section.settings.modal_desc }}</p>
        
        {% form 'customer', id: 'newsletterModalForm', class: 'newsletter-modal-form' %}
          <input type="hidden" name="contact[tags]" value="newsletter">
          
          {%- if form.posted_successfully? -%}
            <script>document.addEventListener("DOMContentLoaded", function() { showModalSuccess(); });</script>
          {%- else -%}
            <div class="newsletter-input-group">
              <input type="email" name="contact[email]" placeholder="Your email address" required />
            </div>
            <button type="submit" class="newsletter-submit-btn">{{ section.settings.modal_btn_label }}</button>
          {%- endif -%}
        {% endform %}
        
        <p class="newsletter-privacy-note">
          By joining, you agree to our <a href="{{ shop.privacy_policy.url | default: '#' }}" style="color:var(--cocoa); text-decoration:underline;">Privacy Policy</a>.
        </p>
      </div>
      
      <div class="newsletter-success-msg" id="newsletterSuccessMsg">
        <div class="success-icon">✦</div>
        <h4>Welcome to the circle.</h4>
        <p>Check your inbox for your exclusive 10% code.</p>
      </div>
    </div>
  </div>
</dialog>

<script>
  function showMuseSuccess() {
    document.getElementById("museFormWrap").style.display = "none";
    document.getElementById("museSuccess").style.display = "flex";
  }
  
  function showModalSuccess() {
    document.getElementById("modalFormWrap").style.display = "none";
    document.getElementById("newsletterSuccessMsg").style.display = "flex";
    openNewsletterModal();
  }

  // Teaser & Modal Logic
  const newsletterModal = document.getElementById("newsletterModal");
  const newsletterTeaser = document.getElementById("newsletterTeaser");

  function openNewsletterModal() {
    if (newsletterModal) {
      newsletterModal.showModal();
      document.body.style.overflow = "hidden";
      if (newsletterTeaser) newsletterTeaser.classList.add("hidden");
    }
  }

  function closeNewsletterModal() {
    if (newsletterModal) {
      newsletterModal.close();
      document.body.style.overflow = "";
      localStorage.setItem("lisandra_newsletter_dismissed", "true");
    }
  }

  function dismissNewsletterTeaser(event) {
    event.stopPropagation();
    if (newsletterTeaser) {
      newsletterTeaser.classList.add("hidden");
      localStorage.setItem("lisandra_newsletter_dismissed", "true");
    }
  }

  document.addEventListener("DOMContentLoaded", () => {
    // Check if dismissed
    if (localStorage.getItem("lisandra_newsletter_dismissed") === "true") {
      if (newsletterTeaser) newsletterTeaser.classList.add("hidden");
    } else {
      // Show teaser after 3 seconds
      setTimeout(() => {
        if (newsletterTeaser) newsletterTeaser.classList.remove("hidden");
      }, 3000);
    }
  });

  // Close modal when clicking backdrop
  if (newsletterModal) {
    newsletterModal.addEventListener("click", (e) => {
      const dialogDimensions = newsletterModal.getBoundingClientRect();
      if (
        e.clientX < dialogDimensions.left ||
        e.clientX > dialogDimensions.right ||
        e.clientY < dialogDimensions.top ||
        e.clientY > dialogDimensions.bottom
      ) {
        closeNewsletterModal();
      }
    });
  }
</script>

{% schema %}
{
  "name": "Footer & Newsletter",
  "settings": [
    {
      "type": "header",
      "content": "Footer Newsletter Zone"
    },
    {
      "type": "text",
      "id": "muse_kicker",
      "label": "Kicker",
      "default": "Become a Muse"
    },
    {
      "type": "textarea",
      "id": "muse_title",
      "label": "Title",
      "default": "Your first piece,<br />with 10% off."
    },
    {
      "type": "textarea",
      "id": "muse_desc",
      "label": "Description",
      "default": "Join our inner circle for private releases, secret drops, and 10% off your first artisanal piece."
    },
    {
      "type": "text",
      "id": "muse_btn_label",
      "label": "Button Label",
      "default": "Claim 10% Off"
    },
    {
      "type": "header",
      "content": "Footer Lower Zone"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Footer Logo (White)"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Footer Menu",
      "default": "footer"
    },
    {
      "type": "header",
      "content": "Sticky Teaser & Modal"
    },
    {
      "type": "text",
      "id": "teaser_text",
      "label": "Teaser Text",
      "default": "✦ 10% off your first piece"
    },
    {
      "type": "image_picker",
      "id": "modal_image",
      "label": "Modal Image"
