      "id": "modal_kicker",
      "label": "Modal Kicker",
      "default": "Exclusive Welcome"
    },
    {
      "type": "text",
      "id": "modal_title",
      "label": "Modal Title",
      "default": "Unlock 10% Off"
    },
    {
      "type": "textarea",
      "id": "modal_desc",
      "label": "Modal Description",
      "default": "Join the Lisandra inner circle to receive 10% off your first artisanal piece, plus early access to secret drops."
    },
    {
      "type": "text",
      "id": "modal_btn_label",
      "label": "Modal Button",
      "default": "Unlock Offer"
    }
  ],
  "presets": [
    {
      "name": "Footer & Newsletter"
    }
  ]
}
{% endschema %}
