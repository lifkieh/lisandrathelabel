<style>
  /* ==========================================================================
     LISANDRA MINIMALIST FOOTER (Concept 2 - Faithfull the Brand Luxury Style)
     ========================================================================== */
  
  .foot-section {
    background: var(--cocoa, #392319);
    color: #eee6d9;
    width: 100%;
    position: relative;
    border-top: 1px solid rgba(248, 248, 240, 0.12);
  }

  /* ---------- 2. Main Footer Grid ---------- */
  .foot-main-wrap {
    padding: clamp(56px, 7vw, 90px) clamp(20px, 4vw, 60px) clamp(40px, 5vw, 60px);
    display: flex;
    justify-content: center;
  }
  .foot-grid {
    max-width: 1340px;
    width: 100%;
    display: grid;
    grid-template-columns: 1.15fr 1.85fr;
    gap: clamp(48px, 6vw, 100px);
    align-items: start;
  }

  /* Left: Minimal Newsletter */
  .foot-news-col {
    display: flex;
    flex-direction: column;
    gap: 14px;
    max-width: 440px;
  }
  .foot-news-heading {
    font-family: var(--ui, "Inter", sans-serif);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #f8f8f0;
    margin: 0;
    line-height: 1.4;
  }
  .foot-news-desc {
    font-family: var(--body, "Inter", sans-serif);
    font-size: 12.5px;
    line-height: 1.6;
    color: rgba(248, 248, 240, 0.65);
    margin: 0;
  }
  
  /* Underline Form with Arrow Button */
  .foot-form-wrap {
    margin-top: 6px;
  }
  .foot-form-underline {
    display: flex;
    align-items: center;
    position: relative;
    width: 100%;
    border-bottom: 1px solid rgba(248, 248, 240, 0.35);
    transition: border-color 0.3s ease;
  }
  .foot-form-underline:focus-within {
    border-color: rgba(248, 248, 240, 0.95);
  }
  .foot-input-email {
    width: 100%;
    background: transparent !important;
    background-color: transparent !important;
    border: none !important;
    border-radius: 0 !important;
    padding: 14px 36px 14px 0;
    font-family: var(--body, "Inter", sans-serif);
    font-size: 12.5px;
    color: #f8f8f0 !important;
    letter-spacing: 0.04em;
    outline: none !important;
    box-shadow: none !important;
    -webkit-appearance: none;
    -moz-appearance: none;
    appearance: none;
    box-sizing: border-box;
  }
  .foot-input-email:focus,
  .foot-input-email:active {
    background: transparent !important;
    background-color: transparent !important;
    color: #f8f8f0 !important;
    outline: none !important;
    box-shadow: none !important;
  }
  .foot-input-email:-webkit-autofill,
  .foot-input-email:-webkit-autofill:hover, 
  .foot-input-email:-webkit-autofill:focus, 
  .foot-input-email:-webkit-autofill:active {
    -webkit-box-shadow: 0 0 0 1000px #392319 inset !important;
    -webkit-text-fill-color: #f8f8f0 !important;
    caret-color: #f8f8f0 !important;
    transition: background-color 5000s ease-in-out 0s;
    background-color: transparent !important;
    border-radius: 0 !important;
  }
  .foot-input-email::placeholder {
    color: rgba(248, 248, 240, 0.4);
    letter-spacing: 0.04em;
  }
  .foot-btn-arrow {
    position: absolute;
    right: 0;
    top: 50%;
    transform: translateY(-50%);
    background: transparent;
    border: none;
    color: #f8f8f0;
    cursor: pointer;
    padding: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.25s ease, color 0.25s ease;
  }
  .foot-btn-arrow svg {
    width: 16px;
    height: 16px;
    transition: transform 0.2s ease;
  }
  .foot-btn-arrow:hover svg {
    transform: translateX(4px);
    color: #e5a975;
  }
  .foot-privacy-note {
    font-family: var(--body, "Inter", sans-serif);
    font-size: 10px;
    color: rgba(248, 248, 240, 0.4);
    line-height: 1.45;
    margin: 8px 0 0 0;
  }
  .foot-privacy-note a {
    color: rgba(248, 248, 240, 0.6);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .foot-privacy-note a:hover {
    color: #f8f8f0;
  }

  /* Success Message */
  .foot-news-success {
    display: none;
    flex-direction: column;
    gap: 6px;
    padding: 12px 0 4px;
    animation: fadeInNews 0.5s ease forwards;
  }
  @keyframes fadeInNews {
    from { opacity: 0; transform: translateY(6px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .foot-news-success span {
    font-family: var(--display, "Bodoni Moda", serif);
    font-size: 18px;
    font-style: italic;
    color: #f8f8f0;
  }
  .foot-news-success small {
    font-family: var(--body, "Inter", sans-serif);
    font-size: 11.5px;
    color: rgba(248, 248, 240, 0.6);
  }

  /* Right: 3 Column Nav */
  .foot-nav-cols {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(32px, 4.5vw, 64px);
    width: 100%;
  }
  .foot-nav-col h4, .foot-nav-col h5 {
    font-family: var(--ui, "Inter", sans-serif);
    font-size: 10.5px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(248, 248, 240, 0.95);
    margin: 0 0 20px 0;
  }
  .foot-nav-col ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 13px;
  }
  .foot-nav-col ul li a {
    font-family: var(--body, "Inter", sans-serif);
    font-size: 12.5px;
    color: rgba(248, 248, 240, 0.65);
    text-decoration: none;
    line-height: 1.4;
    transition: color 0.25s ease;
  }
  .foot-nav-col ul li a:hover {
    color: #ffffff;
  }

  /* ---------- 3. Bottom Row: Copyright & Social Links ---------- */
  .foot-bottom-wrap {
    border-top: 1px solid rgba(248, 248, 240, 0.1);
    padding: 24px clamp(20px, 4vw, 60px);
    display: flex;
    justify-content: center;
  }
  .foot-bottom-inner {
    max-width: 1340px;
    width: 100%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 20px;
  }
  .foot-copy-zone {
    font-family: var(--ui, "Inter", sans-serif);
    font-size: 10px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(248, 248, 240, 0.45);
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .foot-social-links {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: clamp(16px, 2.5vw, 28px);
  }
  .foot-social-link {
    font-family: var(--ui, "Inter", sans-serif);
    font-size: 10.5px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(248, 248, 240, 0.65);
    text-decoration: none;
    transition: color 0.25s ease;
  }
  .foot-social-link:hover {
    color: #ffffff;
  }

  /* ---------- Breakpoints: Tablet & Mobile ---------- */
  @media (max-width: 990px) {
    .foot-grid {
      grid-template-columns: 1fr;
      gap: 56px;
    }
    .foot-news-col {
      max-width: 100%;
    }
  }

  @media (max-width: 640px) {
    .foot-main-wrap {
      padding: 44px 20px 36px;
    }
    .foot-nav-cols {
      grid-template-columns: repeat(2, 1fr);
      gap: 36px 24px;
    }
    .foot-nav-cols .foot-nav-col:last-child {
      grid-column: 1 / -1;
    }
    .foot-bottom-inner {
      flex-direction: column;
      align-items: center;
      text-align: center;
      gap: 16px;
    }
    .foot-social-links {
      justify-content: center;
    }
  }

  /* ---------- Sticky Newsletter Teaser (Bottom-Left) ---------- */
  .newsletter-teaser {
    position: fixed;
    bottom: 24px;
    left: 24px;
    background: var(--paper, #f8f8f0);
    padding: 12px 20px;
    display: flex;
    align-items: center;
    gap: 12px;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.08);
    cursor: pointer;
    z-index: 40;
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.4s ease, box-shadow 0.3s ease;
  }
  @media (max-width: 768px) {
    .newsletter-teaser {
      bottom: 16px;
      left: 16px;
      right: 16px;
      justify-content: space-between;
    }
  }
  .newsletter-teaser:hover { box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12); }
  .newsletter-teaser.hidden {
    transform: translateY(150%);
    opacity: 0;
    pointer-events: none;
  }
  .newsletter-teaser-text {
    font-family: var(--body, sans-serif);
    font-size: 10.5px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--cocoa, #392319);
  }
  .newsletter-teaser-close {
    background: none;
    border: none;
    font-size: 16px;
    cursor: pointer;
    color: var(--ink60, #666);
    padding: 4px;
    line-height: 1;
  }
  .newsletter-teaser-close:hover { color: var(--ink, #000); }

  /* ---------- Newsletter Modal (2-Column Luxury) ---------- */
  #newsletterModal {
    border: none;
    background: transparent;
    padding: 0;
    margin: auto;
  }
  #newsletterModal::backdrop {
    background: rgba(30, 18, 10, 0.4);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
  }
  .newsletter-modal-inner {
    background: var(--paper, #f8f8f0);
    width: 95vw;
    max-width: 800px;
    position: relative;
    display: flex;
    flex-direction: column;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.25);
  }
  @media (min-width: 768px) {
    .newsletter-modal-inner { flex-direction: row; }
  }
  .newsletter-image-wrap {
    width: 100%;
    background: var(--sand, #e0d9b5);
    display: none;
  }
  @media (min-width: 768px) {
    .newsletter-image-wrap { width: 50%; display: block; }
  }
  .newsletter-image-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .newsletter-content-wrap {
    padding: clamp(32px, 5vw, 64px) clamp(24px, 4vw, 48px);
    display: flex;
    flex-direction: column;
    justify-content: center;
    width: 100%;
    box-sizing: border-box;
  }
  @media (min-width: 768px) {
    .newsletter-content-wrap { width: 50%; }
  }
  .newsletter-modal-close {
    position: absolute;
    top: 16px;
    right: 16px;
    font-size: 24px;
    line-height: 1;
    z-index: 10;
    background: transparent;
    border: none;
    cursor: pointer;
    color: var(--ink, #000);
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: opacity 0.25s ease;
  }
  @media (max-width: 767px) {
    .newsletter-modal-close {
      background: var(--paper, #f8f8f0);
      border-radius: 50%;
      box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    }
  }
  .newsletter-modal-close:hover { opacity: 0.6; }
  
  .newsletter-subtitle-kicker {
    font-family: var(--body, sans-serif);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--clay, #8a5a44);
    margin-bottom: 12px;
    display: block;
  }
  .newsletter-modal-title {
    font-family: var(--display, serif);
    font-size: clamp(24px, 3vw, 32px);
    font-style: italic;
    font-weight: 400;
    color: var(--cocoa, #392319);
    margin: 0 0 12px 0;
    line-height: 1.15;
  }
  .newsletter-modal-desc {
    font-family: var(--body, sans-serif);
    font-size: 12.5px;
    color: var(--ink60, #666);
    line-height: 1.5;
    margin: 0 0 24px 0;
  }
  .newsletter-modal-form {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .newsletter-input-group {
    display: flex;
    flex-direction: column;
  }
  .newsletter-modal-form input[type="email"] {
    width: 100%;
    padding: 14px 16px;
    border: 1px solid var(--line, #e2e2e2);
    background: transparent;
    font-family: var(--body, sans-serif);
    font-size: 12px;
    letter-spacing: 0.04em;
    color: var(--ink, #000);
    outline: none;
    transition: border-color 0.25s ease;
    box-sizing: border-box;
  }
  .newsletter-modal-form input[type="email"]::placeholder {
    color: var(--ink60, #666);
    letter-spacing: 0.05em;
  }
  .newsletter-modal-form input[type="email"]:focus {
    border-color: var(--cocoa, #392319);
  }
  .newsletter-submit-btn {
    width: 100%;
    padding: 14px 24px;
    background: var(--cocoa, #392319);
    color: #fff;
    font-family: var(--body, sans-serif);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    border: 1px solid var(--cocoa, #392319);
    cursor: pointer;
    transition: background 0.25s ease, color 0.25s ease;
  }
  .newsletter-submit-btn:hover {
    background: #fff;
    color: var(--cocoa, #392319);
  }
  .newsletter-privacy-note {
    font-family: var(--body, sans-serif);
    font-size: 10px;
    color: var(--ink60, #666);
    margin-top: 12px;
  }
  .newsletter-success-msg {
    display: none;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    height: 100%;
    animation: fadeInMsg 0.6s ease forwards;
  }
  @keyframes fadeInMsg { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
  .newsletter-success-msg .success-icon {
    font-size: 32px;
    color: var(--clay, #8a5a44);
    margin-bottom: 16px;
  }
  .newsletter-success-msg h4 {
    font-family: var(--display, serif);
    font-size: 24px;
    font-style: italic;
    color: var(--cocoa, #392319);
    margin: 0 0 12px 0;
  }
  .newsletter-success-msg p {
    font-family: var(--body, sans-serif);
    font-size: 13px;
    color: var(--ink60, #666);
    margin: 0;
  }
</style>

<footer class="foot-section">
  <!-- 2. Main Footer Grid -->
  <div class="foot-main-wrap">
    <div class="foot-grid">
      <!-- Left: Minimalist Newsletter -->
      <div class="foot-news-col">
        <h3 class="foot-news-heading">{{ section.settings.muse_kicker | default: 'Sign Up to Get 10% Off Your First Order' }}</h3>
        <p class="foot-news-desc">{{ section.settings.muse_desc | default: 'Join our inner circle for private releases, secret artisan drops, and invitations.' }}</p>
        
        <div class="foot-form-wrap">
          <div id="museFormWrap">
            {% form 'customer', id: 'museForm', class: 'foot-form-underline' %}
              <input type="hidden" name="contact[tags]" value="newsletter">
              
              {%- if form.posted_successfully? -%}
                <script>document.addEventListener("DOMContentLoaded", function() { showMuseSuccess(); });</script>
              {%- else -%}
                <input 
                  type="email" 
                  name="contact[email]" 
                  class="foot-input-email" 
                  id="museEmail" 
                  placeholder="Enter your email address" 
                  required 
                  autocomplete="email"
                  autocapitalize="off"
                  autocorrect="off"
                  spellcheck="false"
                  aria-label="Email address"
                />
                <button type="submit" class="foot-btn-arrow" aria-label="Submit newsletter">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                    <polyline points="12 5 19 12 12 19"></polyline>
                  </svg>
                </button>
              {%- endif -%}
            {% endform %}
          </div>
          
          <div class="foot-news-success" id="museSuccess" {% if form.posted_successfully? %}style="display:flex; opacity:1;"{% endif %}>
            <span>✦ Welcome to the inner circle.</span>
            <small>Your 10% code is on its way to your inbox.</small>
          </div>
          
          <p class="foot-privacy-note">
            By joining, you agree to our
            <a href="{{ shop.privacy_policy.url | default: '/policies/privacy-policy' }}">Privacy Policy</a>. Unsubscribe anytime.
          </p>
        </div>
      </div>

      <!-- Right: Navigation Columns -->
      <div class="foot-nav-cols">
        {%- if section.blocks.size > 0 -%}
          {%- for block in section.blocks -%}
            <div class="foot-nav-col" {{ block.shopify_attributes }}>
              {%- if block.settings.title != blank -%}
                <h5>{{ block.settings.title }}</h5>
              {%- endif -%}
              {%- if block.settings.menu != blank -%}
                <ul>
                  {%- for link in linklists[block.settings.menu].links -%}
                    <li><a href="{{ link.url }}">{{ link.title }}</a></li>
                  {%- endfor -%}
                </ul>
              {%- endif -%}
            </div>
          {%- endfor -%}
        {%- else -%}
          <!-- Default 3 Clean Columns matching Reference Image -->
          <div class="foot-nav-col">
            <h5>Lisandra World</h5>
            <ul>
              <li><a href="/pages/our-story">Our Story</a></li>
              <li><a href="/pages/contact">Contact Us</a></li>
              <li><a href="/pages/faqs">Stockists</a></li>
            </ul>
          </div>
          
          <div class="foot-nav-col">
            <h5>Customer Care</h5>
            <ul>
              <li><a href="/pages/faqs">FAQs</a></li>
              <li><a href="/pages/size-guide">Size Guide</a></li>
              <li><a href="{{ shop.shipping_policy.url | default: '/pages/faqs' }}">Shipping &amp; Duties</a></li>
              <li><a href="{{ shop.refund_policy.url | default: '/pages/faqs' }}">Returns</a></li>
            </ul>
          </div>
          
          <div class="foot-nav-col">
            <h5>Follow Us</h5>
            <ul>
              <li><a href="https://instagram.com/lisandra.thelabel" target="_blank" rel="noopener">Instagram</a></li>
              <li><a href="https://tiktok.com/@lisandra.thelabel" target="_blank" rel="noopener">Tiktok</a></li>
              <li><a href="https://pinterest.com/lisandrathelabel" target="_blank" rel="noopener">Pinterest</a></li>
            </ul>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>

  <!-- 3. Bottom Row: Copyright & Horizontal Social Links -->
  <div class="foot-bottom-wrap">
    <div class="foot-bottom-inner">
      <div class="foot-copy-zone">
        <span>&copy; {{ 'now' | date: "%Y" }} {{ shop.name }} &middot; All Rights Reserved</span>
        <span>&middot;</span>
        <span>Made in Bali</span>
      </div>

      <div class="foot-social-links">
        <a href="https://instagram.com/lisandra.thelabel" target="_blank" rel="noopener" class="foot-social-link">Instagram</a>
        <a href="https://tiktok.com/@lisandra.thelabel" target="_blank" rel="noopener" class="foot-social-link">TikTok</a>
        <a href="https://pinterest.com/lisandrathelabel" target="_blank" rel="noopener" class="foot-social-link">Pinterest</a>
        <a href="mailto:care@lisandrathelabel.com" class="foot-social-link">Email Us</a>
      </div>
    </div>
  </div>
</footer>

{%- if section.settings.enable_teaser -%}
<!-- Sticky Newsletter Teaser -->
<div id="newsletterTeaser" class="newsletter-teaser">
  <span class="newsletter-teaser-text" onclick="openNewsletterModal()">{{ section.settings.teaser_text }}</span>
  <button class="newsletter-teaser-close" onclick="dismissNewsletterTeaser(event)" aria-label="Close teaser">✕</button>
</div>

<!-- Newsletter Modal -->
<dialog id="newsletterModal" aria-labelledby="newsletterModalTitle">
  <div class="newsletter-modal-inner">
    <button class="newsletter-modal-close" onclick="closeNewsletterModal()" aria-label="Close modal">✕</button>
    <div class="newsletter-image-wrap">
      {%- if section.settings.modal_image != blank -%}
        <img src="{{ section.settings.modal_image | img_url: '800x' }}" alt="Newsletter" loading="lazy" />
      {%- else -%}
        <img src="https://cdn.shopify.com/s/images/themes/product-1.png" alt="Newsletter" loading="lazy" />
      {%- endif -%}
    </div>
    
    <div class="newsletter-content-wrap">
      <div id="modalFormWrap">
        <span class="newsletter-subtitle-kicker">{{ section.settings.modal_kicker }}</span>
        <h2 id="newsletterModalTitle" class="newsletter-modal-title">{{ section.settings.modal_title }}</h2>
        <p class="newsletter-modal-desc">{{ section.settings.modal_desc }}</p>
        
        {% form 'customer', id: 'newsletterModalForm', class: 'newsletter-modal-form' %}
          <input type="hidden" name="contact[tags]" value="newsletter">
          
          {%- if form.posted_successfully? -%}
            <script>document.addEventListener("DOMContentLoaded", function() { showModalSuccess(); });</script>
          {%- else -%}
            <div class="newsletter-input-group">
              <input type="email" name="contact[email]" placeholder="Your email address" required />
            </div>
            <button type="submit" class="newsletter-submit-btn">{{ section.settings.modal_btn_label }}</button>
          {%- endif -%}
        {% endform %}
        
        <p class="newsletter-privacy-note">
          By joining, you agree to our <a href="{{ shop.privacy_policy.url | default: '/policies/privacy-policy' }}" style="color:var(--cocoa); text-decoration:underline;">Privacy Policy</a>.
        </p>
      </div>
      
      <div class="newsletter-success-msg" id="newsletterSuccessMsg">
        <div class="success-icon">✦</div>
        <h4>Welcome to the circle.</h4>
        <p>Check your inbox for your exclusive 10% code.</p>
      </div>
    </div>
  </div>
</dialog>

<script>
  function showModalSuccess() {
    var modalWrap = document.getElementById("modalFormWrap");
    var modalSuccess = document.getElementById("newsletterSuccessMsg");
    if (modalWrap) modalWrap.style.display = "none";
    if (modalSuccess) modalSuccess.style.display = "flex";
    openNewsletterModal();
  }

  // Teaser & Modal Logic
  var newsletterModal = document.getElementById("newsletterModal");
  var newsletterTeaser = document.getElementById("newsletterTeaser");

  function openNewsletterModal() {
    if (newsletterModal) {
      newsletterModal.showModal();
      document.body.style.overflow = "hidden";
      if (newsletterTeaser) newsletterTeaser.classList.add("hidden");
    }
  }

  function closeNewsletterModal() {
    if (newsletterModal) {
      newsletterModal.close();
      document.body.style.overflow = "";
      localStorage.setItem("lisandra_newsletter_dismissed", "true");
    }
  }

  function dismissNewsletterTeaser(event) {
    event.stopPropagation();
    if (newsletterTeaser) {
      newsletterTeaser.classList.add("hidden");
      localStorage.setItem("lisandra_newsletter_dismissed", "true");
    }
  }

  document.addEventListener("DOMContentLoaded", function() {
    if (localStorage.getItem("lisandra_newsletter_dismissed") === "true") {
      if (newsletterTeaser) newsletterTeaser.classList.add("hidden");
    } else {
      setTimeout(function() {
        if (newsletterTeaser) newsletterTeaser.classList.remove("hidden");
      }, 3000);
    }
  });

  if (newsletterModal) {
    newsletterModal.addEventListener("click", function(e) {
      var dialogDimensions = newsletterModal.getBoundingClientRect();
      if (
        e.clientX < dialogDimensions.left ||
        e.clientX > dialogDimensions.right ||
        e.clientY < dialogDimensions.top ||
        e.clientY > dialogDimensions.bottom
      ) {
        closeNewsletterModal();
      }
    });
  }
</script>
{%- endif -%}

<script>
  function showMuseSuccess() {
    var formWrap = document.getElementById("museFormWrap");
    var successMsg = document.getElementById("museSuccess");
    if (formWrap) formWrap.style.display = "none";
    if (successMsg) successMsg.style.display = "flex";
  }
</script>

